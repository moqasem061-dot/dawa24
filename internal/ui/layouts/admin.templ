package layouts

import (
	"github.com/moqasem061-dot/dawa24/internal/platform/rbac"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
)

templ AdminShell(title string, activeNav string, lang string, dir string) {
	if site := GetSiteSettings(ctx); site != nil {
		@Base(title, lang, dir, "/static/css/customer.css", "/static/css/admin.css") {
			<div class="app-shell" hx-boost="true">
				<!-- Sidebar -->
				<aside class="sidebar" id="app-sidebar">
					<div class="sidebar-header">
						<a href="/admin/dashboard" class="sidebar-brand text-decoration-none">
							if site.LogoURL != "" {
								<img class={ "sidebar-logo logo-light", templ.KV("logo-always", site.LogoDarkURL == "") } src={ BrandLogoURL(site.LogoURL) } srcset={ BrandLogoSrcset(site.LogoURL) } sizes="(max-width: 640px) 135px, 240px" width="480" height="164" alt={ site.SiteName } data-img-fallback="hide" />
							} else {
								<img class={ "sidebar-logo logo-light", templ.KV("logo-always", site.LogoDarkURL == "") } src={ BrandLogoURL("") } srcset={ BrandLogoSrcset("") } sizes="(max-width: 640px) 135px, 240px" width="480" height="164" alt={ site.SiteName } data-img-fallback="hide" />
							}
							if site.LogoDarkURL != "" {
								<img class="sidebar-logo logo-dark" src={ Asset(site.LogoDarkURL) } width="480" height="164" alt={ site.SiteName } data-img-fallback="hide" />
							}
							<div class="sidebar-brand-copy">
								<span class="sidebar-brand-name">{ site.SiteName }</span>
								<span class="sidebar-brand-subtitle">{ i18n.T(lang, "admin.shell.subtitle") }</span>
							</div>
						</a>
						@SidebarHeaderControls()
					</div>

					@SidebarNav(rbac.ScopeAdmin, activeNav, lang)
				</aside>

				<!-- Main Admin Content Area -->
				<main class="main-content" id="main-content" data-shell="admin">
					@components.DashboardTopBar(components.TopBarProps{
						Title:   title,
						Lang:    lang,
						Compact: true,
					})

					<!-- Page Container -->
					<div class="page-container">
						@AuthNoticeBanner(lang)
						{ children... }
					</div>
				</main>
			</div>
		}
	}
}
