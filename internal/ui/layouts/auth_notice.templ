package layouts

import (
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

// AuthNoticeBanner renders a prominent modal dialog if an unauthorized access attempt
// redirected the user to their dashboard due to lack of permissions.
templ AuthNoticeBanner(langOpt ...string) {
	{{
		lang := "ar"
		if len(langOpt) > 0 && langOpt[0] != "" {
			lang = langOpt[0]
		}
	}}
	if notice := GetAuthNotice(ctx); notice != "" {
		<div
			x-data="{ showModal: true }"
			x-show="showModal"
			x-cloak
			class="modal-backdrop"
			x-transition.opacity
			@keydown.escape.window="showModal = false"
			role="dialog"
			aria-modal="true"
		>
			<div
				class="modal-dialog modal-md bg-surface p-0 rounded-2xl shadow-2xl border border-slate-200 overflow-hidden"
				@click.outside="showModal = false"
				x-init="if (window.history.replaceState && new URLSearchParams(window.location.search).has('auth_notice')) { const u = new URL(window.location); u.searchParams.delete('auth_notice'); window.history.replaceState({}, '', u.pathname + (u.search ? u.search : '') + u.hash); }"
			>
				<!-- Modal Header -->
				<div class="modal-header flex-between items-center p-4 border-b border-slate-100 bg-slate-50/50">
					<div class="d-flex items-center gap-2.5">
						<div class="w-8 h-8 rounded-full bg-amber-100 text-amber-600 d-flex items-center justify-center font-bold">
							@components.IconLock("icon-sm")
						</div>
						<h3 class="modal-title text-base font-black text-primary m-0">
							{ i18n.T(lang, "auth.notice.title") }
						</h3>
					</div>
					<button
						type="button"
						@click="showModal = false"
						class="btn btn-icon btn-ghost btn-sm text-secondary hover:text-primary rounded-xl"
						aria-label={ i18n.T(lang, "common.close") }
					>
						@components.IconClose("icon-sm")
					</button>
				</div>

				<!-- Modal Body -->
				<div class="modal-body p-6 text-center">
					<div class="w-16 h-16 rounded-full bg-amber-50 text-amber-500 border border-amber-200/60 d-flex items-center justify-center mx-auto mb-4 shadow-xs">
						@components.IconLock("icon-lg")
					</div>
					<h4 class="text-lg font-black text-primary mb-2">
						{ i18n.T(lang, "auth.notice.forbidden_heading") }
					</h4>
					<p class="text-sm text-secondary leading-relaxed max-w-md mx-auto mb-0">
						{ i18n.T(lang, "auth.notice.forbidden_body") }
					</p>
				</div>

				<!-- Modal Footer -->
				<div class="modal-footer p-4 bg-slate-50/50 border-t border-slate-100 d-flex justify-end gap-2">
					<button
						type="button"
						@click="showModal = false"
						class="btn btn-primary btn-sm px-6 font-bold"
					>
						{ i18n.T(lang, "auth.notice.understood") }
					</button>
				</div>
			</div>
		</div>
	}
}
