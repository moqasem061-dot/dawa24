package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/moqasem061-dot/dawa24/internal/modules/compare"
	"github.com/moqasem061-dot/dawa24/internal/platform/authctx"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/shared/money"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

// MarketDiscountsPage renders the temporary-warehouse price board.
//
// The page is a shell and a results region. The shell (header, controls) is
// rendered once; every later filter, sort, page or page-size change replaces
// only the contents of #md-results, which is MarketDiscountsResults — the same
// component the server returns on its own for a request that targets the
// region. The behaviour lives in /static/js/market-discounts.js, which owns the
// form: typing shows suggestions and never touches the board.
//
// Each offer is one <article> whatever the layout. List and grid are two CSS
// layouts of the same markup, switched by a class on .md-offers, so changing
// the layout costs no request and the browser lays out one set of cards, not
// two.
//
// The card carries three decisions, each of which replaced something that was
// actively misleading:
//
//   - No product code. The uploads carry whatever the sheet's code column held,
//     and on files mapped before the header detection was corrected that is a
//     price or a discount. A number presented as an identifier is worse than no
//     identifier.
//   - سعر الجمهور leads, and is not struck through. It is the figure this board
//     exists to compare.
//   - There is no separate net-price column of its own weight: the discount
//     pill beside the public price already says what to subtract.
templ MarketDiscountsPage(lang, dir string, actor authctx.Actor, result *compare.MarketDiscountsResult, filter compare.MarketDiscountsFilter, currentView string) {
	@layouts.ShellFor(i18n.T(lang, "market.board.page_title"), "market-discounts", lang, dir, actor) {
		<div
			class="page-container"
			id="md-page"
			data-md-root
			data-view={ currentView }
			data-msg-failed={ i18n.T(lang, "market.board.loading_failed") }
			data-msg-loading={ i18n.T(lang, "market.suggest.loading") }
			data-msg-suggest-error={ i18n.T(lang, "market.suggest.error") }
		>
			<header class="md-header">
				<div class="md-header-copy">
					<h1 class="md-title">
						@components.IconTag("icon-sm")
						<span>{ i18n.T(lang, "market.board.title") }</span>
					</h1>
					<p class="md-subtitle">{ i18n.T(lang, "market.board.subtitle") }</p>
				</div>
			</header>
			@marketControls(lang, result, filter, currentView)
			<section id="md-results" class="md-results" aria-live="polite" aria-busy="false">
				@MarketDiscountsResults(lang, result, filter, currentView)
			</section>
		</div>
		<script defer nonce={ templ.GetNonce(ctx) } src={ layouts.Asset("/static/js/market-discounts.js") }></script>
	}
}

// marketControls is the form the page script owns. Without the script it still
// works as a plain GET form.
templ marketControls(lang string, result *compare.MarketDiscountsResult, filter compare.MarketDiscountsFilter, currentView string) {
	{{ advancedOpen := marketAdvancedActive(filter) }}
	<div class="filter-bar md-controls">
		<form method="GET" action="/market-discounts" class="md-controls-form" id="market-filter-form" data-no-filter data-no-boost role="search">
			<input type="hidden" name="view" value={ currentView }/>
			<input type="hidden" name="limit" value={ strconv.Itoa(marketDiscountsLimit(filter)) }/>
			if filter.ProductID != nil {
				<input type="hidden" name="product" value={ strconv.FormatInt(*filter.ProductID, 10) }/>
			}
			<div class="md-controls-row">
				<div class="md-search-wrap" data-md-combobox>
					<input
						type="search"
						name="q"
						id="market-search-input"
						value={ filter.Query }
						class="form-input md-search"
						placeholder={ i18n.T(lang, "market.search.placeholder") }
						aria-label={ i18n.T(lang, "market.board.search_label") }
						role="combobox"
						aria-autocomplete="list"
						aria-haspopup="listbox"
						aria-expanded="false"
						aria-controls="md-suggest-list"
						data-min-chars="2"
						maxlength="128"
						autocomplete="off"
						autocapitalize="off"
						spellcheck="false"
					/>
					<div class="md-suggest" id="md-suggest" hidden>
						<div class="md-suggest-list" id="md-suggest-list" role="listbox" aria-label={ i18n.T(lang, "market.suggest.label") }></div>
						<div class="md-suggest-state" id="md-suggest-state" role="status" hidden></div>
					</div>
				</div>
				<input type="search" name="supplier" value={ filter.Supplier } list="market-warehouse-options" class="form-input md-select" placeholder={ i18n.T(lang, "market.search.warehouse") } aria-label={ i18n.T(lang, "market.search.warehouse") } autocomplete="off"/>
				<datalist id="market-warehouse-options">
					for _, sup := range result.AvailableSuppliers {
						<option value={ sup }></option>
					}
				</datalist>
				<select name="sort" class="form-select md-select" aria-label={ i18n.T(lang, "market.board.sort_label") }>
					<option value="relevance" selected?={ filter.SortBy == "relevance" }>{ i18n.T(lang, "market.search.relevance") }</option>
					<option value="discount_desc" selected?={ filter.SortBy == "discount_desc" }>{ i18n.T(lang, "market.board.sort.discount_desc") }</option>
					<option value="discount_asc" selected?={ filter.SortBy == "discount_asc" }>{ i18n.T(lang, "market.board.sort.discount_asc") }</option>
					<option value="price_asc" selected?={ filter.SortBy == "price_asc" }>{ i18n.T(lang, "market.board.sort.price_asc") }</option>
					<option value="price_desc" selected?={ filter.SortBy == "price_desc" }>{ i18n.T(lang, "market.board.sort.price_desc") }</option>
					<option value="newest" selected?={ filter.SortBy == "" || filter.SortBy == "newest" }>{ i18n.T(lang, "market.board.sort.newest") }</option>
					<option value="oldest" selected?={ filter.SortBy == "oldest" }>{ i18n.T(lang, "market.board.sort.oldest") }</option>
				</select>
				<button
					type="button"
					class={ "btn btn-secondary btn-sm font-bold md-advanced-toggle", templ.KV("active", advancedOpen) }
					data-md-advanced-toggle
					aria-expanded={ mdBool(advancedOpen) }
					aria-controls="md-advanced"
				>
					@components.IconSliders("icon-xs")
					<span>{ i18n.T(lang, "market.board.advanced") }</span>
				</button>
				<div class="md-controls-spacer"></div>
				<div class="tabs-nav md-viewswitch" role="group" aria-label={ i18n.T(lang, "market.board.view_label") }>
					<button
						type="button"
						class={ "tab-btn", templ.KV("active", currentView != "grid") }
						data-md-view="list"
						aria-pressed={ mdBool(currentView != "grid") }
						title={ i18n.T(lang, "market.board.view_list") }
						aria-label={ i18n.T(lang, "market.board.view_list") }
					>
						@components.IconList("icon-xs")
					</button>
					<button
						type="button"
						class={ "tab-btn", templ.KV("active", currentView == "grid") }
						data-md-view="grid"
						aria-pressed={ mdBool(currentView == "grid") }
						title={ i18n.T(lang, "market.board.view_grid") }
						aria-label={ i18n.T(lang, "market.board.view_grid") }
					>
						@components.IconGrid("icon-xs")
					</button>
				</div>
			</div>
			<div class="md-ranges" id="md-advanced" hidden?={ !advancedOpen }>
				<div class="md-range">
					<span class="md-range-label">{ i18n.T(lang, "feedback.date_from") } / { i18n.T(lang, "feedback.date_to") }</span>
					<div class="md-range-pair">
						<input type="date" name="date_from" value={ filter.DateFrom } class="form-input" aria-label={ i18n.T(lang, "feedback.date_from") }/>
						<span class="md-range-dash">—</span>
						<input type="date" name="date_to" value={ filter.DateTo } class="form-input" aria-label={ i18n.T(lang, "feedback.date_to") }/>
					</div>
				</div>
				<div class="md-range">
					<span class="md-range-label">{ i18n.T(lang, "market.board.price_range") }</span>
					<div class="md-range-pair">
						<input type="number" min="0" step="0.5" inputmode="decimal" name="min_price" value={ formatOptionalMoney(filter.MinPrice) } class="form-input" placeholder={ i18n.T(lang, "market.board.from") } aria-label={ i18n.T(lang, "market.board.min_price") }/>
						<span class="md-range-dash">—</span>
						<input type="number" min="0" step="0.5" inputmode="decimal" name="max_price" value={ formatOptionalMoney(filter.MaxPrice) } class="form-input" placeholder={ i18n.T(lang, "market.board.to") } aria-label={ i18n.T(lang, "market.board.max_price") }/>
					</div>
				</div>
				<div class="md-range">
					<span class="md-range-label">{ i18n.T(lang, "market.board.discount_range") }</span>
					<div class="md-range-pair">
						<input type="number" min="0" max="100" step="1" inputmode="decimal" name="min_discount" value={ formatOptionalFloat(filter.MinDiscount) } class="form-input" placeholder={ i18n.T(lang, "market.board.from") } aria-label={ i18n.T(lang, "market.board.min_discount") }/>
						<span class="md-range-dash">—</span>
						<input type="number" min="0" max="100" step="1" inputmode="decimal" name="max_discount" value={ formatOptionalFloat(filter.MaxDiscount) } class="form-input" placeholder={ i18n.T(lang, "market.board.to") } aria-label={ i18n.T(lang, "market.board.max_discount") }/>
					</div>
				</div>
				<button type="submit" class="btn btn-primary btn-sm font-bold md-range-apply">
					@components.IconSearch("icon-xs")
					<span>{ i18n.T(lang, "market.board.apply") }</span>
				</button>
			</div>
		</form>
	</div>
}

// marketDiscountsLimit is the page size in effect: the filter's value, or the
// grid default of 24.
func marketDiscountsLimit(f compare.MarketDiscountsFilter) int {
	if f.Limit == 24 || f.Limit == 48 || f.Limit == 96 {
		return f.Limit
	}
	return 24
}

// marketAdvancedActive reports whether any filter that lives in the collapsible
// panel is set, so the panel opens on a page that arrived with one.
func marketAdvancedActive(f compare.MarketDiscountsFilter) bool {
	return f.DateFrom != "" || f.DateTo != "" || f.MinPrice != nil || f.MaxPrice != nil || f.MinDiscount != nil || f.MaxDiscount != nil
}

func mdBool(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// marketDiscountsQueryValues carries every filter the screen supports through a
// page change. components.B2BPagination adds page and limit itself.
func marketDiscountsQueryValues(f compare.MarketDiscountsFilter, view string) url.Values {
	q := url.Values{}
	if f.DateFrom != "" {
		q.Set("date_from", f.DateFrom)
	}
	if f.DateTo != "" {
		q.Set("date_to", f.DateTo)
	}
	if f.Query != "" {
		q.Set("q", f.Query)
	}
	if f.Supplier != "" {
		q.Set("supplier", f.Supplier)
	}
	if f.ProductID != nil {
		q.Set("product", strconv.FormatInt(*f.ProductID, 10))
	}
	if f.SortBy != "" {
		q.Set("sort", f.SortBy)
	}
	if f.MinPrice != nil {
		q.Set("min_price", f.MinPrice.String())
	}
	if f.MaxPrice != nil {
		q.Set("max_price", f.MaxPrice.String())
	}
	if f.MinDiscount != nil {
		q.Set("min_discount", strconv.FormatFloat(*f.MinDiscount, 'f', -1, 64))
	}
	if f.MaxDiscount != nil {
		q.Set("max_discount", strconv.FormatFloat(*f.MaxDiscount, 'f', -1, 64))
	}
	if view != "" {
		q.Set("view", view)
	}
	return q
}

// marketPageURL is one page of the board with every filter kept.
//
// It exists for the footer the board falls back to when the exact total could
// not be read: components.B2BPagination needs a total to draw page numbers, and
// without one the reader would have no way forward from a page that has rows on
// it.
func marketPageURL(f compare.MarketDiscountsFilter, view string, page int) string {
	q := marketDiscountsQueryValues(f, view)
	q.Set("limit", strconv.Itoa(marketDiscountsLimit(f)))
	q.Set("page", strconv.Itoa(page))
	return "/market-discounts?" + q.Encode()
}

// marketWithout is the board's URL with the named filter parameters dropped and
// the page reset: what removing a filter chip links to.
func marketWithout(f compare.MarketDiscountsFilter, view string, drop ...string) string {
	q := marketDiscountsQueryValues(f, view)
	for _, key := range drop {
		q.Del(key)
	}
	q.Set("limit", strconv.Itoa(marketDiscountsLimit(f)))
	return "/market-discounts?" + q.Encode()
}

func formatOptionalFloat(val *float64) string {
	if val == nil {
		return ""
	}
	return strconv.FormatFloat(*val, 'f', -1, 64)
}

func formatDiscount(pct float64) string {
	if pct <= 0 {
		return "0"
	}
	if pct == float64(int64(pct)) {
		return fmt.Sprintf("%d", int64(pct))
	}
	s := fmt.Sprintf("%.2f", pct)
	s = strings.TrimRight(s, "0")
	s = strings.TrimRight(s, ".")
	return s
}

func formatDiscountPrice(m money.Amount) string {
	return m.String()
}

func marketProductName(item *compare.MarketDiscountRow, lang string) string {
	if lang == "en" && item.CatalogNameEN != "" {
		return item.CatalogNameEN
	}
	if item.CatalogNameAR != "" {
		return item.CatalogNameAR
	}
	if item.CatalogNameEN != "" {
		return item.CatalogNameEN
	}
	return item.ProductName
}

func formatOptionalMoney(value *money.Amount) string {
	if value == nil {
		return ""
	}
	return value.String()
}
