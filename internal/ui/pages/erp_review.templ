package pages

import (
	"fmt"
	"strings"

	"github.com/moqasem061-dot/dawa24/internal/modules/erp"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

// ErpReviewData is what the integration review screen renders: the
// organization's open review items, oldest-first.
type ErpReviewData struct {
	Items         []erp.ReviewItem
	Audience      string
	NoticeKind    string
	NoticeMessage string
}

// ErpReviewPage lists the open review items for the supplier to resolve or
// dismiss.
templ ErpReviewPage(data ErpReviewData, lang, dir string) {
	@layouts.VendorShell(i18n.T(lang, "erp.review.title"), "integrations", lang, dir) {
		<div class="page-container">
			<div class="glass-panel p-6 mb-6">
				<div class="d-flex items-center gap-3 mb-0">
					<div class="user-avatar-badge text-xl text-brand">
						@components.IconShield("icon-sm")
					</div>
					<h1 class="text-2xl font-black text-primary m-0">
						{ i18n.T(lang, "erp.review.title") }
					</h1>
				</div>
			</div>

			if data.NoticeMessage != "" {
				if data.NoticeKind == "error" {
					<div class="alert alert-danger mb-4 p-4 d-flex items-center gap-3">
						@components.IconAlertCircle("icon-xs")
						<span class="font-bold text-sm">{ data.NoticeMessage }</span>
					</div>
				} else {
					<div class="alert alert-success mb-4 p-4 d-flex items-center gap-3">
						@components.IconCheckCircle("icon-xs")
						<span class="font-bold text-sm">{ data.NoticeMessage }</span>
					</div>
				}
			}

			if len(data.Items) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title:   i18n.T(lang, "erp.review.title"),
					Message: i18n.T(lang, "erp.review.empty"),
				})
			} else {
				<div class="d-flex flex-col gap-3">
					for _, row := range data.Items {
						<div class="glass-panel p-4">
							<div class="d-flex items-center justify-between flex-wrap gap-3">
								<div>
									<div class="font-bold text-primary">{ row.ExternalCode }</div>
									<div class="text-xs text-secondary">{ i18n.T(lang, "erp.review.reason") }: { i18n.T(lang, "erp.err."+strings.ToLower(strings.TrimPrefix(row.ReasonCode, "ERP_"))) }</div>
								</div>
								<div class="d-flex items-center gap-2">
									<form method="POST" class="d-flex items-center gap-1 m-0"
										action={ templ.SafeURL("/vendor/integrations/review/" + fmt.Sprintf("%d", row.ID) + "/resolve") }>
										<input type="number" name="product_id" min="1" required
											class="form-control form-control-sm w-24" dir="ltr" />
										<button type="submit" class="btn btn-primary btn-xs font-bold">
											{ i18n.T(lang, "erp.review.resolve") }
										</button>
									</form>
									<form method="POST" class="m-0"
										action={ templ.SafeURL(fmt.Sprintf("/vendor/integrations/review/%d/dismiss", row.ID)) }>
										<button type="submit" class="btn btn-outline-danger btn-xs font-bold">
											{ i18n.T(lang, "erp.review.dismiss") }
										</button>
									</form>
								</div>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}
