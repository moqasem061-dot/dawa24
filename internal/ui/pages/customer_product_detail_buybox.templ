package pages

import (
	"fmt"

	"github.com/moqasem061-dot/dawa24/internal/modules/catalog"
	"github.com/moqasem061-dot/dawa24/internal/platform/authctx"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
)

templ CustomerProductDetailBuyBox(product *catalog.Product, offers []SupplierOffer, lang, dir string) {
	<div class="glass-panel p-5 rounded-2xl border shadow-xs product-detail-buy-box stack-md text-start">
		if len(offers) > 0 {
			{{ selectedOffer := selectedProductOffer(offers) }}
			if len(offers) > 1 {
				<div class="stack-2xs">
					<label for="product-offer-select" class="text-2xs text-muted font-bold">{ i18n.T(lang, "product.select_offer") }</label>
					<select id="product-offer-select" class="form-select" aria-describedby="product-offer-help">
						for _, offer := range offers {
							<option
								value={ fmt.Sprintf("%d", offer.VariantID) }
								selected={ offer.VariantID == selectedOffer.VariantID }
								data-offer-id={ fmt.Sprintf("%d", offer.OfferID) }
								data-variant-id={ fmt.Sprintf("%d", offer.VariantID) }
								data-supplier-id={ fmt.Sprintf("%d", offer.SupplierID) }
								data-supplier-name={ offer.SupplierName }
								data-price={ offer.Price.String() }
								data-stock={ fmt.Sprintf(i18n.T(lang, "product.units_count"), offer.AvailableStock) }
								data-stock-count={ fmt.Sprintf("%d", offer.AvailableStock) }
								data-min-qty={ fmt.Sprintf("%d", max(1, offer.MinOrderQty)) }
								data-max-qty={ fmt.Sprintf("%d", offer.OrderCeiling()) }
								data-can-add={ fmt.Sprintf("%t", offer.CanAddToCart) }
								data-negotiable={ fmt.Sprintf("%t", offer.IsNegotiable) }
								data-covered={ fmt.Sprintf("%t", offer.IsCovered) }
								data-coverage-reason={ offer.CoverageReason }
								data-covered-label={ i18n.T(lang, "product.covered_for_branch") }
								data-outside-label={ i18n.T(lang, "product.outside_coverage") }
								data-expiry={ offer.ExpiryDate }
							>
								{ fmt.Sprintf("%s — %s %s", offer.SupplierName, offer.Price.String(), i18n.T(lang, "common.currency_egp")) }
							</option>
						}
					</select>
					<span id="product-offer-help" class="sr-only">{ i18n.T(lang, "product.select_offer_help") }</span>
				</div>
			}
			<!-- 1. Pricing & Net Savings -->
			<div class="stack-2xs pb-3 border-b">
				<span class="text-2xs text-muted font-bold d-block">{ i18n.T(lang, "product.pharmacy_supply_price") }</span>
				<div class="d-flex items-baseline gap-1.5 flex-wrap">
					<span class="tabular-nums text-3xl font-black text-brand" data-product-offer-price>
						{ selectedOffer.Price.String() }
					</span>
					<span class="text-xs font-bold text-secondary">{ i18n.T(lang, "product.per_pack_suffix") }</span>
				</div>
			</div>
			<!-- 2. Selected Supplier -->
			<div class="pb-3 border-b stack-xs">
				<div class="d-flex items-center gap-2 flex-wrap">
					<span class="text-2xs text-muted font-bold">{ i18n.T(lang, "product.supplier_label") }</span>
					<span class="text-xs font-black text-primary" data-product-offer-supplier>
						{ selectedOffer.SupplierName }
					</span>
					<span class="badge badge-amber text-2xs font-extrabold gap-0.5" data-product-offer-negotiable hidden={ !selectedOffer.IsNegotiable }>
						@components.IconTag("icon-2xs")
						<span>{ i18n.T(lang, "product.negotiable") }</span>
					</span>
				</div>
			</div>
			<!-- 3. Inventory & Coverage Status -->
			<div class="pb-3 border-b stack-xs text-xs">
				if buying, has := authctx.BuyingBranchFrom(ctx); has && len(buying.Branches) > 0 {
					<div class="p-1.5 px-2.5 rounded-lg bg-surface border text-2xs d-flex items-center gap-1.5 flex-wrap mb-1">
						<span class="text-muted font-bold">{ i18n.T(lang, "product.receiving_branch") }</span>
						<span class="text-primary font-black d-flex items-center gap-1">
							if buying.IsLocked {
								@components.IconLock("icon-2xs text-amber")
							} else {
								@components.IconMapPin("icon-2xs text-brand")
							}
							<span>{ ActiveBranchName(buying) }</span>
						</span>
						if buying.IsLocked {
							<span class="badge badge-amber text-2xs font-bold">{ i18n.T(lang, "product.branch_locked") }</span>
						}
					</div>
				}
				<div class="flex-between items-center py-1">
					<span class="text-muted">{ i18n.T(lang, "product.available_stock_label") }</span>
					<strong class="product-offer-stock text-brand font-black tabular-nums" data-product-offer-stock data-out-of-stock={ i18n.T(lang, "product.out_of_stock") }>{ fmt.Sprintf(i18n.T(lang, "product.units_count"), selectedOffer.AvailableStock) }</strong>
				</div>
				<div class="flex-between items-center py-1">
					<span class="text-muted">{ i18n.T(lang, "product.min_order_qty_label") }</span>
					<strong class="text-primary font-bold tabular-nums" data-product-offer-min>{ fmt.Sprintf(i18n.T(lang, "product.units_count"), max(1, selectedOffer.MinOrderQty)) }</strong>
				</div>
				<div class="flex-between items-center py-1" data-product-offer-expiry-row>
					<span class="text-muted">{ i18n.T(lang, "product.expiry_date_label") }</span>
					<strong class="font-mono text-primary tabular-nums" data-product-offer-expiry>{ selectedOffer.ExpiryDate }</strong>
				</div>
				<div class="pt-1">
					<div class="product-offer-coverage p-1.5 px-2.5 rounded-lg text-2xs font-bold d-flex items-center gap-1.5" data-product-offer-coverage data-covered={ fmt.Sprintf("%t", selectedOffer.IsCovered) }>
						<span data-product-offer-covered-icon>
							@components.IconCheck("icon-2xs")
						</span>
						<span data-product-offer-outside-icon hidden>
							@components.IconAlert("icon-2xs")
						</span>
						<span data-product-offer-coverage-text>
							if selectedOffer.IsCovered {
								{ i18n.T(lang, "product.covered_for_branch") }
							} else if selectedOffer.CoverageReason != "" {
								{ selectedOffer.CoverageReason }
							} else {
								{ i18n.T(lang, "product.outside_coverage") }
							}
						</span>
					</div>
				</div>
			</div>
			<!-- 4. Stepper & Cart Action -->
			<div class="stack-sm">
				if hasOrderableOffer(offers) {
					<form method="POST" action="/cart/add" hx-post="/cart/add" hx-swap="none" class="stack-sm m-0">
						<input type="hidden" name="variant_id" value={ fmt.Sprintf("%d", selectedOffer.VariantID) }/>
						<input type="hidden" name="product_id" value={ fmt.Sprintf("%d", product.ID) }/>
						<input type="hidden" name="offer_id" value={ fmt.Sprintf("%d", selectedOffer.OfferID) }/>
						<input type="hidden" name="organization_id" value={ fmt.Sprintf("%d", selectedOffer.SupplierID) }/>
						<input type="hidden" name="vendor_org_id" value={ fmt.Sprintf("%d", selectedOffer.SupplierID) }/>
						<input type="hidden" name="offer_price" value={ selectedOffer.Price.String() }/>
						<div>
							<label for="product-offer-qty" class="text-2xs font-bold text-secondary d-block mb-1.5">{ i18n.T(lang, "product.select_quantity") }</label>
							<div class="cart-stepper-control w-full justify-between">
								<button type="button" class="cart-stepper-btn" data-on-click="stepCatalogQty(this, -1)">−</button>
								<input
									id="product-offer-qty"
									type="number"
									name="qty"
									value={ fmt.Sprintf("%d", max(1, selectedOffer.MinOrderQty)) }
									min={ fmt.Sprintf("%d", max(1, selectedOffer.MinOrderQty)) }
									max={ fmt.Sprintf("%d", selectedOffer.OrderCeiling()) }
									class="cart-stepper-input flex-1 text-center font-black"
								/>
								<button type="button" class="cart-stepper-btn" data-on-click="stepCatalogQty(this, 1)">+</button>
							</div>
						</div>
						<button type="submit" disabled={ !selectedOffer.CanAddToCart } class="btn btn-primary font-black text-xs w-full py-2.5 gap-1.5 shadow-sm justify-center">
							@components.IconPlus("icon-xs")
							<span>{ i18n.T(lang, "product.add_to_cart") }</span>
						</button>
						if hasNegotiableOffer(offers) {
							<button
								type="button"
								hidden={ !selectedOffer.IsNegotiable }
								data-product-negotiation
								class="btn btn-secondary text-amber-700 font-black text-xs w-full py-2.5 gap-1.5 shadow-2xs border-amber-300 justify-center"
								data-variant-id={ fmt.Sprintf("%d", selectedOffer.VariantID) }
								data-product-id={ fmt.Sprintf("%d", product.ID) }
								data-vendor-id={ fmt.Sprintf("%d", selectedOffer.SupplierID) }
								data-product-name={ localizedProductTitle(product, lang) }
								data-current-price={ selectedOffer.Price.String() }
								data-min-qty={ fmt.Sprintf("%d", max(1, selectedOffer.MinOrderQty)) }
								data-on-click="openNegotiationModal(this)"
							>
								@components.IconTag("icon-xs")
								<span>{ i18n.T(lang, "product.request_negotiation") }</span>
							</button>
						}
					</form>
				} else {
					<div class="d-flex flex-col justify-center items-center text-center gap-2">
						if selectedOffer.CoverageReason != "" {
							<span class="text-xs text-danger font-bold">{ selectedOffer.CoverageReason }</span>
						} else {
							<span class="text-xs text-muted font-bold">{ i18n.T(lang, "product.order_unavailable_now") }</span>
						}
						<button type="button" disabled class="btn btn-secondary text-xs w-full py-2.5 font-bold cursor-not-allowed opacity-60">
							if selectedOffer.CoverageReason != "" {
								{ selectedOffer.CoverageReason }
							} else {
								{ i18n.T(lang, "product.not_available_direct") }
							}
						</button>
						if hasNegotiableOffer(offers) {
							<button
								type="button"
								hidden={ !selectedOffer.IsNegotiable }
								data-product-negotiation
								class="btn btn-secondary text-amber-700 font-black text-xs w-full py-2.5 gap-1.5 shadow-2xs border-amber-300 justify-center"
								data-variant-id={ fmt.Sprintf("%d", selectedOffer.VariantID) }
								data-product-id={ fmt.Sprintf("%d", product.ID) }
								data-vendor-id={ fmt.Sprintf("%d", selectedOffer.SupplierID) }
								data-product-name={ localizedProductTitle(product, lang) }
								data-current-price={ selectedOffer.Price.String() }
								data-min-qty={ fmt.Sprintf("%d", max(1, selectedOffer.MinOrderQty)) }
								data-on-click="openNegotiationModal(this)"
							>
								@components.IconTag("icon-xs")
								<span>{ i18n.T(lang, "product.request_negotiation") }</span>
							</button>
						}
					</div>
				}
			</div>
		} else {
			<!-- Creative Sourcing Request State (No Offers) -->
			<div class="p-6 text-center d-flex flex-col items-center gap-3">
				<div class="w-12 h-12 rounded-xl bg-primary-subtle text-primary flex-center text-xl">
					@components.IconPackage("icon-md")
				</div>
				<div>
					<h4 class="font-extrabold text-sm text-primary m-0 mb-1">
						{ i18n.T(lang, "product.no_instant_offers_title") }
					</h4>
					<p class="text-xs text-muted m-0 leading-relaxed">
						{ i18n.T(lang, "product.no_instant_offers_desc") }
					</p>
				</div>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/customer/purchase-request?product_id=%d", product.ID)) }
					class="btn btn-primary btn-sm font-bold gap-1 mt-1"
				>
					@components.IconPlus("icon-xs")
					<span>{ i18n.T(lang, "product.send_sourcing_request") }</span>
				</a>
			</div>
		}
	</div>
}
