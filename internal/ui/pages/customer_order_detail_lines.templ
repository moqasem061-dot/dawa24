package pages

import (
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/commerce"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/shared/format"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
)

templ CustomerOrderLines(order *commerce.Order, lang string, reviews map[int64]*org.Review) {
	<!-- Shipments & Line Items Table Card -->
	<div class="glass-panel p-6 mb-0" id="order-lines-container">
		<div class="flex-between items-center mb-4 flex-wrap gap-3 pb-3 border-b">
			<div class="d-flex items-center gap-2">
				<span class="text-xl">@components.IconPill("icon-sm")</span>
				<h2 class="text-base font-extrabold text-primary m-0">
					{ i18n.T(lang, "orders.lines_title") }
				</h2>
			</div>
			<div class="d-flex items-center gap-2 flex-wrap">
				if order.Status == commerce.StatusPending {
					<span class="badge badge-amber text-xs font-black">
						<span>{ i18n.T(lang, "orders.lines_editable_badge") }</span>
					</span>
				} else {
					<span class="badge badge-slate text-xs font-bold" title="Locked">
						<span>{ i18n.T(lang, "orders.lines_locked_badge") }</span>
					</span>
				}
				<span class="badge badge-sky text-xs font-bold">
					<span>{ i18n.T(lang, "orders.cold_chain_badge") }</span>
				</span>
			</div>
		</div>

		if len(order.Shipments) == 0 && len(order.Lines) == 0 {
			@components.EmptyState(components.EmptyStateProps{
				Title:   i18n.T(lang, "orders.lines_preparing_title"),
				Message: i18n.T(lang, "orders.lines_preparing_msg"),
			})
		} else if order.Status == commerce.StatusPending {
			<!-- Direct & Editable Order Lines Form -->
			<form class="stack-md" method="POST" action={ templ.SafeURL(fmt.Sprintf("/orders/%d/edit", order.ID)) } id="main-order-lines-form">
				if len(order.Shipments) > 0 {
					<div class="stack-sm">
						for idx, sh := range order.Shipments {
							<div class="stack-sm">
								<div class="stack-sm">
									<div class="inline-row-06">
										<span class="badge badge-primary text-xs fw-800 tabular-nums">{ fmt.Sprintf(i18n.T(lang, "orders.parcel_num"), idx+1) }</span>
										<strong>{ sh.VendorName.Get(i18n.Lang(lang)) }</strong>
										<span>({ i18n.T(lang, "orders.parcel_shipment_num") } <span class="tabular-nums font-mono">{ sh.ShipmentNumber }</span>)</span>
									</div>
									<div class="d-flex items-center gap-2">
										if sh.TrackingNumber != "" {
											<span class="badge badge-slate text-xs font-mono">{ i18n.T(lang, "orders.parcel_waybill") } { sh.TrackingNumber }</span>
										}
										@components.StatusBadge(string(sh.Status), lang)
									</div>
								</div>

								<div x-data={ shipmentPaginationAlpineData(len(sh.Lines)) }>
									<div class="table-container m-0">
										<table class="data-table m-0">
											<thead>
												<tr>
													<th>{ i18n.T(lang, "orders.th_medicine") }</th>
													<th class="text-center">{ i18n.T(lang, "orders.th_qty_ordered") }</th>
													<th class="text-end">{ i18n.T(lang, "orders.th_public_price") }</th>
													<th class="text-center">{ i18n.T(lang, "orders.th_discount_pct") }</th>
													<th class="text-end">{ i18n.T(lang, "orders.th_net_total") }</th>
													<th class="text-center"></th>
												</tr>
											</thead>
											<tbody>
												for idx, l := range sh.Lines {
													@EditableOrderLineRow(order, l, lang, idx)
												}
											</tbody>
										</table>
									</div>
									@ShipmentLinesPagination(len(sh.Lines))
								</div>
							</div>
						}
					</div>
				} else {
					<div x-data={ shipmentPaginationAlpineData(len(order.Lines)) }>
						<div class="table-container m-0">
							<table class="data-table m-0">
								<thead>
									<tr>
										<th>{ i18n.T(lang, "orders.th_medicine") }</th>
										<th class="text-center">{ i18n.T(lang, "orders.th_qty_ordered") }</th>
										<th class="text-end">{ i18n.T(lang, "orders.th_public_price") }</th>
										<th class="text-center">{ i18n.T(lang, "orders.th_discount_pct") }</th>
										<th class="text-end">{ i18n.T(lang, "orders.th_net_total") }</th>
										<th class="text-center"></th>
									</tr>
								</thead>
								<tbody>
									for idx, l := range order.Lines {
										@EditableOrderLineRow(order, l, lang, idx)
									}
								</tbody>
							</table>
						</div>
						@ShipmentLinesPagination(len(order.Lines))
					</div>
				}

				<!-- Save Edits Action Bar -->
				<div class="glass-panel p-4 flex-between items-center mt-4 flex-wrap gap-3 border-brand-subtle">
					<div class="d-flex items-center gap-3 text-xs text-secondary flex-wrap">
						<span class="badge badge-amber font-bold">{ i18n.T(lang, "common.pending") }</span>
						<span>{ i18n.T(lang, "orders.pending_edits_notice") }</span>
						<span class="text-brand font-black ms-2 tabular-nums">{ i18n.T(lang, "orders.net_total_label") } <span id="form-bar-total">{ format.Money(order.TotalAmount, lang) }</span></span>
					</div>
					<div class="d-flex items-center gap-2">
						<button type="submit" id="save-order-lines-btn" class="btn btn-primary font-bold text-xs px-5 py-2 gap-2 shadow-sm">
							@components.IconCheck("icon-xs")
							<span>{ i18n.T(lang, "orders.save_qty_edits_btn") }</span>
						</button>
					</div>
				</div>
			</form>
		} else {
			<!-- Read-Only Locked Table for Confirmed / Processed Orders -->
			if len(order.Shipments) > 0 {
				<div class="d-flex flex-col gap-4">
					for idx, sh := range order.Shipments {
						<div class="glass-panel p-0 mb-0 overflow-hidden">
							<div class="flex-between items-center p-3 px-4 bg-surface-sunken border-b flex-wrap gap-2">
								<div class="d-flex items-center gap-2">
									<span class="badge badge-primary text-xs font-bold tabular-nums">{ fmt.Sprintf(i18n.T(lang, "orders.parcel_num"), idx+1) }</span>
									<strong class="text-xs font-extrabold text-primary">
										{ sh.VendorName.Get(i18n.Lang(lang)) }
									</strong>
								</div>
								<div class="d-flex items-center gap-2 flex-wrap">
									if sh.TrackingNumber != "" {
										<span class="badge badge-slate text-xs font-mono">{ i18n.T(lang, "orders.parcel_waybill") } { sh.TrackingNumber }</span>
									}
									if sh.DeliveryCode != "" && sh.Status != commerce.StatusDelivered && sh.Status != commerce.StatusCompleted && sh.Status != commerce.StatusCancelled {
										<span class="badge badge-emerald text-xs font-black font-mono tracking-wider shadow-2xs">
											{ fmt.Sprintf(i18n.T(lang, "orders.parcel_pin_label"), idx+1) } { sh.DeliveryCode }
										</span>
									}
									@components.StatusBadge(string(sh.Status), lang)
									if sh.Status == commerce.StatusDelivered || sh.Status == commerce.StatusCompleted {
										@VendorShipmentReviewButton(order.ID, sh, reviews[sh.OrganizationID] != nil, reviewScoreOf(reviews[sh.OrganizationID]), lang)
									}
								</div>
							</div>
							<div x-data={ shipmentPaginationAlpineData(len(sh.Lines)) }>
								<div class="table-container m-0">
									<table class="data-table m-0">
										<thead>
											<tr>
												<th>{ i18n.T(lang, "orders.th_medicine") }</th>
												<th class="text-center">{ i18n.T(lang, "orders.th_qty") }</th>
												<th class="text-end">{ i18n.T(lang, "orders.th_public_price") }</th>
												<th class="text-center">{ i18n.T(lang, "orders.th_discount_pct") }</th>
												<th class="text-end">{ i18n.T(lang, "orders.th_supply_price") }</th>
												<th class="text-end">{ i18n.T(lang, "orders.th_total") }</th>
											</tr>
										</thead>
										<tbody>
											for lIdx, l := range sh.Lines {
												@ReadOnlyOrderLineRow(order, l, lang, lIdx)
											}
										</tbody>
									</table>
								</div>
								@ShipmentLinesPagination(len(sh.Lines))
							</div>
						</div>
					}
				</div>
			} else {
				<div x-data={ shipmentPaginationAlpineData(len(order.Lines)) }>
					<div class="table-container m-0">
						<table class="data-table m-0">
							<thead>
								<tr>
									<th>{ i18n.T(lang, "orders.th_medicine") }</th>
									<th class="text-center">{ i18n.T(lang, "orders.th_qty") }</th>
									<th class="text-end">{ i18n.T(lang, "orders.th_public_price") }</th>
									<th class="text-center">{ i18n.T(lang, "orders.th_discount_pct") }</th>
									<th class="text-end">{ i18n.T(lang, "orders.th_supply_price") }</th>
									<th class="text-end">{ i18n.T(lang, "orders.th_total") }</th>
								</tr>
							</thead>
							<tbody>
								for lIdx, l := range order.Lines {
									@ReadOnlyOrderLineRow(order, l, lang, lIdx)
								}
							</tbody>
						</table>
					</div>
					@ShipmentLinesPagination(len(order.Lines))
				</div>
			}
		}
	</div>
}

templ EditableOrderLineRow(order *commerce.Order, l *commerce.OrderLine, lang string, rowIdx int) {
	<tr
		class="order-table-row"
		data-line-id={ fmt.Sprintf("%d", l.ID) }
		data-unit-price-minor={ fmt.Sprintf("%d", linePublicPrice(l).Minor()) }
		data-unit-discount-minor={ fmt.Sprintf("%d", unitDiscountMinor(l)) }
		data-min-qty={ fmt.Sprintf("%d", minAllowedQty(l)) }
		data-max-qty={ fmt.Sprintf("%d", maxAllowedQty(l)) }
		data-available-stock={ fmt.Sprintf("%d", l.AvailableStock) }
		x-show={ fmt.Sprintf("pageSize === -1 || (%d >= (page - 1) * pageSize && %d < page * pageSize)", rowIdx, rowIdx) }
	>
		<td>
			<div class="d-flex items-center gap-2 flex-wrap">
				if l.ProductID != nil && *l.ProductID > 0 {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/customer/catalog/%d", *l.ProductID)) }
						class="font-extrabold text-primary text-xs hover:text-brand hover:underline"
					>
						{ l.ProductName.Get(i18n.Lang(lang)) }
					</a>
				} else {
					<span class="font-extrabold text-primary text-xs">
						{ l.ProductName.Get(i18n.Lang(lang)) }
					</span>
				}
				if isOrderLineAnOffer(l) {
					<button
						type="button"
						class="btn btn-secondary btn-sm font-bold text-xs gap-1.5"
						data-modal-open="order-offer-modal"
						hx-get={ fmt.Sprintf("/customer/orders/%d/lines/%d/offer-details", order.ID, l.ID) }
						hx-target="#order-offer-modal-container"
						hx-swap="innerHTML"
						title={ i18n.T(lang, "orders.btn_view_offer") }
					>
						@components.IconSparkles("icon-xs text-amber-500")
						<span>{ i18n.T(lang, "orders.btn_view_offer") }</span>
					</button>
				}
			</div>
			if l.VariantName.Get(i18n.Lang(lang)) != "" || l.SKU != "" {
				<div class="text-xs text-muted mt-1">
					if l.VariantName.Get(i18n.Lang(lang)) != "" {
						<span>{ l.VariantName.Get(i18n.Lang(lang)) }</span>
					}
					if l.SKU != "" {
						<span class="font-mono text-xs ms-1">SKU: { l.SKU }</span>
					}
				</div>
			}
			if l.AvailableStock > 0 {
				<div class="mt-1">
					<span class="badge badge-emerald text-xs font-bold">
						{ fmt.Sprintf(i18n.T(lang, "orders.supplier_available_stock"), l.AvailableStock) }
					</span>
				</div>
			}
			<input type="hidden" name="line_id[]" value={ fmt.Sprintf("%d", l.ID) }/>
			<input type="hidden" name="product_name[]" value={ l.ProductName.Get(i18n.Lang(lang)) }/>
			<input type="hidden" name="unit_price[]" value={ l.UnitPrice.String() } class="row-unit-price-input"/>
			<input type="hidden" name="discount_amount[]" value={ l.DiscountAmount.String() } class="row-discount-input"/>
			<input type="hidden" name="is_deleted[]" value="0" class="row-deleted-input"/>
		</td>
		<td class="text-center align-middle">
			<div class="order-qty-stepper">
				<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold qty-step-btn" data-on-click="stepRowQty(this, -1)">−</button>
				<input
					type="number"
					name="quantity[]"
					value={ fmt.Sprintf("%d", l.Quantity) }
					min={ fmt.Sprintf("%d", minAllowedQty(l)) }
					if maxAllowedQty(l) < 99999 {
						max={ fmt.Sprintf("%d", maxAllowedQty(l)) }
					}
					required
					class="form-input row-qty-input font-bold"
					data-on-input="recalcRowTotal(this)"
				/>
				<button type="button" class="btn btn-secondary btn-icon btn-sm font-bold qty-step-btn" data-on-click="stepRowQty(this, 1)">+</button>
			</div>
		</td>
		<td class="text-end tabular-nums font-bold text-xs text-primary">
			{ format.Money(linePublicPrice(l), lang) }
		</td>
		<td class="text-center tabular-nums">
			{{ discPct := lineDiscountPercent(l) }}
			if discPct > 0 {
				<span class="badge badge-emerald text-xs font-bold tabular-nums">{ fmt.Sprintf("%d%%", int(discPct + 0.5)) }</span>
			} else {
				<span class="text-xs text-muted">0%</span>
			}
		</td>
		<td class="text-end tabular-nums font-black text-brand text-xs">
			<span class="row-total-display">{ format.Money(l.TotalPrice, lang) }</span>
		</td>
		<td class="col-actions">
			<button type="button" class="btn btn-secondary btn-icon btn-sm text-danger" data-on-click="deleteRowLine(this)">
				@components.IconX("icon-sm")
			</button>
		</td>
	</tr>
}

templ ReadOnlyOrderLineRow(order *commerce.Order, l *commerce.OrderLine, lang string, rowIdx int) {
	<tr x-show={ fmt.Sprintf("pageSize === -1 || (%d >= (page - 1) * pageSize && %d < page * pageSize)", rowIdx, rowIdx) }>
		<td>
			<div class="d-flex items-center gap-2 flex-wrap">
				if l.ProductID != nil && *l.ProductID > 0 {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/customer/catalog/%d", *l.ProductID)) }
						class="font-extrabold text-primary text-xs hover:text-brand hover:underline"
					>
						{ l.ProductName.Get(i18n.Lang(lang)) }
					</a>
				} else {
					<span class="font-extrabold text-primary text-xs">
						{ l.ProductName.Get(i18n.Lang(lang)) }
					</span>
				}
				if isOrderLineAnOffer(l) {
					<button
						type="button"
						class="btn btn-secondary btn-sm font-bold text-xs gap-1.5"
						data-modal-open="order-offer-modal"
						hx-get={ fmt.Sprintf("/customer/orders/%d/lines/%d/offer-details", order.ID, l.ID) }
						hx-target="#order-offer-modal-container"
						hx-swap="innerHTML"
						title={ i18n.T(lang, "orders.btn_view_offer") }
					>
						@components.IconSparkles("icon-xs text-amber-500")
						<span>{ i18n.T(lang, "orders.btn_view_offer") }</span>
					</button>
				}
			</div>
			if l.VariantName.Get(i18n.Lang(lang)) != "" || l.SKU != "" {
				<div class="text-xs text-muted mt-1">
					if l.VariantName.Get(i18n.Lang(lang)) != "" {
						<span>{ l.VariantName.Get(i18n.Lang(lang)) }</span>
					}
					if l.SKU != "" {
						<span class="font-mono text-xs ms-1">SKU: { l.SKU }</span>
					}
				</div>
			}
		</td>
		<td class="text-center">
			<span class="tabular-nums font-bold text-xs p-1 px-2 rounded bg-surface border">
				{ fmt.Sprintf("%d", l.Quantity) }
			</span>
		</td>
		<td class="text-end tabular-nums text-xs text-primary font-bold">
			{ format.Money(linePublicPrice(l), lang) }
		</td>
		<td class="text-center tabular-nums">
			{{ discPct := lineDiscountPercent(l) }}
			if discPct > 0 {
				<span class="badge badge-emerald text-xs font-bold tabular-nums">{ formatDiscount(discPct) }%</span>
			} else {
				<span class="text-xs text-muted">0%</span>
			}
		</td>
		<td class="text-end tabular-nums text-xs text-secondary font-bold">
			{ format.Money(lineSupplyPrice(l), lang) }
		</td>
		<td class="text-end tabular-nums font-black text-brand text-xs">
			{ format.Money(l.TotalPrice, lang) }
		</td>
	</tr>
}
