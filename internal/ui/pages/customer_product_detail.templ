package pages

import (
	"fmt"

	"github.com/moqasem061-dot/dawa24/internal/modules/catalog"
	"github.com/moqasem061-dot/dawa24/internal/platform/authctx"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/imageurl"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

templ CustomerProductDetail(product *catalog.Product, variants []*catalog.ProductVariant, offers []SupplierOffer, lang, dir string) {
	@layouts.ShellFor(localizedProductTitle(product, lang)+" | "+i18n.T(lang, "product.title_suffix"), "catalog", lang, dir, authctx.FromContext(ctx)) {
		<div class="py-2">
			<!-- Breadcrumb Navigation -->
			<nav class="d-flex items-center gap-2 text-xs text-muted mb-4 flex-wrap font-bold" aria-label={ i18n.T(lang, "nav.breadcrumb") }>
				{{ actor := authctx.FromContext(ctx) }}
				{{ dashboardURL := "/customer/dashboard" }}
				{{
					if actor.IsVendor() {
						dashboardURL = "/vendor/dashboard"
					} else if actor.IsStaff {
						dashboardURL = "/admin/dashboard"
					}
				}}
				<a href={ templ.SafeURL(dashboardURL) } class="text-secondary transition-colors">{ i18n.T(lang, "nav.dashboard") }</a>
				<span>/</span>
				<a href="/catalog" class="text-secondary transition-colors">{ i18n.T(lang, "nav.catalog") }</a>
				<span>/</span>
				<span class="text-primary font-black">{ localizedProductTitle(product, lang) }</span>
			</nav>
			<!-- Sponsored Product Top Banner if offer is sponsored -->
			if len(offers) > 0 && offers[0].IsSponsored {
				<div class="product-detail-sponsored-banner mb-4 shadow-xs">
					<div class="d-flex items-center gap-2.5">
						<span class="sponsored-star">★</span>
						<div class="stack-2xs text-start">
							<strong class="text-xs font-black text-amber-900 leading-tight">{ i18n.T(lang, "product.sponsored_banner_title") }</strong>
							<span class="text-2xs text-amber-800 font-medium">{ i18n.T(lang, "product.sponsored_banner_desc") }</span>
						</div>
					</div>
					<span class="badge badge-amber text-xs font-extrabold shadow-2xs">{ i18n.T(lang, "product.sponsored_ad") }</span>
				</div>
			}
			<!-- 1. Hero Product Showcase Grid (3 Columns B2B E-Commerce: Media, Specs, Buy Box) -->
			<div class="b2b-customer-showcase mb-6">
				<!-- Product media -->
				<div class="b2b-product-gallery">
					<div class="b2b-product-media-card glass-panel p-4 min-h-[300px] md:min-h-[340px] relative group">
						if resolveProductImage(product) != "" {
							<a
								href={ templ.SafeURL(imageurl.Normalize(resolveProductImage(product))) }
								data-preview-file={ imageurl.Normalize(resolveProductImage(product)) }
								data-is-image="true"
								data-title={ localizedProductTitle(product, lang) }
								target="_blank"
								rel="noopener noreferrer"
								aria-label={ i18n.T(lang, "preview.modal.newtab_tooltip") }
								class="w-full h-full flex flex-col items-center justify-center cursor-zoom-in relative group/img"
								title={ i18n.T(lang, "preview.modal.newtab_tooltip") }
							>
								@components.ProductImage(imageurl.Full(resolveProductImage(product), localizedProductTitle(product, lang), "b2b-product-img object-contain transition-transform duration-300 group-hover/img:scale-105 my-2"))
								<div class="product-img-fallback hidden flex-col items-center justify-center text-muted gap-2">
									<div class="w-16 h-16 rounded-2xl bg-primary-subtle text-primary flex-center text-xl mb-1">
										@components.IconPill("icon-md")
									</div>
									<div class="font-extrabold text-xs text-primary">{ i18n.T(lang, "product.image_unavailable") }</div>
								</div>
								<span class="absolute bottom-2 end-2 badge badge-slate text-2xs font-bold gap-1 shadow-xs opacity-80 group-hover/img:opacity-100 transition-opacity pointer-events-none">
									@components.IconSearch("icon-2xs")
									<span>{ i18n.T(lang, "product.image_zoom") }</span>
								</span>
							</a>
						} else {
							<div class="d-flex flex-col items-center justify-center text-muted gap-2 my-auto">
								<div class="w-16 h-16 rounded-2xl bg-primary-subtle text-primary flex-center text-xl mb-1">
									@components.IconPill("icon-md")
								</div>
								<div class="font-extrabold text-xs text-primary">{ i18n.T(lang, "product.image_unavailable") }</div>
							</div>
						}
					</div>
				</div>
				<!-- Col 2 (Center in RTL): Product Info, Clinical Specifications, Variants & Indications -->
				<div class="b2b-product-info-panel">
					<!-- Header Block -->
					<div>
						<div class="d-flex items-center gap-2 mb-2 flex-wrap">
							if product.ManufacturingCompanies != "" {
								<span class="badge badge-slate text-xs font-bold gap-1">
									@components.IconBuilding("icon-2xs")
									<span>{ product.ManufacturingCompanies }</span>
								</span>
							}
							if product.DosageForm != "" {
								<span class="badge badge-sky text-xs font-bold">
									{ product.DosageForm }
								</span>
							}
						</div>
						<h1 class="text-2xl lg:text-3xl font-black text-primary m-0 mb-1 leading-tight">
							{ localizedProductTitle(product, lang) }
						</h1>
						if product.Name["en"] != "" && product.Name["en"] != product.Name["ar"] {
							<div class="text-sm text-muted font-mono mb-2 font-bold" dir="ltr">
								{ product.Name["en"] }
							</div>
						}
					</div>
					<!-- Clinical Specifications Table (No nested card clutter) -->
					<div class="pt-2">
						<h2 class="text-xs font-extrabold text-muted uppercase tracking-wider mb-2">
							{ i18n.T(lang, "product.specifications_title") }
						</h2>
						<table class="b2b-specs-table">
							<tbody>
								if product.Active != "" {
									<tr>
										<th>{ i18n.T(lang, "product.active_ingredient") }</th>
										<td><span>{ product.Active }</span></td>
									</tr>
								}
								if product.ScientificName != "" && product.ScientificName != product.Active {
									<tr>
										<th>{ i18n.T(lang, "product.scientific_name") }</th>
										<td><span class="font-mono">{ product.ScientificName }</span></td>
									</tr>
								}
								if product.DosageForm != "" {
									<tr>
										<th>{ i18n.T(lang, "catalog.dosage_form") }</th>
										<td><span>{ product.DosageForm }</span></td>
									</tr>
								}
								if product.Concentration != "" {
									<tr>
										<th>{ i18n.T(lang, "product.concentration") }</th>
										<td><span>{ product.Concentration }</span></td>
									</tr>
								}
								if product.Unit != "" {
									<tr>
										<th>{ i18n.T(lang, "product.packing_unit") }</th>
										<td><span>{ product.Unit }</span></td>
									</tr>
								}
								if product.Barcode != "" {
									<tr>
										<th>{ i18n.T(lang, "product.gtin_barcode") }</th>
										<td><span class="font-mono">{ product.Barcode }</span></td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					<!-- Variants Packaging Strip -->
					if len(variants) > 0 {
						<div class="pt-3 border-t">
							<label class="text-xs font-extrabold text-primary d-block mb-2">
								{ i18n.T(lang, "product.registered_variants") }
							</label>
							<div class="d-flex flex-wrap gap-2">
								for _, v := range variants {
									<div class="p-2 px-3 rounded-lg bg-surface border text-xs d-flex items-center gap-2">
										<span class="font-bold text-primary">
											if v.Name["ar"] != "" {
												{ v.Name["ar"] }
											} else {
												{ v.SKU }
											}
										</span>
										if v.Price.IsPositive() {
											<span class="text-brand font-black tabular-nums font-mono">
												{ fmt.Sprintf("%s %s", v.Price.String(), i18n.T(lang, "common.currency_egp")) }
											</span>
										}
									</div>
								}
							</div>
						</div>
					}
					<!-- Description / Indications if present -->
					if product.Description["ar"] != "" || product.Description["en"] != "" {
						<div class="pt-3 border-t">
							<div class="text-xs font-bold text-muted mb-1.5">{ i18n.T(lang, "product.description_title") }</div>
							<div class="text-xs text-primary leading-relaxed">
								if product.Description["ar"] != "" {
									{ product.Description["ar"] }
								} else {
									{ product.Description["en"] }
								}
							</div>
						</div>
					}
				</div>
				<!-- Col 3 (Left in RTL): Primary Purchase Box / Special Sourcing Card (Sticky) -->
				<div class="b2b-buybox-col">
					@CustomerProductDetailBuyBox(product, offers, lang, dir)
				</div>
			</div>
			<!-- 2. Other Supplier Offers Comparison Table -->
			@CustomerProductDetailOffersTable(product, offers, lang)
		</div>
		<script nonce={ layouts.Nonce(ctx) }>
			function showProductImageFallback(image) {
				image.style.display = 'none';
				const fallback = image.closest('.b2b-product-media-card')?.querySelector('.product-img-fallback');
				if (fallback) fallback.classList.remove('hidden');
				const link = image.closest('a');
				if (link) {
					link.removeAttribute('href');
					link.classList.remove('cursor-zoom-in');
				}
			}
		document.querySelectorAll('.b2b-product-media-card img').forEach(image => {
				if (image.complete && image.naturalWidth === 0) showProductImageFallback(image);
				else image.addEventListener('error', () => showProductImageFallback(image), { once: true });
			});

			function stepCatalogQty(btn, delta) {
				const form = btn.closest('form') || btn.closest('.product-detail-buy-box');
				if (!form) return;
				const input = form.querySelector('input[name="qty"]');
				if (input) {
					let val = parseInt(input.value, 10) || 1;
					val += delta;
					const min = parseInt(input.getAttribute('min') || '1', 10);
					const max = parseInt(input.getAttribute('max') || '9999', 10);
					if (val < min) val = min;
					if (val > max && max > 0) val = max;
					input.value = val;
				}
			}

			function updateProductOffer(select) {
				const option = select.selectedOptions[0];
				const buyBox = select.closest('.product-detail-buy-box');
				updateProductOfferDisplay(buyBox, option.dataset);
				updateProductCartForm(buyBox, option);
				updateProductNegotiation(buyBox, option.dataset);
			}

			function updateProductOfferDisplay(buyBox, offer) {
				buyBox.querySelector('[data-product-offer-price]').textContent = offer.price;
				buyBox.querySelector('[data-product-offer-supplier]').textContent = offer.supplierName;
				buyBox.querySelector('[data-product-offer-min]').textContent = offer.minQty;
				const stock = buyBox.querySelector('[data-product-offer-stock]');
				stock.textContent = Number(offer.stockCount) > 0 ? offer.stock : stock.dataset.outOfStock;
				stock.classList.toggle('text-brand', Number(offer.stockCount) > 0);
				stock.classList.toggle('text-danger', Number(offer.stockCount) <= 0);
				const expiryRow = buyBox.querySelector('[data-product-offer-expiry-row]');
				expiryRow.hidden = !offer.expiry;
				buyBox.querySelector('[data-product-offer-expiry]').textContent = offer.expiry;
				updateProductOfferCoverage(buyBox, offer);
			}

			function updateProductOfferCoverage(buyBox, offer) {
				const coverage = buyBox.querySelector('[data-product-offer-coverage]');
				const covered = offer.covered === 'true';
				coverage.dataset.covered = offer.covered;
				coverage.querySelector('[data-product-offer-covered-icon]').hidden = !covered;
				coverage.querySelector('[data-product-offer-outside-icon]').hidden = covered;
				const text = offer.coverageReason || (covered ? offer.coveredLabel : offer.outsideLabel);
				coverage.querySelector('[data-product-offer-coverage-text]').textContent = text;
			}

			function updateProductCartForm(buyBox, option) {
				const form = buyBox.querySelector('form[action="/cart/add"]');
				if (!form) return;
				const offer = option.dataset;
				form.querySelector('[name="variant_id"]').value = offer.variantId;
				form.querySelector('[name="offer_id"]').value = offer.offerId;
				form.querySelector('[name="organization_id"]').value = offer.supplierId;
				form.querySelector('[name="vendor_org_id"]').value = offer.supplierId;
				form.querySelector('[name="offer_price"]').value = offer.price;
				const quantity = form.querySelector('[name="qty"]');
				const minimum = Number(offer.minQty);
				const maximum = Math.max(minimum, Number(offer.maxQty));
				quantity.min = minimum;
				quantity.max = maximum;
				quantity.value = Math.min(maximum, Math.max(minimum, Number(quantity.value) || minimum));
				form.querySelector('[type="submit"]').disabled = offer.canAdd !== 'true';
			}

			function updateProductNegotiation(buyBox, offer) {
				const negotiationBadge = buyBox.querySelector('[data-product-offer-negotiable]');
				negotiationBadge.hidden = offer.negotiable !== 'true';
				const button = buyBox.querySelector('[data-product-negotiation]');
				if (!button) return;
				button.hidden = offer.negotiable !== 'true';
				button.dataset.variantId = offer.variantId;
				button.dataset.vendorId = offer.supplierId;
				button.dataset.currentPrice = offer.price;
				button.dataset.minQty = offer.minQty;
			}

			const productOfferSelect = document.getElementById('product-offer-select');
			if (productOfferSelect) {
				productOfferSelect.addEventListener('change', () => updateProductOffer(productOfferSelect));
			}
		</script>
		@CustomerNegotiationModal()
	}
}
