package pages

import (
	"fmt"
	"strings"

	platformadmin "github.com/moqasem061-dot/dawa24/internal/modules/platform_admin"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

// The contact inbox.
//
// It is a list of messages, not the messages themselves. The full text of every
// inquiry used to be printed in a table cell, which is where this screen stopped
// being usable: the column widened to the longest message on the page, the
// sender block above it wrapped around an IP address and a raw browser string,
// and two rows could fill a laptop screen. Reading one message meant reading all
// of them.
//
// So a row now answers the three questions a queue has to answer — who, about
// what, and since when — and the message itself opens in a dialog
// (AdminMessageModal), with the sender's details and the actions beside it.
//
// The rest of the screen is spent on the decisions a row has to make visible:
// an unread message is tinted and carries a dot, so the queue can be scanned for
// what still needs an answer; the actions are icon buttons of one width, because
// the previous text buttons changed length when they flipped between "تمت
// المتابعة" and "غير مقروءة" and made the whole column jump; and the metadata
// that belongs to a single message (IP, browser, registered-user link) has moved
// into that message's dialog rather than being repeated in every row.
func resolveMessageSubject(subj string) string {
	s := strings.TrimSpace(subj)
	if s == "" {
		return "استفسار عام"
	}
	return s
}

func messageSubjectBadgeClass(subj string) string {
	s := strings.ToLower(subj)
	switch {
	case strings.Contains(s, "صيدلية"):
		return "badge-emerald"
	case strings.Contains(s, "مورد") || strings.Contains(s, "شركة"):
		return "badge-indigo"
	case strings.Contains(s, "طلب") || strings.Contains(s, "توريد"):
		return "badge-sky"
	case strings.Contains(s, "دفع") || strings.Contains(s, "سداد") || strings.Contains(s, "فواتير"):
		return "badge-amber"
	case strings.Contains(s, "دعم") || strings.Contains(s, "فني"):
		return "badge-purple"
	default:
		return "badge-slate"
	}
}

func cleanPhoneForWhatsApp(phone string) string {
	raw := strings.TrimSpace(phone)
	raw = strings.TrimPrefix(raw, "+")
	raw = strings.TrimPrefix(raw, "00")
	if strings.HasPrefix(raw, "20") {
		return raw
	}
	if strings.HasPrefix(raw, "0") {
		return "20" + strings.TrimPrefix(raw, "0")
	}
	if len(raw) == 10 && strings.HasPrefix(raw, "1") {
		return "20" + raw
	}
	return raw
}

// unreadOnPage counts what an operator still owes a reply for, on the page in
// front of them. It is labelled as such in the header: the total across the
// inbox is not in this response, and a number that silently means something
// narrower than the reader assumes is worse than no number.
func unreadOnPage(messages []*platformadmin.ContactMessage) int {
	unread := 0
	for _, m := range messages {
		if isUnreadMessage(m.Status) {
			unread++
		}
	}
	return unread
}

templ AdminMessages(lang, dir string, messages []*platformadmin.ContactMessage, page, perPage, totalCount int) {
	@layouts.AdminShell("رسائل واستفسارات التواصل", "messages", lang, dir) {
		<div class="page-container">
			<header class="glass-panel p-6 mb-6">
				<div class="flex-between items-center flex-wrap gap-4">
					<div class="d-flex items-center gap-3">
						<div class="user-avatar-badge text-xl">
							@components.IconInbox("icon-sm")
						</div>
						<div class="stack-sm">
							<h1 class="text-2xl font-black text-primary m-0">
								رسائل واستفسارات التواصل ({ fmt.Sprintf("%d", totalCount) })
							</h1>
							<p class="text-sm text-secondary m-0 mt-1">
								الطلبات الواردة من نموذج «تواصل معنا». يعرض الجدول ملخص كل رسالة، ونصها الكامل في نافذة القراءة.
							</p>
						</div>
					</div>
					<div class="d-flex items-center gap-2 flex-wrap">
						if unread := unreadOnPage(messages); unread > 0 {
							<span class="badge badge-rose fw-800" title="عدد الرسائل غير المقروءة في هذه الصفحة">
								<span>{ fmt.Sprintf("%d", unread) }</span>
								<span>غير مقروءة في هذه الصفحة</span>
							</span>
						}
						<a href="/admin/messages" class="btn btn-secondary btn-sm font-bold text-xs gap-1">
							@components.IconRefresh("icon-xs")
							<span>تحديث الرسائل</span>
						</a>
					</div>
				</div>
			</header>

			<div class="glass-panel p-0 mb-6 overflow-hidden">
				if len(messages) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-4xl mb-3">@components.IconMail("icon-sm")</div>
						<h3 class="text-lg font-black text-primary mb-2">لا توجد رسائل تواصل واردة</h3>
						<p class="text-sm text-secondary max-w-md mx-auto">لم يقم أي مستخدم بإرسال رسائل أو استفسارات عبر صفحة تواصل معنا حتى الآن.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table data-table-compact m-0">
							<thead>
								<tr>
									<th class="text-center">#</th>
									<th>المرسل</th>
									<th>الموضوع والملخص</th>
									<th class="text-center">الحالة</th>
									<th>التاريخ</th>
									<th class="col-actions text-center">الإجراءات</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range messages {
									<tr class={ "inbox-row", templ.KV("is-unread", isUnreadMessage(m.Status)) }>
										<td class="text-center tabular-nums text-xs text-muted inbox-id">
											{ fmt.Sprintf("%d", m.ID) }
										</td>
										<td>
											<div class="d-flex items-center gap-2">
												<span class="inbox-avatar" aria-hidden="true">{ senderInitials(m.Name) }</span>
												<div class="stack-xs inbox-sender">
													<div class="d-flex items-center gap-1 flex-wrap">
														if isUnreadMessage(m.Status) {
															<span class="inbox-unread-dot" aria-hidden="true"></span>
														}
														<span class="fw-800 text-primary text-sm">{ m.Name }</span>
													</div>
													if m.Email != "" {
														<div dir="ltr" class="inbox-contact">
															<a href={ templ.SafeURL(fmt.Sprintf("mailto:%s", m.Email)) } title={ m.Email }>{ m.Email }</a>
														</div>
													}
													if m.Phone != "" {
														<div dir="ltr" class="inbox-contact tabular-nums">
															<a href={ templ.SafeURL("tel:" + m.Phone) }>{ m.Phone }</a>
														</div>
													}
												</div>
											</div>
										</td>
										<td>
											<div class="stack-xs">
												<div class="d-flex items-center gap-1 flex-wrap">
													<span class={ "badge font-bold", messageSubjectBadgeClass(m.Subject) }>
														{ resolveMessageSubject(m.Subject) }
													</span>
													if m.UserID != nil && *m.UserID > 0 {
														<span class="badge badge-indigo" title={ fmt.Sprintf("مستخدم مسجل #%d", *m.UserID) }>مسجل</span>
													}
												</div>
												<p class="inbox-preview">{ messagePreview(m.Message, 96) }</p>
												{{ longMessage := messageLengthLabel(m.Message) }}
												if longMessage != "" {
													<span class="inbox-meta-count">{ longMessage }</span>
												}
											</div>
										</td>
										<td class="text-center">
											<span class={ "badge fw-800", messageStatusClass(m.Status) }>
												{ messageStatusLabel(m.Status) }
											</span>
										</td>
										<td class="tabular-nums text-xs">
											<div class="stack-xs inbox-date">
												<span>{ m.CreatedAt.Format("2006-01-02") }</span>
												<span class="text-muted">{ m.CreatedAt.Format("03:04 PM") }</span>
											</div>
										</td>
										<td class="col-actions">
											<div class="table-actions inbox-actions">
												<button
													type="button"
													class="btn btn-primary btn-sm"
													data-modal-open={ messageModalID(m.ID) }
													title="قراءة الرسالة كاملة"
													aria-label="قراءة الرسالة كاملة"
												>
													@components.IconEye("icon-xs")
												</button>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/messages/%d/toggle", m.ID)) } class="m-0">
													<input type="hidden" name="status" value={ messageToggleTarget(m.Status) }/>
													<button
														type="submit"
														class="btn btn-secondary btn-sm"
														title={ messageToggleLabel(m.Status) }
														aria-label={ messageToggleLabel(m.Status) }
													>
														if isUnreadMessage(m.Status) {
															@components.IconCheck("icon-xs")
														} else {
															@components.IconRotateCcw("icon-xs")
														}
													</button>
												</form>
												<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/messages/%d/delete", m.ID)) } class="m-0">
													<button
														type="submit"
														class="btn btn-secondary btn-sm text-danger"
														data-confirm="هل أنت متأكد من حذف هذه الرسالة؟ لا يمكن التراجع عن الحذف."
														title="حذف الرسالة"
														aria-label="حذف الرسالة"
													>
														@components.IconTrash("icon-xs")
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if totalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: page,
							PageSize:    perPage,
							TotalCount:  totalCount,
							BaseURL:     "/admin/messages",
						})
					}
				}
			</div>

			for _, m := range messages {
				@AdminMessageModal(m)
			}
		</div>
	}
}

// messageLengthLabel warns that the preview is hiding text. It returns nothing
// for a message the preview already shows in full: "رسالة قصيرة" beside a
// one-line inquiry is noise, and a label that appears on every row is not a
// signal.
func messageLengthLabel(body string) string {
	if len(strings.Fields(body)) < 25 {
		return ""
	}
	return "رسالة طويلة"
}
