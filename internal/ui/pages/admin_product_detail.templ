package pages

import (
	"fmt"
	"net/url"

	"github.com/muhiya/dawa24-store/internal/modules/catalog"
	"github.com/muhiya/dawa24-store/internal/shared/money"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/imageurl"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

func formatVariantDiscount(price, discount money.Amount) string {
	if !discount.IsPositive() {
		return "0%"
	}
	pct := float64(discount.Minor()) / 100.0
	if pct == float64(int(pct)) {
		return fmt.Sprintf("%.0f%%", pct)
	}
	return fmt.Sprintf("%.2f%%", pct)
}

func resolveProductImage(p *catalog.Product) string {
	if p == nil {
		return ""
	}
	if p.Image != "" {
		return p.Image
	}
	return p.ImageLink
}

// AdminProductDetailPage renders master product view with full specifications and supplier offerings.
templ AdminProductDetailPage(p *catalog.Product, variants []*catalog.ProductVariant, orgNames map[int64]string, branchNames map[int64]string, warehouseNames map[int64]string, lang, dir string) {
	@layouts.AdminShell(fmt.Sprintf("تفاصيل الصنف: %s", p.Name.Get("ar")), "products", lang, dir) {
		<div class="page-container max-w-6xl mx-auto">
			
			<!-- Breadcrumb Navigation -->
			<nav class="d-flex items-center gap-2 text-xs text-muted mb-4 flex-wrap font-bold" aria-label="مسار التنقل">
				<a href="/admin/dashboard" class="text-secondary hover:text-primary transition-colors">لوحة الإدارة</a>
				<span>/</span>
				<a href="/admin/products" class="text-secondary hover:text-primary transition-colors">قائمة الأصناف والمنتجات</a>
				<span>/</span>
				<span class="text-primary font-black">{ p.Name.Get("ar") }</span>
			</nav>

			<!-- B2B E-Commerce Showcase (Image on Right in RTL, Specifications on Left) -->
			<div class="b2b-product-showcase grid grid-cols-1 lg:grid-cols-12 gap-6 items-start mb-6">
				
				<!-- Right Column (in RTL): Fixed Product Image Showcase -->
				<div class="b2b-product-gallery lg:col-span-4 xl:col-span-4 sticky top-6">
					<div class="b2b-product-media-card glass-panel p-4 min-h-[340px] md:min-h-[380px] relative group">
						if resolveProductImage(p) != "" {
							<a
								href={ templ.SafeURL(imageurl.Normalize(resolveProductImage(p))) }
								data-preview-file={ imageurl.Normalize(resolveProductImage(p)) }
								data-is-image="true"
								data-title={ p.Name.Get("ar") }
								target="_blank"
								class="w-full h-full flex flex-col items-center justify-center cursor-zoom-in relative group/img"
								title="عرض الصورة بالحجم الكامل"
							>
								@components.ProductImage(imageurl.Full(resolveProductImage(p), p.Name.Get("ar"), "b2b-product-img object-contain transition-transform duration-300 group-hover/img:scale-105"))
								<div class="product-img-fallback hidden w-full h-full flex-col items-center justify-center text-muted gap-2 pointer-events-none">
									<span class="text-4xl">@components.IconPill("icon-lg text-slate-300")</span>
									<span class="text-2xs font-bold text-slate-400">لا توجد صورة</span>
								</div>
								<span class="absolute bottom-2 end-2 badge badge-slate text-2xs font-bold gap-1 shadow-xs opacity-80 group-hover/img:opacity-100 transition-opacity pointer-events-none">
									@components.IconSearch("icon-2xs")
									<span>تكبير</span>
								</span>
							</a>
						} else {
							<div class="d-flex flex-col items-center justify-center text-muted gap-2 my-auto">
								<span class="text-5xl">@components.IconPill("icon-xl text-slate-300")</span>
								<span class="text-xs font-bold text-slate-400">لا توجد صورة</span>
							</div>
						}
					</div>

					<!-- Quality & Standard Signals Under Image -->
					<div class="b2b-trust-badges">
						<div class="d-flex items-center gap-2 text-primary font-bold">
							@components.IconShield("icon-2xs text-brand")
							<span>صنف قياسي بالكتالوج الموحد</span>
						</div>
						<div class="d-flex items-center gap-2 text-muted">
							@components.IconCheckCircle("icon-2xs text-emerald")
							<span>مطابق لمواصفات هيئة الدواء (EDA)</span>
						</div>
					</div>
				</div>

				<!-- Left Column (in RTL): Clinical Details, Master Specs & Operations -->
				<div class="b2b-product-info-panel lg:col-span-8 xl:col-span-8">
					<!-- Brand & Title Block -->
					<div>
						<div class="d-flex items-center gap-2 mb-2 flex-wrap">
							if p.ManufacturingCompanies != "" {
								<span class="badge badge-slate text-xs font-bold gap-1">
									@components.IconBuilding("icon-2xs")
									<span>{ p.ManufacturingCompanies }</span>
								</span>
							}
							if p.DosageForm != "" {
								<span class="badge badge-sky text-xs font-bold">
									{ p.DosageForm }
								</span>
							}
							if p.Status == catalog.StatusActive {
								<span class="badge badge-emerald text-xs font-bold">نشط ومتاح في السوق</span>
							} else {
								<span class="badge badge-rose text-xs font-bold">موقوف / معطل</span>
							}
						</div>

						<h1 class="text-2xl lg:text-3xl font-black text-primary m-0 mb-1 leading-tight">
							{ p.Name.Get("ar") }
						</h1>

						if p.Name.Get("en") != "" {
							<div class="text-sm text-secondary font-medium mb-3 font-mono" dir="ltr">
								{ p.Name.Get("en") }
							</div>
						}

						<div class="d-flex items-center gap-3 flex-wrap text-xs text-muted pt-2 border-t">
							if p.SKU != "" {
								<span>SKU: <strong class="text-primary tabular-nums font-mono">{ p.SKU }</strong></span>
								<span>•</span>
							}
							if p.Barcode != "" {
								<span>باركود: <strong class="text-primary tabular-nums font-mono">{ p.Barcode }</strong></span>
								<span>•</span>
							}
							<span class="tabular-nums font-mono">معرف النظام: #{ fmt.Sprintf("%d", p.ID) }</span>
						</div>
					</div>

					<!-- Official Pricing & Market Metrics Banner -->
					<div class="b2b-pricing-banner">
						<div class="stack-2xs">
							<div class="text-2xs text-muted font-bold">سعر الجمهور الرسمي</div>
							<div class="d-flex items-baseline gap-1">
								<span class="text-3xl font-black text-primary tabular-nums">{ p.Price.String() }</span>
								<span class="text-xs font-bold text-secondary">ج.م</span>
							</div>
						</div>
						<div class="d-flex items-center gap-4 flex-wrap text-xs">
							<div class="stack-2xs text-center border-s ps-4">
								<span class="text-2xs text-muted font-bold">عروض التوريد النشطة</span>
								<strong class="text-brand tabular-nums font-black text-lg">{ fmt.Sprintf("%d", len(variants)) }</strong>
							</div>
							<div class="stack-2xs text-center border-s ps-4">
								<span class="text-2xs text-muted font-bold">مرات الطلب والبيع</span>
								<strong class="text-emerald tabular-nums font-black text-lg">{ fmt.Sprintf("%d", p.SoldTimes) }</strong>
							</div>
						</div>
					</div>

					<!-- Master Clinical Specifications Table -->
					<div class="pt-2">
						<h2 class="text-xs font-extrabold text-muted uppercase tracking-wider mb-2">
							المواصفات والبيانات الدوائية القياسية
						</h2>
						<table class="b2b-specs-table">
							<tbody>
								<tr>
									<th>الاسم العلمي (Scientific Name)</th>
									<td>
										if p.ScientificName != "" {
											<span class="font-mono">{ p.ScientificName }</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>
								</tr>
								<tr>
									<th>المادة الفعالة (Active Ingredient)</th>
									<td>
										if p.Active != "" {
											<span>{ p.Active }</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>
								</tr>
								<tr>
									<th>الشكل الصيدلي (Dosage Form)</th>
									<td>
										if p.DosageForm != "" {
											<span>{ p.DosageForm }</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>
								</tr>
								<tr>
									<th>التركيز الدوائي (Concentration)</th>
									<td>
										if p.Concentration != "" {
											<span>{ p.Concentration }</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>
								</tr>
								<tr>
									<th>وحدة التعبئة (Packaging Unit)</th>
									<td>
										if p.Unit != "" {
											<span>{ p.Unit }</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>
								</tr>
								<tr>
									<th>التصنيف الدوائي (Pharmacology)</th>
									<td>
										if p.Pharmacology != "" {
											<span>{ p.Pharmacology }</span>
										} else {
											<span class="text-muted">—</span>
										}
									</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Description & Clinical Indications -->
					if p.Description.Get("ar") != "" || p.Description.Get("en") != "" {
						<div class="pt-2 border-t">
							<div class="text-xs font-bold text-muted mb-1.5">الوصف ودواعي الاستعمال:</div>
							<div class="text-xs text-primary leading-relaxed">
								if p.Description.Get("ar") != "" {
									{ p.Description.Get("ar") }
								} else {
									{ p.Description.Get("en") }
								}
							</div>
						</div>
					}

					<!-- Action Buttons -->
					<div class="d-flex items-center gap-3 pt-3 border-t flex-wrap">
						<a href={ templ.SafeURL(fmt.Sprintf("/catalog?q=%s", url.QueryEscape(p.Name.Get("ar")))) } target="_blank" class="btn btn-primary btn-sm font-bold text-xs">
							@components.IconExternalLink("icon-xs")
							<span>عرض في الكتالوج العام</span>
						</a>
						<a href="/admin/products" class="btn btn-secondary btn-sm font-bold text-xs">
							@components.IconArrowRight("icon-xs")
							<span>العودة لقائمة المنتجات</span>
						</a>
					</div>
				</div>

			</div>

			<!-- Linked Vendor Offers / Variants -->
			<div class="glass-panel p-0 mb-6 overflow-hidden">
				<div class="p-4 border-b flex-between items-center flex-wrap gap-2">
					<div class="d-flex items-center gap-2">
						<span class="text-lg">@components.IconBuilding("icon-sm")</span>
						<h3 class="text-base font-black text-primary m-0">
							عروض التوريد المسجلة من الموردين لهذا الصنف ({ fmt.Sprintf("%d", len(variants)) })
						</h3>
					</div>
				</div>

				if len(variants) == 0 {
					<div class="p-8 text-center empty-state-glass">
						<div class="text-3xl mb-2">@components.IconPackage("icon-sm")</div>
						<h4 class="text-base font-bold text-primary mb-1">لا توجد عروض توريد مسجلة حالياً</h4>
						<p class="text-xs text-secondary max-w-md mx-auto">لم يقم أي مورد بإدراج كميات أو عروض أسعار لهذا الصنف الدوائي بعد.</p>
					</div>
				} else {
					<div class="table-container m-0">
						<table class="data-table data-table-responsive m-0">
							<thead>
								<tr>
									<th>اسم العرض / التشغيلة</th>
									<th>المورد والمنشأة</th>
									<th>المخزن والفرع</th>
									<th class="text-center">سعر البيع</th>
									<th class="text-center">الخصم</th>
									<th class="text-center">الكمية المتوفرة</th>
									<th class="text-center">الصلاحية</th>
									<th class="text-center">الحالة</th>
								</tr>
							</thead>
							<tbody>
								for _, v := range variants {
									<tr>
										<td>
											<div class="font-bold text-xs text-primary">
												if v.Name.Get("ar") != "" {
													{ v.Name.Get("ar") }
												} else {
													<span>{ p.Name.Get("ar") }</span>
												}
											</div>
											if v.BatchNumber != "" {
												<div class="text-2xs text-muted font-mono">تشغيلة: { v.BatchNumber }</div>
											}
											if v.SKU != "" {
												<div class="text-2xs text-muted font-mono" dir="ltr"><code>{ v.SKU }</code></div>
											}
										</td>
										<td>
											if name, ok := orgNames[v.OrganizationID]; ok && name != "" {
												<a href={ templ.SafeURL(fmt.Sprintf("/admin/organizations/%d", v.OrganizationID)) } class="font-bold text-xs text-primary hover:underline block">
													{ name }
												</a>
												<span class="badge badge-purple text-2xs font-mono font-bold">#{ fmt.Sprintf("ORG-%d", v.OrganizationID) }</span>
											} else {
												<span class="badge badge-sky text-xs font-mono">منشأة #{ fmt.Sprintf("%d", v.OrganizationID) }</span>
											}
										</td>
										<td>
											if whName, ok := warehouseNames[v.ID]; ok && whName != "" {
												<div class="font-bold text-xs text-primary">{ whName }</div>
											}
											if brName, ok := branchNames[v.ID]; ok && brName != "" {
												<div class="text-2xs text-secondary mt-0.5">فرع: { brName }</div>
											} else if v.BranchID != nil && *v.BranchID > 0 {
												<div class="text-2xs text-muted mt-0.5">فرع #{ fmt.Sprintf("%d", *v.BranchID) }</div>
											} else if _, ok := warehouseNames[v.ID]; !ok {
												<span class="text-muted text-2xs">المستودع الرئيسي</span>
											}
										</td>
										<td class="tabular-nums font-bold text-xs text-primary text-center">
											{ v.Price.String() } ج.م
										</td>
										<td class="tabular-nums font-bold text-xs text-brand text-center">
											{ formatVariantDiscount(v.Price, v.Discount) }
										</td>
										<td class="tabular-nums text-center">
											if v.StockQty > 10 {
												<span class="badge badge-emerald text-xs font-bold">{ fmt.Sprintf("%d وحدة", v.StockQty) }</span>
											} else if v.StockQty > 0 {
												<span class="badge badge-amber text-xs font-bold">{ fmt.Sprintf("%d وحدة", v.StockQty) }</span>
											} else {
												<span class="badge badge-rose text-xs font-bold">0 وحدة (نافد)</span>
											}
										</td>
										<td class="text-xs text-muted tabular-nums text-center">
											if v.ExpiryDate != nil {
												{ v.ExpiryDate.Format("2006-01-02") }
											} else {
												<span class="text-muted">—</span>
											}
										</td>
										<td class="text-center">
											if string(v.Status) == "active" {
												<span class="badge badge-emerald text-xs">نشط</span>
											} else {
												<span class="badge badge-slate text-xs">معطل</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

		</div>
	}
}
