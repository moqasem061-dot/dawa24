package pages

import (
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

// OrganizationDocumentsModals renders the in-app document viewer and replacement modals.
templ OrganizationDocumentsModals() {
	<!-- Dynamic In-App Document Viewer Modal (PDF + Image Responsive) -->
	@components.Modal(components.ModalProps{
		ID:       "doc-viewer-modal",
		Title:    "معاينة المستند الرسمي",
		Subtitle: "مستند رقمي مشفر ومحمي لمنشأتك فقط",
		Size:     "xl",
	}) {
		<div class="stack-md">
			<!-- Modal Sub-header Actions -->
			<div class="flex-between items-center flex-wrap gap-3 pb-3 border-b">
				<div class="stack-2xs">
					<div class="text-sm font-bold text-primary" id="modal-doc-title">
						معاينة المستند
					</div>
					<div class="text-xs text-muted font-mono" id="modal-doc-filename" dir="ltr">
						filename.pdf
					</div>
				</div>

				<div class="d-flex items-center gap-2">
					<a
						id="modal-doc-tab"
						href="/documents"
						target="_blank"
						rel="noopener noreferrer"
						data-no-boost="true"
						class="btn btn-secondary btn-sm font-bold gap-1"
					>
						@components.IconExternalLink("icon-xs")
						<span>فتح في نافذة جديدة ↗</span>
					</a>
					<a
						id="modal-doc-download-btn"
						href="/documents"
						class="btn btn-primary btn-sm font-bold gap-1"
					>
						@components.IconDownload("icon-xs")
						<span>تحميل الملف</span>
					</a>
				</div>
			</div>

			<!-- Dynamic Interactive Viewer Viewport -->
			<div class="doc-viewer-viewport" id="modal-doc-viewport">
				<!-- Loading State Spinner -->
				<div id="modal-doc-loader" class="doc-viewer-loader">
					<span class="spinner"></span>
					<span class="text-xs font-bold">جاري تحميل المستند...</span>
				</div>

				<!-- Mode 1: PDF / Document Viewer Iframe -->
				<iframe
					id="modal-doc-iframe"
					src="about:blank"
					class="doc-viewer-iframe hidden"
				></iframe>

				<!-- Mode 2: Image Viewer -->
				<div id="modal-doc-img-container" class="doc-viewer-img-container hidden">
					<img
						id="modal-doc-img"
						src=""
						alt="معاينة المستند"
						class="doc-viewer-img"
					/>
				</div>

				<!-- Error Fallback State -->
				<div id="modal-doc-error" class="doc-viewer-error hidden">
					<div class="text-danger mb-2">
						@components.IconAlert("icon-lg mx-auto")
					</div>
					<p class="text-sm font-bold text-primary m-0">تعذر عرض معاينة هذا المستند مباشرة</p>
					<p class="text-xs text-muted m-0">يمكنك استخدام زر "فتح في نافذة جديدة" أو زر "تحميل الملف" لمعاينة المستند على جهازك.</p>
					<div class="d-flex justify-center gap-2 mt-3 flex-wrap">
						<a id="modal-doc-error-newtab" href="#" target="_blank" rel="noopener noreferrer" data-no-boost="true" class="btn btn-secondary btn-sm font-bold gap-1">
							@components.IconExternalLink("icon-xs")
							<span>فتح في نافذة جديدة ↗</span>
						</a>
						<a id="modal-doc-error-download" href="#" class="btn btn-primary btn-sm font-bold gap-1">
							@components.IconDownload("icon-xs")
							<span>تحميل المستند</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Modal Footer -->
			<div class="modal-footer pt-3 border-t flex-between items-center">
				<span class="text-xs text-muted">مستند رقمي مشفر ومحمي لمنشأتك فقط</span>
				<button
					type="button"
					class="btn btn-secondary font-bold"
					data-on-click="closeDocViewer()"
				>
					إغلاق المعاينة
				</button>
			</div>
		</div>
	}

	<!-- Modal: Replace Document Modal with Replacement Reason -->
	@components.Modal(components.ModalProps{
		ID:       "replace-doc-modal",
		Title:    "استبدال وتحديث المستند",
		Subtitle: "رفع نسخة جديدة مع توضيح سبب الاستبدال لإدارة المنصة",
		Size:     "md",
	}) {
		<form class="stack-md" action="/documents/upload" method="POST" enctype="multipart/form-data" data-boost-upload>
			<input type="hidden" name="document_type" id="replace-doc-type" value="" />
			<input type="hidden" name="existing_doc_id" id="replace-existing-id" value="" />

			<!-- Current File Info Box -->
			<div class="p-3 bg-surface-sunken rounded-xl border">
				<span class="text-xs text-muted font-bold d-block mb-1">الملف الحالي المسجل:</span>
				<span id="replace-modal-current-file" class="font-mono text-sm font-bold text-primary" dir="ltr">file.pdf</span>
			</div>

			<!-- New File Upload Field -->
			<div class="form-group m-0">
				<label class="form-label text-xs font-bold">
					اختر ملف المستند الجديد <span class="text-danger">*</span>
				</label>
				<input
					type="file"
					name="file"
					required
					accept=".pdf,.png,.jpg,.jpeg,.webp"
					class="form-input text-xs"
				/>
				<span class="text-xs text-muted mt-1 d-block">
					الصيغ المقبولة: PDF أو صور (PNG, JPG, WebP) بحجم أقصى 20 ميجابايت.
				</span>
			</div>

			<!-- Replacement Reason Field -->
			<div class="form-group m-0">
				<label class="form-label text-xs font-bold">
					سبب استبدال / تحديث المستند <span class="text-danger">*</span>
				</label>
				<textarea
					name="replacement_reason"
					id="replace-doc-reason"
					required
					rows="3"
					class="form-input text-sm"
					placeholder="يرجى توضيح سبب الاستبدال لإدارة المنصة (مثال: تجديد ترخيص المنشأة السنوي، تصحيح خطأ بالصورة السابقة، صدور سجل تجاري محدث...)"
				></textarea>
			</div>

			<!-- Footer Actions -->
			<div class="modal-footer pt-3 border-t flex-between items-center">
				<button
					type="button"
					class="btn btn-secondary font-bold"
					data-on-click="closeReplaceDocModal()"
				>
					إلغاء
				</button>
				<button
					type="submit"
					class="btn btn-primary font-bold px-6"
				>
					<span>تأكيد واستبدال المستند</span>
				</button>
			</div>
		</form>
	}

	<!-- Viewer & Replace Modal Logic Scripts -->
	<script nonce={ layouts.Nonce(ctx) }>
		function openDocViewerFromBtn(btn) {
			if (!btn) return;
			const docId = btn.getAttribute('data-doc-id');
			const title = btn.getAttribute('data-title') || '';
			const docType = btn.getAttribute('data-doctype') || '';
			const name = btn.getAttribute('data-name') || '';
			const status = btn.getAttribute('data-status') || '';
			const url = btn.getAttribute('data-url') || '';
			openDocViewer(docId, title, docType, name, status, url);
		}

		function openReplaceDocModalFromBtn(btn) {
			if (!btn) return;
			const docId = btn.getAttribute('data-doc-id');
			const docType = btn.getAttribute('data-doctype') || '';
			const title = btn.getAttribute('data-title') || '';
			const name = btn.getAttribute('data-name') || '';
			openReplaceDocModal(docId, docType, title, name);
		}

		function openDocViewer(docId, title, docType, originalName, status, rawUrl) {
			let viewUrl = '/documents/' + docId + '/view';
			let downloadUrl = '/documents/' + docId + '/download';
			const path = window.location.pathname || '';
			if (path.startsWith('/vendor/documents')) {
				viewUrl = '/vendor/documents/' + docId + '/view';
				downloadUrl = '/vendor/documents/' + docId + '/download';
			} else if (path.startsWith('/customer/documents')) {
				viewUrl = '/customer/documents/' + docId + '/view';
				downloadUrl = '/customer/documents/' + docId + '/download';
			}

			const titleEl = document.getElementById('modal-doc-title');
			const filenameEl = document.getElementById('modal-doc-filename');
			const tabBtn = document.getElementById('modal-doc-tab');
			const downloadBtn = document.getElementById('modal-doc-download-btn');
			const iframe = document.getElementById('modal-doc-iframe');
			const imgContainer = document.getElementById('modal-doc-img-container');
			const img = document.getElementById('modal-doc-img');
			const loader = document.getElementById('modal-doc-loader');
			const errBox = document.getElementById('modal-doc-error');
			const errNewTab = document.getElementById('modal-doc-error-newtab');
			const errDownload = document.getElementById('modal-doc-error-download');
			const modal = document.getElementById('doc-viewer-modal');

			if (titleEl) titleEl.textContent = title || 'معاينة المستند';
			if (filenameEl) filenameEl.textContent = originalName || ('Document #' + docId);
			if (tabBtn) tabBtn.href = viewUrl;
			if (downloadBtn) downloadBtn.href = downloadUrl;
			if (errNewTab) errNewTab.href = viewUrl;
			if (errDownload) errDownload.href = downloadUrl;

			// Sniff image-vs-PDF from the original filename first, then the stored URL
			const sniffSrc = ((originalName || '') !== '' ? originalName : (rawUrl || '')).split('?')[0];
			const ext = (sniffSrc.split('.').pop() || '').toLowerCase();
			const isImage = ['png', 'jpg', 'jpeg', 'webp', 'svg', 'gif'].includes(ext);

			if (errBox) errBox.classList.add('hidden');
			if (loader) loader.classList.remove('hidden');

			if (isImage) {
				if (iframe) {
					iframe.classList.add('hidden');
					iframe.src = 'about:blank';
				}
				if (img && imgContainer) {
					imgContainer.classList.add('hidden');
					img.onload = function () {
						if (loader) loader.classList.add('hidden');
						if (errBox) errBox.classList.add('hidden');
						imgContainer.classList.remove('hidden');
					};
					img.onerror = function () {
						if (loader) loader.classList.add('hidden');
						imgContainer.classList.add('hidden');
						// Fallback to iframe so DocumentUnavailablePage or browser handler renders
						if (iframe) {
							iframe.src = viewUrl;
							iframe.classList.remove('hidden');
						} else if (errBox) {
							errBox.classList.remove('hidden');
						}
					};
					img.src = viewUrl;
				}
			} else {
				if (imgContainer) imgContainer.classList.add('hidden');
				if (img) img.src = '';
				if (iframe) {
					iframe.onload = function () {
						if (loader) loader.classList.add('hidden');
					};
					iframe.onerror = function () {
						if (loader) loader.classList.add('hidden');
						iframe.classList.add('hidden');
						if (errBox) errBox.classList.remove('hidden');
					};
					iframe.src = viewUrl;
					iframe.classList.remove('hidden');
				}
			}

			if (modal) {
				if (typeof modal.showModal === 'function') modal.showModal();
				else modal.setAttribute('open', '');
			}
		}

		function closeDocViewer() {
			const modal = document.getElementById('doc-viewer-modal');
			const iframe = document.getElementById('modal-doc-iframe');
			const img = document.getElementById('modal-doc-img');
			const imgContainer = document.getElementById('modal-doc-img-container');
			const loader = document.getElementById('modal-doc-loader');
			const errBox = document.getElementById('modal-doc-error');
			if (modal) {
				if (typeof modal.close === 'function') modal.close();
				else modal.removeAttribute('open');
			}
			if (iframe) {
				iframe.src = 'about:blank';
				iframe.classList.add('hidden');
			}
			if (img) img.src = '';
			if (imgContainer) imgContainer.classList.add('hidden');
			if (loader) loader.classList.add('hidden');
			if (errBox) errBox.classList.add('hidden');
		}

		function openReplaceDocModal(docId, docType, titleAr, origName) {
			const modal = document.getElementById('replace-doc-modal');
			const titleEl = document.getElementById('replace-modal-title');
			const currFileEl = document.getElementById('replace-modal-current-file');
			const docTypeInput = document.getElementById('replace-doc-type');
			const existingIdInput = document.getElementById('replace-existing-id');
			const reasonInput = document.getElementById('replace-doc-reason');

			if (titleEl) titleEl.textContent = 'استبدال مستند: ' + (titleAr || '');
			if (currFileEl) currFileEl.textContent = origName || ('مستند #' + docId);
			if (docTypeInput) docTypeInput.value = docType || '';
			if (existingIdInput) existingIdInput.value = docId || '';
			if (reasonInput) reasonInput.value = '';

			if (modal) {
				if (typeof modal.showModal === 'function') modal.showModal();
				else modal.setAttribute('open', '');
			}
		}

		function closeReplaceDocModal() {
			const modal = document.getElementById('replace-doc-modal');
			if (modal) {
				if (typeof modal.close === 'function') modal.close();
				else modal.removeAttribute('open');
			}
		}

		document.addEventListener('DOMContentLoaded', function () {
			const modal = document.getElementById('doc-viewer-modal');
			if (modal) {
				modal.addEventListener('click', function (e) {
					if (e.target === modal) {
						closeDocViewer();
					}
				});
				modal.addEventListener('cancel', function () {
					closeDocViewer();
				});
			}
		});
	</script>
}