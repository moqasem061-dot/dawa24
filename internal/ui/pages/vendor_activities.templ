package pages

import (
	"fmt"
	"strings"

	platformadmin "github.com/moqasem061-dot/dawa24/internal/modules/platform_admin"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

func formatShortID(id string) string {
	if len(id) > 12 {
		return id[:8] + "…"
	}
	return id
}

// VendorActivitiesPage renders activity history for the vendor's team.
templ VendorActivitiesPage(entries []*platformadmin.AuditEntry, lang, dir string, page, perPage, totalCount int) {
	@layouts.VendorShell(i18n.T(lang, "activities.page_title"), "activities", lang, dir) {
		@tenantActivitiesBody(entries, "vendor", lang, dir, page, perPage, totalCount)
	}
}

// CustomerActivitiesPage renders activity history for the pharmacy team.
templ CustomerActivitiesPage(entries []*platformadmin.AuditEntry, lang, dir string, page, perPage, totalCount int) {
	@layouts.CustomerShell(i18n.T(lang, "activities.page_title"), "activities", lang, dir, nil) {
		@tenantActivitiesBody(entries, "customer", lang, dir, page, perPage, totalCount)
	}
}

templ tenantActivitiesBody(entries []*platformadmin.AuditEntry, orgType string, lang, dir string, page, perPage, totalCount int) {
	<div class="page-container" x-data="{ search: '', selectedEntry: null, isDetailsOpen: false }">
		
		<!-- Header & Action Summary -->
		<div class="glass-panel p-6 mb-6 border border-slate-200/80 rounded-2xl shadow-sm">
			<div class="flex-between items-start flex-wrap gap-4">
				<div class="stack-sm">
					<div class="d-flex items-center gap-3 mb-1">
						<div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 d-flex items-center justify-center border border-brand-200/60 shadow-2xs">
							@components.IconClock("icon-sm")
						</div>
						<h1 class="text-2xl font-black text-primary m-0">
							if orgType == "vendor" {
								{ i18n.T(lang, "activities.header_vendor") }
							} else {
								{ i18n.T(lang, "activities.header_customer") }
							}
						</h1>
					</div>
					<p class="text-xs text-secondary m-0 font-medium">
						{ i18n.T(lang, "activities.desc") }
					</p>
				</div>

				<div class="d-flex items-center">
					<span class="badge badge-sky text-xs font-extrabold px-3.5 py-2 shadow-2xs tabular-nums">
						{ fmt.Sprintf(i18n.T(lang, "activities.total_count"), totalCount) }
					</span>
				</div>
			</div>

			<!-- Quick Filter Search -->
			<div class="mt-4 pt-3 border-t border-slate-100">
				<input
					type="search"
					x-model="search"
					placeholder={ i18n.T(lang, "activities.search_placeholder") }
					class="form-input text-xs font-medium"
				/>
			</div>
		</div>

		if len(entries) == 0 {
			<div class="glass-panel p-8 text-center empty-state-glass border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 d-flex items-center justify-center mx-auto mb-3 text-2xl">
					@components.IconClock("icon-sm")
				</div>
				<h3 class="text-lg font-black text-primary mb-2">{ i18n.T(lang, "activities.empty_title") }</h3>
				<p class="text-xs text-secondary max-w-md mx-auto">{ i18n.T(lang, "activities.empty_desc") }</p>
			</div>
		} else {
			<div class="glass-panel p-0 mb-6 overflow-hidden border border-slate-200/80 rounded-2xl shadow-xs">
				<div class="table-container m-0 overflow-x-auto">
					<table class="data-table m-0 text-xs w-full">
						<thead>
							<tr class="bg-slate-50/80 border-b border-slate-200/70 text-slate-700 font-bold">
								<th class="py-3 text-start ps-4">{ i18n.T(lang, "activities.col_actor") }</th>
								<th class="py-3 text-start">{ i18n.T(lang, "activities.col_action") }</th>
								<th class="py-3 text-start">{ i18n.T(lang, "activities.col_entity") }</th>
								<th class="py-3 text-start">{ i18n.T(lang, "activities.col_id") }</th>
								<th class="text-center py-3">{ i18n.T(lang, "activities.col_ip") }</th>
								<th class="py-3 text-end">{ i18n.T(lang, "activities.col_date") }</th>
								<th class="col-actions py-3 pe-4 text-center">{ i18n.T(lang, "activities.col_actions") }</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, e := range entries {
								{{ presentation := tenantActivity(e, lang); actionLabel, badgeClass := presentation.Action, badgeClassForAction(e.Action) }}
								<tr
									class="transition-colors"
									data-search={ strings.Join([]string{e.ActorName, actionLabel, presentation.Entity, e.EntityID}, " ") }
x-show="search === '' || $el.dataset.search.toLowerCase().includes(search.toLowerCase())"
								>
									<!-- Actor Info -->
									<td class="py-3 ps-4">
										<div class="d-flex items-center gap-2">
											<div class="user-avatar-badge text-xs font-black">
												if len(e.ActorName) > 0 {
													{ string([]rune(e.ActorName)[0]) }
												} else {
													م
												}
											</div>
											<div class="stack-sm">
												<div class="font-extrabold text-xs text-primary">
													if e.ActorName != "" {
														{ e.ActorName }
													} else {
														{ i18n.T(lang, "activities.default_actor") }
													}
												</div>
												if e.ActorEmail != "" {
													<div class="text-2xs text-muted tabular-nums">
														{ e.ActorEmail }
													</div>
												}
											</div>
										</div>
									</td>

									<!-- Action -->
									<td class="py-3">
										<span class={ "badge text-xs font-bold", badgeClass }>
											{ actionLabel }
										</span>
										<div class="text-xs text-muted mt-1">{ presentation.Outcome }</div>
</td>

									<!-- Entity Type -->
									<td class="py-3">
										<span class="badge badge-slate text-xs font-bold">
											{ presentation.Entity }
										</span>
									</td>

									<!-- Entity ID -->
									<td class="py-3">
										if e.EntityID != "" {
											<code
												class="tabular-nums text-xs bg-surface-sunken border border-slate-200/80 px-1.5 py-0.5 rounded font-mono font-bold"
												title={ e.EntityID }
											>
												{ formatShortID(e.EntityID) }
											</code>
										} else {
											<span class="text-xs text-muted">—</span>
										}
									</td>

									<!-- IP Address -->
									<td class="text-center tabular-nums text-xs font-mono text-secondary py-3">
										if e.IPAddress != "" {
											{ e.IPAddress }
										} else {
											<span class="text-muted">{ i18n.T(lang, "activities.ip_internal") }</span>
										}
									</td>

									<!-- Timestamp -->
									<td class="text-end tabular-nums text-xs text-secondary font-bold py-3">
										{ e.CreatedAt.Format("2006-01-02 15:04:05") }
									</td>

									<!-- Actions -->
									<td class="col-actions pe-4 text-center">
										<button
											type="button"
											class="btn btn-secondary btn-xs font-bold gap-1 shadow-2xs"
											@click={ fmt.Sprintf("[selectedEntry = %s, isDetailsOpen = true, $dispatch('open-modal', 'tenant-audit-details-modal')]", func() string { s, _ := templ.JSONString(presentation); return s }()) }
										>
											@components.IconEye("icon-2xs")
											<span>{ i18n.T(lang, "activities.btn_details") }</span>
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
					</div>
					if totalCount > 0 {
						@components.B2BPagination(components.PaginationProps{
							CurrentPage: page,
							PageSize:    perPage,
							TotalCount:  totalCount,
							BaseURL:     func() string {
								if orgType == "vendor" {
									return "/vendor/activities"
								}
								return "/customer/activities"
							}(),
						})
					}
				</div>
			}

			@components.Modal(components.ModalProps{
 ID: "tenant-audit-details-modal",
 Title: i18n.T(lang, "activity.details"),
 Icon: "clock", Size: "lg", AlpineClose: "isDetailsOpen = false",
}) {
 <template x-if="selectedEntry">
  <div class="stack-md">
   <h3 class="text-base font-bold m-0" x-text="selectedEntry.action"></h3>
   <p class="text-sm text-secondary" x-text="selectedEntry.outcome"></p>
   <dl class="d-grid grid-cols-2 gap-3 text-sm">
    <div><dt>{ i18n.T(lang,"activities.col_actor") }</dt><dd x-text="selectedEntry.actor"></dd></div>
    <div><dt>{ i18n.T(lang,"activities.col_entity") }</dt><dd x-text="selectedEntry.entity"></dd></div>
    <div><dt>{ i18n.T(lang,"activities.col_date") }</dt><dd x-text="selectedEntry.date"></dd></div>
    <div><dt>{ i18n.T(lang,"activities.col_id") }</dt><dd x-text="selectedEntry.id"></dd></div>
   </dl>
   <template x-if="selectedEntry.changes.length === 0">
    <p class="text-sm text-muted">{ i18n.T(lang,"activity.no_changes") }</p>
   </template>
   <template x-for="change in selectedEntry.changes" :key="change.label">
    <div class="border rounded-xl p-3 stack-sm">
     <strong x-text="change.label"></strong>
     <div class="d-grid grid-cols-2 gap-3 text-sm">
      <div><span class="text-muted">{ i18n.T(lang,"activity.before") }</span><p x-text="change.before"></p></div>
      <div><span class="text-muted">{ i18n.T(lang,"activity.after") }</span><p x-text="change.after"></p></div>
     </div>
    </div>
   </template>
  </div>
 </template>
 <div class="modal-footer">
  <button type="button" data-modal-close class="btn btn-secondary">{ i18n.T(lang,"preview.modal.close") }</button>
 </div>
}
</div>
}
