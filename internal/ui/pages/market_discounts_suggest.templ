package pages

import (
	"fmt"
	"strconv"

	"github.com/moqasem061-dot/dawa24/internal/modules/compare"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
)

// MarketSuggestions is the search box's dropdown: the contents of the listbox,
// server-rendered so escaping and bilingual text are handled exactly as on the
// page.
//
// The first option is always "view all results for «q»"; it commits the typed
// text. A suggestion for a catalogue product commits the product filter (all
// warehouse offers for it); a suggestion for an unmatched file name commits that
// name as a text search. failed means the lookup timed out or broke: the dropdown
// still offers "view all" and says why there is nothing else.
//
// Option ids are positional (md-opt-0, md-opt-1, ...) because the page script
// points aria-activedescendant at them; the list is replaced wholesale on every
// response, so they never collide.
templ MarketSuggestions(lang, q string, items []compare.MarketSuggestion, failed bool) {
	<div
		class="md-suggest-item is-all"
		id="md-opt-0"
		role="option"
		aria-selected="false"
		data-md-kind="all"
		data-md-q={ q }
	>
		@components.IconSearch("icon-xs")
		<span class="md-suggest-all-text" dir="auto">{ fmt.Sprintf(i18n.T(lang, "market.suggest.view_all"), q) }</span>
	</div>
	for i, item := range items {
		<div
			class="md-suggest-item"
			id={ fmt.Sprintf("md-opt-%d", i+1) }
			role="option"
			aria-selected="false"
			if item.ProductID != nil {
				data-md-kind="product"
				data-md-product={ strconv.FormatInt(*item.ProductID, 10) }
			} else {
				data-md-kind="text"
			}
			data-md-q={ item.DisplayName(lang) }
		>
			<span class="md-suggest-name" dir="auto">{ item.DisplayName(lang) }</span>
			<span class="md-suggest-meta">
				<span>{ fmt.Sprintf(i18n.T(lang, "market.suggest.offers"), item.Offers) }</span>
				<span>{ fmt.Sprintf(i18n.T(lang, "market.suggest.warehouses"), item.Warehouses) }</span>
				if item.BestDiscount > 0 {
					<span class="md-suggest-best tabular-nums">{ fmt.Sprintf(i18n.T(lang, "market.suggest.best"), formatDiscount(item.BestDiscount)) }</span>
				}
				if item.LowestPrice.Minor() > 0 {
					<span class="tabular-nums">{ fmt.Sprintf(i18n.T(lang, "market.suggest.from_price"), formatDiscountPrice(item.LowestPrice)) }</span>
				}
			</span>
		</div>
	}
	if failed {
		<div class="md-suggest-note is-error" role="presentation" data-md-note="error">{ i18n.T(lang, "market.suggest.error") }</div>
	} else if len(items) == 0 {
		<div class="md-suggest-note" role="presentation" data-md-note="none">{ i18n.T(lang, "market.suggest.none") }</div>
	}
}
