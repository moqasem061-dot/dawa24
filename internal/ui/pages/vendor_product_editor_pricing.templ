package pages

import (
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

templ VendorProductEditorPricing(data VendorVariantEditorData, lang string) {
	<!-- Pricing & Cost Discounts (Unified Standard) -->
	<div class="stack-md">
		<div class="d-flex items-center gap-2">
			<span class="text-brand">@components.IconWallet("icon-xs")</span>
			<span class="font-extrabold text-sm text-primary">{ i18n.T(lang, "vendor_products.pricing_section_title") }</span>
		</div>
		
		<div class="grid-2">
			<div class="stack-sm">
				<label class="form-label font-bold text-primary text-sm" for="add-form-price">
					{ i18n.T(lang, "vendor_products.fld_public_price") } <span class="text-danger">*</span>
				</label>
				<input
					type="number"
					step="0.01"
					min="0.5"
					id="add-form-price"
					name="price"
					value={ data.Form.Price }
					class={ "form-input tabular-nums", templ.KV("is-invalid", data.Errors.Has("price")) }
					placeholder="0.00"
					required
					data-on-input="recalcProfitPreview()"
				/>
				if data.Errors.Has("price") {
					<div class="text-danger text-xs font-bold">{ data.Errors.Get("price") }</div>
				}
				<span class="text-xs text-muted mt-1 d-block">{ i18n.T(lang, "vendor_products.official_public_price_desc") }</span>
			</div>
			<div class="stack-sm">
				<label class="form-label font-bold text-primary text-sm" for="add-form-discount">
					{ i18n.T(lang, "vendor_products.fld_discount_pct") }
				</label>
				<input
					type="number"
					step="0.01"
					min="0"
					max="100"
					id="add-form-discount"
					name="discount"
					value={ data.Form.Discount }
					class={ "form-input tabular-nums", templ.KV("is-invalid", data.Errors.Has("discount")) }
					placeholder="0.0%"
					data-on-input="recalcProfitPreview()"
				/>
				if data.Errors.Has("discount") {
					<div class="text-danger text-xs font-bold">{ data.Errors.Get("discount") }</div>
				}
				<span class="text-xs text-muted mt-1 d-block">{ i18n.T(lang, "vendor_products.pharmacy_discount_desc") }</span>
			</div>
		</div>

		@VendorSalePriceInput(data.Form.DiscountInputType, data.Form.SalePrice, lang)
		if layouts.GetSiteSettings(ctx).EnableCostPricing {
			<div class="grid-2">
				<div class="stack-sm">
					<label class="form-label font-bold text-primary text-sm" for="var-cost">
						{ i18n.T(lang, "vendor_products.fld_cost_price") } <span class="badge badge-slate text-xs">{ i18n.T(lang, "vendor_products.badge_optional") }</span>
					</label>
					<input
						type="number"
						step="0.01"
						min="0"
						id="var-cost"
						name="cost_price"
						value={ data.Form.CostPrice }
						class="form-input tabular-nums"
						placeholder="0.00"
						data-on-input="recalcProfitPreview()"
					/>
					<span class="text-xs text-muted mt-1 d-block">{ i18n.T(lang, "vendor_products.cost_price_desc") }</span>
				</div>
				<div class="stack-sm">
					<label class="form-label font-bold text-primary text-sm" for="var-cost-discount">
						{ i18n.T(lang, "vendor_products.fld_cost_discount") } <span class="badge badge-slate text-xs">{ i18n.T(lang, "vendor_products.badge_optional") }</span>
					</label>
					<input
						type="number"
						step="0.01"
						min="0"
						max="100"
						id="var-cost-discount"
						name="cost_discount_percentage"
						value={ data.Form.CostDiscountPercentage }
						class={ "form-input tabular-nums", templ.KV("is-invalid", data.Errors.Has("cost_discount_percentage")) }
						placeholder="0.0%"
						data-on-input="recalcProfitPreview()"
					/>
					if data.Errors.Has("cost_discount_percentage") {
						<div class="text-danger text-xs font-bold">{ data.Errors.Get("cost_discount_percentage") }</div>
					}
					<span class="text-xs text-muted mt-1 d-block">{ i18n.T(lang, "vendor_products.cost_discount_desc") }</span>
				</div>
			</div>

			<!-- Real-time Profit Preview Strip -->
			<div class="stack-sm" id="profit-calc-preview">
				<div class="stack-sm">
					<div class="text-xs text-muted font-bold">{ i18n.T(lang, "vendor_products.calc_net_selling") }</div>
					<div id="preview-selling-price" class="font-extrabold text-primary tabular-nums mt-1">0.00 { i18n.T(lang, "common.currency_egp") }</div>
				</div>
				<div class="stack-sm">
					<div class="text-xs text-muted font-bold">{ i18n.T(lang, "vendor_products.calc_discounted_cost") }</div>
					<div id="preview-cost-price" class="font-extrabold text-secondary tabular-nums mt-1">0.00 { i18n.T(lang, "common.currency_egp") }</div>
				</div>
				<div class="stack-sm">
					<div class="text-xs text-muted font-bold">{ i18n.T(lang, "vendor_products.calc_net_profit") }</div>
					<div id="preview-net-profit" class="font-black text-success tabular-nums mt-1">0.00 { i18n.T(lang, "common.currency_egp") }</div>
				</div>
				<div class="stack-sm">
					<div class="text-xs text-muted font-bold">{ i18n.T(lang, "vendor_products.calc_expected_margin") }</div>
					<div id="preview-profit-margin" class="font-black text-brand tabular-nums mt-1">0.0%</div>
				</div>
			</div>
		} else {
			<!-- Single Net Selling Price Preview -->
			<div class="stack-sm" id="profit-calc-preview">
				<div class="stack-sm">
					<div class="text-xs text-muted font-bold">{ i18n.T(lang, "vendor_products.calc_net_selling") }</div>
					<div id="preview-selling-price" class="font-extrabold text-primary tabular-nums mt-1">0.00 { i18n.T(lang, "common.currency_egp") }</div>
				</div>
			</div>
		}
	</div>

	<script nonce={ layouts.Nonce(ctx) } data-currency={ i18n.T(lang, "common.currency_egp") } data-no-cost={ i18n.T(lang, "vendor_products.no_cost") }>
		function vendorPreviewMinor(id) {
			const raw = document.getElementById(id)?.value || '';
			if (!/^\d+(\.\d{1,2})?$/.test(raw)) return 0n;
			const parts = raw.split('.');
			return BigInt(parts[0]) * 100n + BigInt(((parts[1] || '') + '00').slice(0, 2));
		}
		function vendorPreviewRound(numerator, denominator) {
			const negative = numerator < 0n;
			const absolute = negative ? -numerator : numerator;
			const rounded = (absolute + denominator / 2n) / denominator;
			return negative ? -rounded : rounded;
		}
		function vendorPreviewDecimal(minor) {
			const absolute = minor < 0n ? -minor : minor;
			return (minor < 0n ? '-' : '') + String(absolute / 100n) + '.' + String(absolute % 100n).padStart(2, '0');
		}
		function recalcProfitPreview() {
			const price = vendorPreviewMinor('add-form-price');
			const discount = vendorPreviewMinor('add-form-discount');
			const cost = vendorPreviewMinor('var-cost');
			const costDiscount = vendorPreviewMinor('var-cost-discount');
			const scriptEl = document.querySelector('script[data-currency]');
			const currency = scriptEl?.dataset.currency || '';
			const noCostText = scriptEl?.dataset.noCost || '';
			const sellingPrice = vendorPreviewRound(price * (10000n - discount), 10000n);
			const costBase = costDiscount > 0n ? price : cost;
			const discountedCost = costBase - vendorPreviewRound(costBase * costDiscount, 10000n);
			const profit = sellingPrice - discountedCost;
			const margin = price > 0n ? vendorPreviewRound(profit * 10000n, price) : 0n;
			const amounts = { 'preview-selling-price': sellingPrice, 'preview-net-profit': profit };
			Object.entries(amounts).forEach(([id, amount]) => {
				const element = document.getElementById(id);
				if (element) element.textContent = vendorPreviewDecimal(amount) + ' ' + currency;
			});
			const costEl = document.getElementById('preview-cost-price');
			if (costEl) costEl.textContent = costBase > 0n ? vendorPreviewDecimal(discountedCost) + ' ' + currency : noCostText;
			const marginEl = document.getElementById('preview-profit-margin');
			if (marginEl) marginEl.textContent = vendorPreviewDecimal(margin) + '%';
		}
		
		(document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', recalcProfitPreview) : recalcProfitPreview());

		function onAddVariantComboboxChange(e) {
			if (!e || !e.detail) return;
			if (e.detail.name === 'product_id' && e.detail.item) {
				const item = e.detail.item;
				const nameAr = document.getElementById('add-form-name-ar');
				if (nameAr && !nameAr.value) {
					nameAr.value = item.name_ar || item.label || '';
				}
				const nameEn = document.getElementById('add-form-name-en');
				if (nameEn && !nameEn.value && item.name_en) {
					nameEn.value = item.name_en;
				}
				const price = document.getElementById('add-form-price');
				if (price && (!price.value || price.value === '0.00' || price.value === '0')) {
					if (item.price) {
						price.value = item.price;
						recalcProfitPreview();
					}
				}
				const sku = document.getElementById('add-form-sku');
				if (sku && !sku.value && item.sku) {
					sku.value = item.sku;
				}
				const barcode = document.getElementById('add-form-barcode');
				if (barcode && !barcode.value && item.barcode) {
					barcode.value = item.barcode;
				}
				const unit = document.getElementById('add-form-unit');
				if (unit && !unit.value && item.unit) {
					unit.value = item.unit;
				}
			}
		}
	</script>
}
