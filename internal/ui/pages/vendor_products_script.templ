package pages

import (
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

templ VendorProductsScript() {
	<script nonce={ layouts.Nonce(ctx) }>
		function openAddFromCatalogModal() {
			resetSelectedMasterProduct();
			const input = document.getElementById('cat-search-input');
			if (input) input.value = '';
			const el = document.getElementById('add-from-catalog-modal');
			if (el && typeof el.showModal === 'function') {
				el.showModal();
			}
		}

		function closeAddFromCatalogModal() {
			const el = document.getElementById('add-from-catalog-modal');
			if (el && typeof el.close === 'function') {
				el.close();
			}
		}

		function openAddCustomVariantModal() {
			const el = document.getElementById('add-custom-variant-modal');
			if (el && typeof el.showModal === 'function') {
				el.showModal();
			}
		}

		function closeAddCustomVariantModal() {
			const el = document.getElementById('add-custom-variant-modal');
			if (el && typeof el.close === 'function') {
				el.close();
			}
		}

		function openEditVariantModal(id) {
			const row = document.querySelector(`.vendor-variant-row[data-id="${id}"]`);
			if (!row) return;

			let v;
			try { v = JSON.parse(row.dataset.variant || '{}'); } catch (e) { return; }

			const form = document.getElementById('edit-variant-form');
			if (form) form.action = `/vendor/variants/${id}/update`;

			const fields = {
				'edit-form-name-ar': v.name_ar,
				'edit-form-name-en': v.name_en,
				'edit-form-sku': v.sku,
				'edit-form-barcode': v.barcode,
				'edit-form-unit': v.unit,
				'edit-form-price': v.price,
				'edit-form-discount': v.discount,
				'edit-form-cost': v.cost_price,
				'edit-form-cost-discount': (v.cost_discount_percentage && v.cost_discount_percentage !== '0.00') ? v.cost_discount_percentage : '',
				'edit-form-stock': v.stock_qty,
				'edit-form-min-qty': v.min_order_qty || 1,
				'edit-form-quota': v.quota_limit || '',
				'edit-form-batch': v.batch_number,
				'edit-form-expiry': v.expiry_date,
				'edit-form-status': v.status || 'active',
				'edit-form-negotiable': v.is_negotiable ? 'true' : 'false'
			};
			Object.keys(fields).forEach((elID) => {
				const el = document.getElementById(elID);
				if (!el) return;
				const value = fields[elID];
				el.value = (value === null || value === undefined) ? '' : String(value);
			});

			const branchSelect = document.getElementById('edit-form-branch');
			if (branchSelect) {
				if (v.branch_id && v.branch_id !== '0') {
					branchSelect.value = String(v.branch_id);
				}
				if (!branchSelect.value && branchSelect.options.length > 0) {
					branchSelect.selectedIndex = 0;
				}
			}

			const params = new URLSearchParams(window.location.search);
			const ctx = {
				'edit-form-ctx-page': params.get('page'),
				'edit-form-ctx-limit': params.get('limit'),
				'edit-form-ctx-q': params.get('q'),
				'edit-form-ctx-status': params.get('status'),
				'edit-form-ctx-stock': params.get('stock'),
				'edit-form-ctx-sort': params.get('sort')
			};
			Object.keys(ctx).forEach((elID) => {
				const el = document.getElementById(elID);
				if (el) el.value = ctx[elID] || '';
			});

			const el = document.getElementById('edit-variant-modal');
			if (el && typeof el.showModal === 'function') {
				el.showModal();
			}
		}

		function closeEditVariantModal() {
			const el = document.getElementById('edit-variant-modal');
			if (el && typeof el.close === 'function') {
				el.close();
			}
		}

		var catSearchDebounce = null;
		var catSearchAbort = null;
		var catSearchRequest = 0;
		var masterCatalogResults = [];

		function searchMasterCatalogLive(query) {
			const dropdown = document.getElementById('cat-search-dropdown');
			if (!dropdown) return;
			cancelMasterCatalogSearch();
			const searchText = (query || '').trim();
			if (Array.from(searchText).length < 2) {
				dropdown.classList.add('d-none');
				return;
			}
			showCatalogSearchMessage(dropdown, dropdown.dataset.loadingText || '');
			const requestId = catSearchRequest;
			catSearchDebounce = setTimeout(() => fetchMasterCatalog(searchText, requestId), 200);
		}

		function cancelMasterCatalogSearch() {
			clearTimeout(catSearchDebounce);
			if (catSearchAbort) catSearchAbort.abort();
			catSearchAbort = null;
			catSearchRequest++;
		}

		function fetchMasterCatalog(query, requestId) {
			catSearchAbort = typeof AbortController === 'function' ? new AbortController() : null;
			fetch('/vendor/catalog/search-json?q=' + encodeURIComponent(query), {
				headers: { Accept: 'application/json' },
				signal: catSearchAbort ? catSearchAbort.signal : undefined
			})
				.then(response => {
					if (!response.ok) throw new Error('catalog search failed');
					return response.json();
				})
				.then(products => {
					if (requestId !== catSearchRequest) return;
					masterCatalogResults = Array.isArray(products) ? products : [];
					renderMasterCatalogResults();
				})
				.catch(error => {
					if (requestId !== catSearchRequest || error.name === 'AbortError') return;
					showCatalogSearchMessage(document.getElementById('cat-search-dropdown'),
						document.getElementById('cat-search-dropdown').dataset.errorText || '');
				});
		}

		function showCatalogSearchMessage(dropdown, message) {
			dropdown.textContent = message;
			dropdown.classList.remove('d-none');
		}

		function renderMasterCatalogResults() {
			const dropdown = document.getElementById('cat-search-dropdown');
			if (!dropdown) return;
			if (masterCatalogResults.length === 0) {
				showCatalogSearchMessage(dropdown, dropdown.dataset.emptyText || '');
				return;
			}
			const isEnglish = document.documentElement.lang === 'en';
			const markup = masterCatalogResults.map((product, index) => masterCatalogRow(product, index, isEnglish)).join('');
			dropdown.innerHTML = dawaHTML.sanitize(markup);
			dropdown.classList.remove('d-none');
			dropdown.onclick = chooseMasterCatalogResult;
		}

		function masterCatalogRow(product, index, isEnglish) {
			const escape = dawaHTML.escape;
			const name = isEnglish && product.name_en ? product.name_en : (product.name_ar || product.name_en || '');
			const dosage = product.dosage_form ? '<span class="badge badge-slate text-xs">' + escape(product.dosage_form) + '</span>' : '';
			const price = product.price ? '<span class="badge badge-sky text-xs">' + escape(product.price) + (isEnglish ? ' EGP' : ' ج.م') + '</span>' : '';
			return '<div class="p-3 border-b cursor-pointer flex-between items-center transition-colors hover-bg-sunken" data-pick-index="' + index + '">' +
				'<div class="stack-sm"><div class="font-extrabold text-primary text-sm">' + escape(name) + '</div>' +
				'<div class="text-xs text-muted mt-0.5">' + escape(product.scientific_name || '') + '</div></div>' +
				'<div class="row-center-sm">' + dosage + price + '<span class="badge badge-emerald text-xs fw-800">' + (isEnglish ? 'Select' : 'اختيار') + '</span></div></div>';
		}

		function chooseMasterCatalogResult(event) {
			const option = event.target.closest('[data-pick-index]');
			if (!option) return;
			const product = masterCatalogResults[Number(option.dataset.pickIndex)];
			if (product) selectMasterProductForStaging(product);
		}

		function selectMasterProductForStaging(product) {
			const isEnglish = document.documentElement.lang === 'en';
			const nameAr = product.name_ar || product.name_en || '';
			const nameEn = product.name_en || product.name_ar || '';
			const displayName = isEnglish ? nameEn : nameAr;
			setCatalogField('cat-select-product-id', product.id);
			setCatalogField('cat-select-name-ar', nameAr);
			setCatalogField('cat-select-name-en', nameEn);
			setCatalogField('cat-select-sku', product.sku || '');
			setCatalogField('cat-select-barcode', product.barcode || '');
			setCatalogField('cat-select-unit', product.unit || '');
			setCatalogField('cat-field-price', product.price || '');
			showSelectedMasterProduct(displayName, product, isEnglish);
		}

		function setCatalogField(id, value) {
			const field = document.getElementById(id);
			if (field) field.value = value || '';
		}

		function showSelectedMasterProduct(name, product, isEnglish) {
			document.getElementById('cat-preview-name').textContent = name;
			document.getElementById('cat-preview-scientific').textContent = product.scientific_name ? ((isEnglish ? 'Active Ingredient: ' : 'المادة الفعالة: ') + product.scientific_name) : '';
			document.getElementById('cat-preview-dosage').textContent = product.dosage_form || (isEnglish ? 'Standard Dosage Form' : 'شكل دوائي قياسي');
			document.getElementById('cat-preview-sku').textContent = product.sku ? 'SKU: ' + product.sku : '';
			document.getElementById('cat-preview-price').textContent = product.price ? ((isEnglish ? 'Catalog Price: ' : 'السعر بالكتالوج: ') + product.price + (isEnglish ? ' EGP' : ' ج.م')) : '';
			document.getElementById('cat-search-dropdown').classList.add('d-none');
			document.getElementById('cat-selected-preview').classList.remove('d-none');
			document.getElementById('cat-vendor-fields').classList.remove('d-none');
		}

		function resetSelectedMasterProduct() {
			cancelMasterCatalogSearch();
			const form = document.getElementById('add-from-catalog-form');
			if (form) form.reset();
			masterCatalogResults = [];
			['cat-select-product-id', 'cat-select-name-ar', 'cat-select-name-en', 'cat-select-sku', 'cat-select-barcode', 'cat-select-unit'].forEach(id => setCatalogField(id, ''));
			document.getElementById('cat-search-dropdown').classList.add('d-none');
			document.getElementById('cat-selected-preview').classList.add('d-none');
			document.getElementById('cat-vendor-fields').classList.add('d-none');
		}

		function onAddVariantComboboxChange(e) {
			if (!e || !e.detail) return;
			if (e.detail.name === 'product_id' && e.detail.item) {
				const item = e.detail.item;
				const nameAr = document.getElementById('add-form-name-ar');
				if (nameAr && !nameAr.value) {
					nameAr.value = item.name_ar || item.label || '';
				}
				const nameEn = document.getElementById('add-form-name-en');
				if (nameEn && !nameEn.value && item.name_en) {
					nameEn.value = item.name_en;
				}
				const price = document.getElementById('add-form-price');
				if (price && (!price.value || price.value === '0.00' || price.value === '0')) {
					if (item.price) price.value = item.price;
				}
				const sku = document.getElementById('add-form-sku');
				if (sku && !sku.value && item.sku) {
					sku.value = item.sku;
				}
				const barcode = document.getElementById('add-form-barcode');
				if (barcode && !barcode.value && item.barcode) {
					barcode.value = item.barcode;
				}
				const unit = document.getElementById('add-form-unit');
				if (unit && !unit.value && item.unit) {
					unit.value = item.unit;
				}
			}
		}
	</script>
}
