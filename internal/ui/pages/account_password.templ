package pages

import (
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

// AccountPasswordPage is the one page a member must use when the account was
// created with an administrator's password. It needs no permission, so a role
// without the sessions permission can still reach it.
templ AccountPasswordPage(lang, dir string, isVendor bool, errorMsg string) {
	@layouts.Base(ternary(lang == "en", "Change your password", "تغيير كلمة المرور"), lang, dir) {
		<div class="auth-page-wrapper">
			<div class="auth-card glass-panel">
				<div class="auth-header">
					<h1 class="auth-title">{ ternary(lang == "en", "Set your own password", "عيّن كلمة المرور الخاصة بك") }</h1>
					<p class="auth-subtitle">{ ternary(lang == "en", "Your account was created with a password set by your administrator. Choose your own to continue.", "أُنشئ حسابك بكلمة مرور حددها المسؤول. اختر كلمة مرورك الخاصة للمتابعة.") }</p>
				</div>
				if errorMsg != "" {
					<div class="alert alert-danger" role="alert">{ errorMsg }</div>
				}
				<form method="POST" action={ templ.SafeURL(ternary(isVendor, "/vendor/password", "/customer/password")) } class="d-flex flex-col gap-4">
					<input type="hidden" name="return" value="account"/>
					<div class="form-group mb-0">
						<label class="form-label font-semibold text-xs" for="acc-current">{ ternary(lang == "en", "Current password", "كلمة المرور الحالية") }</label>
						<input type="password" id="acc-current" name="current_password" required autocomplete="current-password" class="form-input"/>
					</div>
					<div class="form-group mb-0">
						<label class="form-label font-semibold text-xs" for="acc-new">{ ternary(lang == "en", "New password", "كلمة المرور الجديدة") }</label>
						<input type="password" id="acc-new" name="new_password" required minlength="8" autocomplete="new-password" class="form-input"/>
					</div>
					<div class="form-group mb-0">
						<label class="form-label font-semibold text-xs" for="acc-confirm">{ ternary(lang == "en", "Confirm new password", "تأكيد كلمة المرور") }</label>
						<input type="password" id="acc-confirm" name="confirm_password" required minlength="8" autocomplete="new-password" class="form-input"/>
					</div>
					<button type="submit" class="btn btn-primary btn-lg w-100 font-bold">
						@components.IconCheck("icon-xs")
						<span>{ ternary(lang == "en", "Save password", "حفظ كلمة المرور") }</span>
					</button>
				</form>
				<div class="auth-footer">
					<a href="/auth/logout" class="font-bold text-accent text-decoration-none">{ ternary(lang == "en", "Sign out", "تسجيل الخروج") }</a>
				</div>
			</div>
		</div>
	}
}
