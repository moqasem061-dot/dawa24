package pages

import (
	"fmt"
	"github.com/moqasem061-dot/dawa24/internal/modules/billing"
	"github.com/moqasem061-dot/dawa24/internal/modules/commerce"
	"github.com/moqasem061-dot/dawa24/internal/platform/authctx"
	"github.com/moqasem061-dot/dawa24/internal/shared/format"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

templ CustomerCheckout(cart *commerce.Cart, branches []*CheckoutBranchItem, wallet *billing.Wallet, paymentMethods []*billing.PlatformPaymentMethod, userPaymentMethods []*billing.UserPaymentMethod, lang, dir string) {
	@layouts.ShellFor(fmt.Sprintf("%s | B2B Checkout", i18n.T(lang, "checkout.title")), "checkout", lang, dir, authctx.FromContext(ctx)) {
		<div class="page-container max-w-6xl">
			
			<!-- Header -->
			<div class="page-header-block mb-6 border-b pb-4">
				<div class="d-flex items-center gap-3">
					<div class="user-avatar-badge">
						@components.IconPackage("icon-sm")
					</div>
					<div class="stack-sm">
						<h1 class="text-2xl font-black text-primary m-0">
							{ i18n.T(lang, "checkout.title") }
						</h1>
						<p class="text-sm text-muted m-0 mt-1">
							{ i18n.T(lang, "checkout.subtitle") }
						</p>
					</div>
				</div>
			</div>

			if cart == nil || len(cart.Items) == 0 {
				<div class="empty-state-glass p-8 text-center">
					<div class="empty-state-icon-wrapper mx-auto mb-4">
						@components.IconCart("icon-sm")
					</div>
					<h3 class="text-xl font-black text-primary mb-2">
						{ i18n.T(lang, "cart.empty_title") }
					</h3>
					<p class="text-sm text-muted max-w-md mx-auto mb-6">
						{ i18n.T(lang, "cart.empty_subtitle") }
					</p>
					<a href="/catalog" class="btn btn-primary font-bold">
						@components.IconSearch("icon-xs")
						<span>{ i18n.T(lang, "cart.browse_catalog") }</span>
					</a>
				</div>
			} else {
				<!-- Stepper Progress Bar -->
				<div class="mb-6">
					@components.Stepper(components.StepperProps{
						Steps: []components.StepperStep{
							{ ID: "address", Label: i18n.T(lang, "checkout.step_branch") },
							{ ID: "shipping", Label: i18n.T(lang, "checkout.step_shipping") },
							{ ID: "payment", Label: i18n.T(lang, "checkout.step_payment") },
							{ ID: "review", Label: i18n.T(lang, "checkout.step_review") },
						},
						Current: 2,
					})
				</div>

				<form class="stack-md" action="/checkout" method="POST">
					<div class="checkout-grid">
						
						<!-- Left Column: Address, Payment, Notes -->
						<div class="d-flex flex-col gap-6">
							
							<!-- 1. Pharmacy Delivery Branches Card -->
							<div class="checkout-step-card">
								<div class="flex-between mb-4 flex-wrap gap-3">
									<div class="d-flex items-center gap-3">
										<div class="user-avatar-badge">
											@components.IconBuilding("icon-xs")
										</div>
										<div class="stack-sm">
											<h2 class="text-lg font-extrabold text-primary m-0">
												{ i18n.T(lang, "checkout.branch_step_title") }
											</h2>
											<span class="text-xs text-muted">{ i18n.T(lang, "checkout.branch_step_sub") }</span>
										</div>
									</div>

									if buying, has := authctx.BuyingBranchFrom(ctx); !has || !buying.IsLocked {
										<a href={ templ.SafeURL(func() string {
											if actor := authctx.FromContext(ctx); actor.IsVendor() {
												return "/vendor/branches"
											}
											return "/customer/branches"
										}()) } class="btn btn-secondary btn-sm font-bold gap-1">
											@components.IconPlus("icon-xs")
											<span>{ i18n.T(lang, "checkout.manage_branches") }</span>
										</a>
									} else {
										<span class="badge badge-amber text-xs font-bold gap-1">
											@components.IconLock("icon-2xs")
											<span>{ i18n.T(lang, "checkout.branch_locked") }</span>
										</span>
									}
								</div>

								@CheckoutBranchList(branches, lang)
							</div>

							<!-- 2. Payment Terms & Methods Card -->
							<div class="checkout-step-card">
								<div class="d-flex items-center gap-3 mb-4">
									<div class="user-avatar-badge">
										@components.IconShield("icon-xs")
									</div>
									<h2 class="text-lg font-extrabold text-primary m-0">
										{ i18n.T(lang, "checkout.payment_step_title") }
									</h2>
								</div>

								<div class="d-flex flex-col gap-3" x-data={ fmt.Sprintf("{ selectedMethod: %q }", func() string {
									if wallet != nil && (cart == nil || wallet.AvailableBalance.Minor() >= CartTotal(cart).Minor()) {
										return "wallet"
									}
									return "cod"
								}()) }>
									<!-- Organization Wallet Payment -->
									if wallet != nil {
										{{ hasFunds := cart == nil || wallet.AvailableBalance.Minor() >= CartTotal(cart).Minor() }}
										<label
											class={ "checkout-branch-item", templ.KV("opacity-75 bg-surface-raised cursor-not-allowed", !hasFunds) }
											:class="{ 'border-brand bg-surface-sunken': selectedMethod === 'wallet' }"
										>
											<input
												type="radio"
												name="payment_method"
												value="wallet"
												checked?={ hasFunds }
												disabled?={ !hasFunds }
												@change="selectedMethod = 'wallet'"
												class="form-radio mt-1 text-brand"
											/>
											<div class="flex-1">
												<div class="flex-between mb-1 flex-wrap gap-2">
													<div class="d-flex items-center gap-2">
														@components.IconWallet("icon-xs text-brand")
														<div class="font-extrabold text-base text-primary">
															{ fmt.Sprintf(i18n.T(lang, "checkout.wallet_title"), format.Money(wallet.AvailableBalance, lang)) }
														</div>
													</div>
													if hasFunds {
														<span class="badge badge-emerald text-xs font-bold">{ i18n.T(lang, "checkout.wallet_sufficient") }</span>
													} else {
														<span class="badge badge-amber text-xs font-bold">{ i18n.T(lang, "checkout.wallet_insufficient") }</span>
													}
												</div>
												<div class="text-xs text-secondary leading-relaxed">
													{ i18n.T(lang, "checkout.wallet_desc") }
												</div>
												if !hasFunds {
													<div class="mt-2 text-2xs text-danger font-bold d-flex items-center gap-1">
														<span>{ i18n.T(lang, "checkout.wallet_alert") }</span>
														<a href={ templ.SafeURL(func() string {
															if actor := authctx.FromContext(ctx); actor.IsVendor() {
																return "/vendor/wallet"
															}
															return "/customer/wallet"
														}()) } target="_blank" class="text-brand underline font-extrabold">{ i18n.T(lang, "checkout.wallet_topup") }</a>
													</div>
												}
											</div>
										</label>
									}

									<!-- Cash on Delivery (COD) -->
									<label
										class="checkout-branch-item"
										:class="{ 'border-brand bg-surface-sunken': selectedMethod === 'cod' }"
									>
										<input
											type="radio"
											name="payment_method"
											value="cod"
											checked?={ wallet == nil || (cart != nil && wallet.AvailableBalance.Minor() < CartTotal(cart).Minor()) }
											@change="selectedMethod = 'cod'"
											class="form-radio mt-1"
										/>
										<div class="flex-1">
											<div class="flex-between mb-1 flex-wrap gap-2">
												<div class="font-extrabold text-base text-primary">
													{ i18n.T(lang, "checkout.cod_title") }
												</div>
												<span class="badge badge-sky text-xs font-bold">{ i18n.T(lang, "checkout.cod_badge") }</span>
											</div>
											<div class="text-xs text-secondary leading-relaxed">
												{ i18n.T(lang, "checkout.cod_desc") }
											</div>
										</div>
									</label>

									<!-- Other Active Platform Payment Methods (InstaPay, Bank Transfer, Mobile Wallets, Cards) -->
									for _, pm := range paymentMethods {
										if pm != nil && pm.ID != "wallet" && pm.ID != "cod" && pm.ProviderType != "cash" {
											{{ matchingSaved := FilterUserPaymentMethodsByProvider(userPaymentMethods, pm.ProviderType) }}
											<div
												class="checkout-branch-item flex-col items-stretch gap-3 transition-colors"
												:class={ fmt.Sprintf("{ 'border-brand bg-surface-sunken ring-1 ring-brand': selectedMethod === %q }", pm.ID) }
											>
												<label class="d-flex items-start gap-3 cursor-pointer w-full">
													<input
														type="radio"
														name="payment_method"
														value={ pm.ID }
														@change={ fmt.Sprintf("selectedMethod = %q", pm.ID) }
														class="form-radio mt-1 text-brand"
													/>
													<div class="flex-1">
														<div class="flex-between mb-1 flex-wrap gap-2">
															<div class="font-extrabold text-base text-primary">
																{ pm.Name.Get(i18n.Lang(lang)) }
															</div>
															<span class="badge badge-sky text-xs font-bold">{ pm.ProviderType }</span>
														</div>
														if pm.Description.Get(i18n.Lang(lang)) != "" {
															<div class="text-xs text-secondary leading-relaxed">
																{ pm.Description.Get(i18n.Lang(lang)) }
															</div>
														}
													</div>
												</label>

												<!-- Expandable details when this method is selected -->
												<div
													x-show={ fmt.Sprintf("selectedMethod === %q", pm.ID) }
													x-cloak
													class="mt-2 pt-3 border-t border-border-subtle d-flex flex-col gap-3 text-xs"
												>
													<!-- 1. Platform Official Transfer Credentials -->
													<div class="p-3.5 rounded-lg bg-surface border border-border-subtle shadow-xs">
														<div class="d-flex items-center gap-2 mb-2.5 font-bold text-primary">
															@components.IconBuilding("icon-xs text-brand")
															<span>{ i18n.TDefault("بيانات التحويل المعتمدة لمنصة دواء 24 (حساب الاستلام):") }</span>
														</div>

														if pm.ProviderType == "bank" {
															<div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
																if pm.BankName != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between">
																		<span class="text-muted">{ i18n.TDefault("اسم البنك:") }</span>
																		<strong class="text-primary font-bold">{ pm.BankName }</strong>
																	</div>
																}
																if pm.AccountName != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between">
																		<span class="text-muted">{ i18n.TDefault("اسم صاحب الحساب:") }</span>
																		<strong class="text-primary font-bold">{ pm.AccountName }</strong>
																	</div>
																}
																if pm.AccountNumber != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between gap-2">
																		<span class="text-muted">{ i18n.TDefault("رقم الحساب:") }</span>
																		<div class="d-flex items-center gap-1.5 font-mono font-bold text-primary">
																			<span>{ pm.AccountNumber }</span>
																			<button
																				type="button"
																				class="btn btn-ghost btn-2xs p-1"
																				title={ i18n.TDefault("نسخ رقم الحساب") }
																				@click={ fmt.Sprintf("$copy(%q)", pm.AccountNumber) }
																			>
																				@components.IconCopy("icon-2xs")
																			</button>
																		</div>
																	</div>
																}
																if pm.IBAN != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between gap-2 md:col-span-2">
																		<span class="text-muted">{ i18n.TDefault("الآيبان (IBAN):") }</span>
																		<div class="d-flex items-center gap-1.5 font-mono font-bold text-primary break-all">
																			<span>{ pm.IBAN }</span>
																			<button
																				type="button"
																				class="btn btn-ghost btn-2xs p-1"
																				title={ i18n.TDefault("نسخ الآيبان") }
																				@click={ fmt.Sprintf("$copy(%q)", pm.IBAN) }
																			>
																				@components.IconCopy("icon-2xs")
																			</button>
																		</div>
																	</div>
																}
																if pm.SwiftCode != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between gap-2">
																		<span class="text-muted">{ i18n.TDefault("رمز السويفت (SWIFT):") }</span>
																		<div class="d-flex items-center gap-1.5 font-mono font-bold text-primary">
																			<span>{ pm.SwiftCode }</span>
																			<button
																				type="button"
																				class="btn btn-ghost btn-2xs p-1"
																				title={ i18n.TDefault("نسخ السويفت كود") }
																				@click={ fmt.Sprintf("$copy(%q)", pm.SwiftCode) }
																			>
																				@components.IconCopy("icon-2xs")
																			</button>
																		</div>
																	</div>
																}
																if pm.BranchName != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between">
																		<span class="text-muted">{ i18n.TDefault("الفرع:") }</span>
																		<strong class="text-primary font-bold">{ pm.BranchName }</strong>
																	</div>
																}
															</div>
														} else if pm.ProviderType == "instapay" {
															<div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
																if pm.InstaPayHandle != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between gap-2 md:col-span-2">
																		<span class="text-muted">{ i18n.TDefault("عنوان الدفع اللحظي (IPA):") }</span>
																		<div class="d-flex items-center gap-1.5 font-mono font-bold text-brand">
																			<span>{ pm.InstaPayHandle }</span>
																			<button
																				type="button"
																				class="btn btn-ghost btn-2xs p-1"
																				title={ i18n.TDefault("نسخ عنوان إنستاباي") }
																				@click={ fmt.Sprintf("$copy(%q)", pm.InstaPayHandle) }
																			>
																				@components.IconCopy("icon-2xs")
																			</button>
																		</div>
																	</div>
																}
																if pm.AccountName != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between">
																		<span class="text-muted">{ i18n.TDefault("اسم المستفيد:") }</span>
																		<strong class="text-primary font-bold">{ pm.AccountName }</strong>
																	</div>
																}
																if pm.PhoneNumber != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between gap-2">
																		<span class="text-muted">{ i18n.TDefault("رقم الهاتف المسجل:") }</span>
																		<div class="d-flex items-center gap-1.5 font-mono font-bold text-primary">
																			<span>{ pm.PhoneNumber }</span>
																			<button
																				type="button"
																				class="btn btn-ghost btn-2xs p-1"
																				title={ i18n.TDefault("نسخ رقم الهاتف") }
																				@click={ fmt.Sprintf("$copy(%q)", pm.PhoneNumber) }
																			>
																				@components.IconCopy("icon-2xs")
																			</button>
																		</div>
																	</div>
																}
															</div>
														} else if pm.ProviderType == "wallet" {
															<div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
																if pm.PhoneNumber != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between gap-2 md:col-span-2">
																		<span class="text-muted">{ i18n.TDefault("رقم محفظة الاستلام:") }</span>
																		<div class="d-flex items-center gap-1.5 font-mono font-bold text-brand">
																			<span>{ pm.PhoneNumber }</span>
																			<button
																				type="button"
																				class="btn btn-ghost btn-2xs p-1"
																				title={ i18n.TDefault("نسخ رقم المحفظة") }
																				@click={ fmt.Sprintf("$copy(%q)", pm.PhoneNumber) }
																			>
																				@components.IconCopy("icon-2xs")
																			</button>
																		</div>
																	</div>
																}
																if pm.AccountName != "" {
																	<div class="p-2 rounded bg-surface-raised flex-between">
																		<span class="text-muted">{ i18n.TDefault("اسم المحفظة / الجهة:") }</span>
																		<strong class="text-primary font-bold">{ pm.AccountName }</strong>
																	</div>
																}
															</div>
														} else if pm.ProviderType == "card" {
															<p class="text-muted m-0 leading-relaxed">
																{ i18n.TDefault("سيتم توجيهك إلى بوابة الدفع الإلكتروني الآمنة المعتمدة لإتمام السداد فور تأكيد الطلب.") }
															</p>
														}
													</div>

													<!-- 2. Buyer's Saved Accounts Matching This Provider -->
													if pm.ProviderType != "card" {
														<div class="p-3.5 rounded-lg bg-surface border border-border-subtle">
															<div class="flex-between mb-2.5 flex-wrap gap-2">
																<div class="d-flex items-center gap-2 font-bold text-primary">
																	@components.IconWallet("icon-xs text-brand")
																	<span>{ i18n.TDefault("طريقة السداد / الحساب المحول منه بالمنشأة:") }</span>
																</div>
																<a
																	href={ templ.SafeURL(func() string {
																		if actor := authctx.FromContext(ctx); actor.IsVendor() {
																			return "/vendor/wallet"
																		}
																		return "/customer/wallet"
																	}()) }
																	target="_blank"
																	class="text-2xs font-bold text-brand hover:underline d-flex items-center gap-1"
																>
																	@components.IconPlus("icon-2xs")
																	<span>{ i18n.TDefault("إدارة أو إضافة حساب في المحفظة ↗") }</span>
																</a>
															</div>

															if len(matchingSaved) > 0 {
																<div class="d-flex flex-col gap-2">
																	for idx, upm := range matchingSaved {
																		<label class="d-flex items-start gap-2.5 p-2.5 rounded-lg border border-border-subtle bg-surface-raised hover:bg-surface-sunken cursor-pointer transition-colors">
																			<input
																				type="radio"
																				name="sender_payment_method_id"
																				value={ fmt.Sprintf("%d", upm.ID) }
																				checked?={ upm.IsDefault || (idx == 0 && !HasDefaultPaymentMethod(matchingSaved)) }
																				class="form-radio mt-0.5 text-brand"
																			/>
																			<div class="flex-1">
																				<div class="flex-between flex-wrap gap-1">
																					<strong class="text-primary font-bold">{ upm.AccountIdentifier }</strong>
																					if upm.IsDefault {
																						<span class="badge badge-emerald text-2xs font-bold">{ i18n.TDefault("الافتراضي") }</span>
																					}
																				</div>
																				if upm.Details.AccountHolder != "" && upm.Details.AccountHolder != upm.AccountIdentifier {
																					<div class="text-muted text-2xs mt-0.5">
																						<span>{ i18n.TDefault("صاحب الحساب:") } { upm.Details.AccountHolder }</span>
																					</div>
																				}
																			</div>
																		</label>
																	}
																</div>
															} else {
																<div class="p-3 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 d-flex items-center justify-between flex-wrap gap-2">
																	<div class="d-flex items-center gap-2">
																		@components.IconAlert("icon-xs flex-shrink-0")
																		<span>{ i18n.TDefault("لم تقم بإضافة وسيلة دفع من هذا النوع في محفظتك بعد.") }</span>
																	</div>
																	<a
																		href={ templ.SafeURL(func() string {
																			if actor := authctx.FromContext(ctx); actor.IsVendor() {
																				return "/vendor/wallet"
																			}
																			return "/customer/wallet"
																		}()) }
																		target="_blank"
																		class="btn btn-secondary btn-xs font-bold gap-1"
																	>
																		@components.IconPlus("icon-2xs")
																		<span>{ i18n.TDefault("إضافة الآن بالمحفظة") }</span>
																	</a>
																</div>
															}
														</div>
													}

													<!-- 3. Payment Reference / Transaction ID -->
													if pm.ProviderType != "card" {
														<div class="p-3.5 rounded-lg bg-surface border border-border-subtle">
															<label class="d-flex flex-col gap-1.5">
																<span class="font-bold text-primary d-flex items-center gap-1.5">
																	@components.IconFileText("icon-xs text-muted")
																	<span>{ i18n.TDefault("رقم العملية / مرجع التحويل (Payment Reference):") }</span>
																</span>
																<input
																	type="text"
																	name="payment_reference"
																	placeholder={ i18n.TDefault("مثال: REF-12345678 أو رقم الإشعار البنكي / إنستاباي") }
																	class="form-input w-full text-xs font-mono"
																/>
																<span class="text-2xs text-muted">
																	{ i18n.TDefault("إدخال رقم العملية يسرّع مراجعة وتأكيد الطلب وشحنه فوراً من قِبل المورد.") }
																</span>
															</label>
														</div>
													}
												</div>
											</div>
										}
									}
								</div>
							</div>

							<!-- 3. Cold-Chain & Delivery Notes -->
							<div class="checkout-step-card">
								<div class="d-flex items-center gap-3 mb-3">
									<div class="user-avatar-badge">
										@components.IconTruck("icon-xs")
									</div>
									<h2 class="text-lg font-extrabold text-primary m-0">
										{ i18n.T(lang, "checkout.notes_step_title") }
									</h2>
								</div>
								<textarea
									name="notes"
									rows="3"
									placeholder={ i18n.T(lang, "checkout.notes_placeholder") }
									class="form-textarea w-full"
								></textarea>
							</div>
						</div>

						<!-- Right Column: Order Summary & Confirm Button -->
						<div class="d-flex flex-col gap-4">
							<div class="checkout-summary-card">
								<h3 class="text-lg font-extrabold text-primary m-0 mb-3 border-b pb-3">
									{ i18n.T(lang, "checkout.summary_title") }
								</h3>

								<!-- Line items summary -->
								<div class="d-flex flex-col gap-2 mb-4 max-h-56 overflow-y-auto pe-1">
									for _, it := range cart.Items {
										<div class="flex-between text-xs">
											<span class="text-secondary text-truncate max-w-180">
												{ it.ProductName.Get(i18n.Lang(lang)) }
												<span class="text-muted tabular-nums"> (×{ fmt.Sprintf("%d", it.Quantity) })</span>
											</span>
											<strong class="tabular-nums text-primary font-bold">{ format.Money(CartItemTotal(it), lang) }</strong>
										</div>
									}
								</div>

								<div class="border-t pt-3 d-flex flex-col gap-2 text-xs">
									<div class="flex-between text-secondary">
										<span>{ i18n.T(lang, "checkout.total_items_label") }</span>
										<span class="tabular-nums font-bold text-primary">{ fmt.Sprintf(i18n.T(lang, "checkout.items_count"), len(cart.Items)) }</span>
									</div>

									<div class="flex-between text-secondary">
										<span>{ i18n.T(lang, "checkout.cold_chain_label") }</span>
										<span class="badge badge-emerald text-xs">{ i18n.T(lang, "checkout.cold_chain_free") }</span>
									</div>
								</div>

								<div class="border-t pt-3 mt-3 flex-between items-baseline">
									<span class="font-extrabold text-sm text-primary">{ i18n.T(lang, "cart.grand_total") }</span>
									<div class="text-2xl font-black text-brand tabular-nums">
										{ format.Money(CartTotal(cart), lang) }
									</div>
								</div>

								{{ hasAvailableBranch := HasAvailableCheckoutBranch(branches) }}
								<div class="mt-4">
									<button
										type="submit"
										disabled?={ !hasAvailableBranch }
										class={
											"btn btn-primary btn-lg w-full font-extrabold flex-center gap-2",
											templ.KV("opacity-50 cursor-not-allowed pointer-events-none", !hasAvailableBranch),
										}
									>
										@components.IconCheck("icon-sm")
										<span>{ i18n.T(lang, "checkout.confirm_btn") }</span>
									</button>
									if !hasAvailableBranch && len(branches) > 0 {
										<p class="text-xs text-amber-500 text-center mt-2 font-bold m-0">
											{ i18n.T(lang, "checkout.no_available_branch_warning") }
										</p>
									}
								</div>
							</div>
						</div>
					</div>
				</form>
			}
		</div>
	}
}
