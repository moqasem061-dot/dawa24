package pages

import (
	"fmt"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

type WarehouseReviewProgress struct {
	URL string
	Total, Completed, Succeeded int
	FailedIDs []int64
	Done, Failed bool
}

templ AdminWarehouseReviewProgress(review WarehouseReviewProgress, lang, dir string) {
	@layouts.AdminShell(i18n.T(lang, "warehouse.review.button"), "temp_warehouses", lang, dir) {
		<div id="warehouse-review-status" class="glass-panel p-5 stack-md" hx-get={ review.URL } hx-trigger="every 3s" hx-select="#warehouse-review-status" hx-swap="outerHTML" hx-vals="{}" hx-boost="false" hx-disable?={ review.Done }>
			<h1 class="text-xl font-bold">{ i18n.T(lang, "warehouse.review.button") }</h1>
			<p class="text-secondary">{ i18n.T(lang, "warehouse.review.scope") }</p>
			<p role="status" aria-live="polite">{ fmt.Sprintf(i18n.T(lang, "warehouse.review.counts"), review.Completed, review.Total, review.Succeeded, len(review.FailedIDs)) }</p>
			if review.Done {
				if review.Failed {
					<p class="alert alert-danger" role="alert">{ i18n.T(lang, "warehouse.review.partial") }</p>
				} else {
					<p class="alert alert-success">{ i18n.T(lang, "warehouse.review.finished") }</p>
				}
			} else {
				<p>{ i18n.T(lang, "warehouse.review.running") }</p>
			}
			if len(review.FailedIDs) > 0 {
				<ul>
					for _, id := range review.FailedIDs {
						<li><a href={ templ.SafeURL(fmt.Sprintf("/admin/user/temparte-warehouses?setup_file=%d", id)) }>{ fmt.Sprintf(i18n.T(lang, "warehouse.review.file"), id) }</a></li>
					}
				</ul>
			}
			<a href="/admin/user/temparte-warehouses" class="btn btn-secondary">{ i18n.T(lang, "warehouse.review.back") }</a>
		</div>
	}
}
