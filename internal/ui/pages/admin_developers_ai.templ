package pages

import (
	"fmt"
	"strings"

	platformadmin "github.com/moqasem061-dot/dawa24/internal/modules/platform_admin"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
)

// maskedAPIKey returns a display-safe version of an API key: "••••abcd" showing
// only the last 4 characters. An empty key returns empty (= not configured).
// The full secret must never appear in rendered HTML.
func maskedAPIKey(key string) string {
	if key == "" {
		return ""
	}
	if len(key) <= 4 {
		return "••••"
	}
	return "••••" + key[len(key)-4:]
}

type AIToolRow struct {
	Role         string
	NameAR       string
	Description  string
	DefaultModel string
	CurrentModel string
	IsActive     bool
	MaxTokens    int
	Notes        string
}

func getAIToolRows(configured []*platformadmin.AIRoleModel) []AIToolRow {
	byRole := make(map[string]*platformadmin.AIRoleModel, len(configured))
	for _, m := range configured {
		byRole[m.Role] = m
	}

	tools := []struct {
		role, name, desc, defModel string
	}{
		{"matching.vendor_import", "مطابقة استيراد المورد", "مطابقة أصناف ملفات الموردين مع الكتالوج (/vendor/ingest)", "qwen3.7-flash"},
		{"matching.saving_products", "مطابقة منتجات التوفير", "مطابقة وتحديد بدائل التوفير المتاحة في عروض الموردين", "qwen3.7-flash"},
		{"matching.smart_order", "الطلب الذكي بالذكاء الاصطناعي", "تحليل ومطابقة نواقص الطلب الذكي للصيدليات (/customer/smart-order)", "qwen3.7-flash"},
		{"matching.admin_catalog", "استيراد دليل الإدارة", "مطابقة استيراد الكتالوج العام للمنصة (/admin/products/import)", "qwen3.7-flash"},
		{"matching.adjudicate", "المطابقة العامة الافتراضية", "النموذج البديل عند عدم تعيين نموذج مخصص لأدوات المطابقة", "qwen3.7-flash"},
		{"assistant.primary", "المساعد الذكي الأساسي", "المحادثة والتفاعل المباشر وقراءة الصور", "gemma-4-31b-it"},
		{"assistant.attachment", "تحليل مرفقات المساعد", "معالجة الملفات والمستندات والجداول المرفقة في المحادثة", "gemma-4-31b-it"},
		{"assistant.transcribe", "التفريغ الصوتي للمحادثات", "تحويل الرسائل الصوتية إلى نصوص دقيقة", "whisper-large-v3-turbo"},
		{"import.detect_columns", "كشف أعمدة الملفات", "التعرف التلقائي على رؤوس أعمدة الجداول المستوردة", "qwen3.7-flash"},
		{"search.expand_query", "توسيع البحث بالمرادفات", "توليد مرادفات دوائية بديلة للبحث", "qwen3.7-flash"},
		{"support.classify", "تصنيف تذاكر الدعم", "التصنيف والتحليل التلقائي لطلبات الدعم الفني", "qwen3.7-flash"},
	}

	rows := make([]AIToolRow, 0, len(tools))
	for _, t := range tools {
		row := AIToolRow{
			Role:         t.role,
			NameAR:       t.name,
			Description:  t.desc,
			DefaultModel: t.defModel,
			CurrentModel: t.defModel,
			IsActive:     true,
			MaxTokens:    0,
		}
		if found, ok := byRole[t.role]; ok {
			if found.Model != "" {
				row.CurrentModel = found.Model
			}
			row.IsActive = found.IsActive
			if found.MaxTokens != nil {
				row.MaxTokens = *found.MaxTokens
			}
			row.Notes = found.Notes
		}
		rows = append(rows, row)
	}
	return rows
}

templ AdminDevelopersAITab(values AdminDevelopersValues, lang string) {
	{{
		_, storedPass := values.GatewaySettings.AdminCredentials()
		hasStoredPassword := storedPass != ""
	}}
	<div
		x-show="activeTab === 'ai'"
		class="stack-lg"
		x-data={ fmt.Sprintf("adminAIManager(%q, %q, %t)", values.GatewaySettings.EndpointURL, "", hasStoredPassword) }
		x-cloak
	>
		<!-- 1. الاتصال: Gateway Connection & Credentials -->
		<div class="glass-panel mb-6">
			<div class="flex-between items-center mb-5 pb-3 border-b">
				<div class="row-center">
					<div class="b2b-icon-box">
						@components.IconSparkles("icon-sm")
					</div>
					<div class="stack-sm">
						<h3 class="m-0 text-lg font-black">
							1. الاتصال ببوابة الذكاء الاصطناعي (AI Gateway Connection)
						</h3>
						<p class="text-xs text-secondary mt-0.5 mb-0">
							نقطة النهاية، بيانات اعتماد المدير، والمفتاح الافتراضي الخاص بإدارة المنصة.
						</p>
					</div>
				</div>
				if values.GatewaySettings.IsActive {
					<span class="badge badge-emerald">البوابة مفعلة</span>
				} else {
					<span class="badge badge-slate">معطلة</span>
				}
			</div>

			if values.GatewaySettings.CredentialLooksMisconfigured() {
				<div class="bg-danger-subtle border border-danger rounded-xl p-4 text-sm leading-relaxed mb-4">
					<strong class="text-danger block mb-1">بيانات الاعتماد المحفوظة تبدو غير صحيحة</strong>
					<span class="text-secondary">
						القيمة المحفوظة في حقل بيانات اعتماد المدير تطابق شكل بيانات اتصال قاعدة بيانات، وليست بيانات اعتماد بوابة الذكاء الاصطناعي.
					</span>
				</div>
			}

			<form action="/admin/developers/ai" method="POST" class="stack-md">
				<div class="d-grid grid-cols-2 gap-4">
					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">رابط بوابة الذكاء الاصطناعي (Endpoint URL) *</label>
						<input
							type="url"
							name="endpoint_url"
							x-model="gatewayURL"
							required
							class="form-input text-sm"
							dir="ltr"
							placeholder="https://api.dawa24.com"
						/>
					</div>

					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">حالة البوابة العامة</label>
						<select name="is_active" class="form-select text-sm">
							<option value="true" selected?={ values.GatewaySettings.IsActive }>مفعلة (Active)</option>
							<option value="false" selected?={ !values.GatewaySettings.IsActive }>معطلة (Disabled)</option>
						</select>
					</div>
				</div>

				<div class="d-grid grid-cols-2 gap-4">
					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">اسم مستخدم مدير البوابة (Admin Username) *</label>
						<input
							type="text"
							name="admin_username"
							x-model="gatewayUser"
							required
							class="form-input text-sm"
							dir="ltr"
							placeholder="admin"
						/>
						if values.GatewayAdminMasked != "" {
							<div class="d-flex items-center gap-2 mt-1 text-xs text-muted">
								<span>اسم المستخدم المحفوظ:</span>
								@components.RevealField("gateway.admin_username", 0, values.GatewayAdminMasked, values.CanRevealGateway, lang)
							</div>
						}
					</div>

					<div class="form-group m-0">
						<label class="form-label font-bold text-xs">كلمة مرور مدير البوابة (Admin Password)</label>
						<div class="relative d-flex items-center">
							<input
								:type="showKey ? 'text' : 'password'"
								name="api_key"
								x-model="gatewayKey"
								class="form-input pe-12 text-sm"
								dir="ltr"
								:placeholder="hasStoredPassword ? '••••••••  (اترك الحقل فارغاً للاحتفاظ بكلمة المرور الحالية)' : 'كلمة مرور لوحة البوابة...'"
								autocomplete="new-password"
							/>
							<button
								type="button"
								@click="showKey = !showKey"
								class="absolute end-3 bg-transparent border-0 text-muted cursor-pointer text-xs font-bold"
								x-text="showKey ? 'إخفاء' : 'إظهار'"
							></button>
						</div>
					</div>
				</div>

				<div class="p-3 border rounded-lg bg-surface-sunken flex-between items-center text-xs">
					<div class="d-flex items-center gap-2">
						<span class="font-bold">حالة مفتاح الاعتماد للنظام:</span>
						if values.GatewaySettings.VirtualKey != "" {
							<span class="badge badge-emerald text-xs font-bold">معتمد ومضبوط تلقائياً</span>
						} else {
							<span class="badge badge-amber text-xs font-bold">يتم التوليد والربط تلقائياً عبر البوابة</span>
						}
					</div>
					<div class="d-flex gap-2 items-center">
						<button
							type="button"
							class="btn btn-secondary btn-sm font-bold gap-1"
							@click="testConnection()"
							:disabled="isTesting"
						>
							@components.IconSparkles("icon-xs")
							<span x-show="!isTesting">اختبار الاتصال المباشر</span>
							<span x-show="isTesting">جاري الفحص...</span>
						</button>
						<button type="submit" class="btn btn-primary btn-sm font-bold gap-1">
							@components.IconCheck("icon-xs")
							<span>حفظ بيانات الاتصال</span>
						</button>
					</div>
				</div>
				<div x-show="testResult" class="mt-1" x-cloak>
					<div
						:class="testResult && testResult.status === 'healthy' ? 'badge badge-emerald w-full p-2 justify-center' : 'badge badge-rose w-full p-2 justify-center'"
						x-text="testResult ? testResult.message : ''"
					></div>
				</div>
			</form>
		</div>

		<!-- 2. النماذج: Per-tool Model Configuration Table -->
		<div class="glass-panel mb-6">
			<div class="flex-between items-center mb-4 pb-3 border-b">
				<div class="row-center">
					<div class="b2b-icon-box">
						@components.IconSettings("icon-sm")
					</div>
					<div class="stack-sm">
						<h3 class="m-0 text-lg font-black">
							2. النماذج والأدوار (Tool AI Models)
						</h3>
						<p class="text-xs text-secondary mt-0.5 mb-0">
							تخصيص نموذج الذكاء الاصطناعي لكل أداة بالمنظومة مع دعم الاكتشاف الحي والتعطيل المستقل.
						</p>
					</div>
				</div>
				<button
					type="button"
					class="btn btn-secondary btn-sm font-bold gap-1"
					@click="refreshModels()"
					:disabled="isLoadingModels"
				>
					<span x-show="!isLoadingModels">تحديث قائمة النماذج الحية</span>
					<span x-show="isLoadingModels">جاري الجلب...</span>
				</button>
			</div>

			<div class="table-responsive">
				<table class="table w-full align-middle text-sm">
					<thead>
						<tr class="text-xs text-secondary bg-surface-sunken">
							<th class="py-2.5 px-3">الأداة والمهمة</th>
							<th class="py-2.5 px-3">الدور (Role Key)</th>
							<th class="py-2.5 px-3 s-min-w-200">النموذج المعتمد (Model)</th>
							<th class="py-2.5 px-3 s-w-120">الحد الأقصى للرموز</th>
							<th class="py-2.5 px-3 text-center s-w-80">الحالة</th>
							<th class="py-2.5 px-3 text-center s-w-90">الإجراء</th>
						</tr>
					</thead>
					<tbody>
						for _, tool := range getAIToolRows(values.AIRoleModels) {
							{{ formID := "form-role-" + strings.ReplaceAll(tool.Role, ".", "-") }}
							<tr class="border-b hover:bg-surface-subtle">
								<td class="py-3 px-3">
									<form
										id={ formID }
										action="/admin/developers/ai/role-models"
										method="POST"
										@submit.prevent={ "saveRoleModel('" + tool.Role + "', $el)" }
									>
										<input type="hidden" name="role" value={ tool.Role }/>
									</form>
									<div class="font-bold text-primary">{ tool.NameAR }</div>
									<div class="text-xs text-muted mt-0.5">{ tool.Description }</div>
									<div x-show={ "roleError && savingRole === '' && savedRole !== '" + tool.Role + "'" } x-cloak class="text-2xs text-danger mt-1"></div>
								</td>
								<td class="py-3 px-3">
									<code class="text-xs bg-surface-sunken px-1.5 py-0.5 rounded" dir="ltr">{ tool.Role }</code>
								</td>
								<td class="py-3 px-3">
									<div class="stack-xs">
										<input
											type="text"
											name="model"
											form={ formID }
											value={ tool.CurrentModel }
											list="available-models-list"
											class="form-input text-xs"
											dir="ltr"
											required
											placeholder={ tool.DefaultModel }
										/>
										<span class="text-xs text-muted" dir="ltr">افتراضي: { tool.DefaultModel }</span>
									</div>
								</td>
								<td class="py-3 px-3">
									<input
										type="number"
										name="max_tokens"
										form={ formID }
										value={ fmt.Sprintf("%d", tool.MaxTokens) }
										placeholder="تلقائي"
										min="0"
										max="65536"
										class="form-input text-xs text-center"
										dir="ltr"
									/>
								</td>
								<td class="py-3 px-3 text-center">
									<label class="d-inline-flex items-center cursor-pointer">
										<input
											type="checkbox"
											name="is_active"
											form={ formID }
											value="true"
											class="form-checkbox"
											checked?={ tool.IsActive }
										/>
									</label>
								</td>
								<td class="py-3 px-3 text-center">
									<button
										type="submit"
										form={ formID }
										class="btn btn-primary btn-sm px-2.5 py-1 text-xs font-bold gap-1"
										:disabled={ "savingRole === '" + tool.Role + "'" }
									>
										@components.IconCheck("icon-xs")
										<span x-show={ "savingRole !== '" + tool.Role + "' && savedRole !== '" + tool.Role + "'" }>حفظ</span>
										<span x-show={ "savingRole === '" + tool.Role + "'" } x-cloak>جاري الحفظ...</span>
										<span x-show={ "savedRole === '" + tool.Role + "'" } x-cloak class="text-emerald-300">تم الحفظ ✓</span>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<datalist id="available-models-list">
				<template x-for="m in liveModels" :key="m.id">
					<option :value="m.id" x-text="m.display_name || m.id"></option>
				</template>
			</datalist>
		</div>

		@AdminDevelopersAICeilingsAndLogs()
	</div>
}
