package pages

import (
	"encoding/json"
	"fmt"
	"strconv"

	"github.com/moqasem061-dot/dawa24/internal/modules/org"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
)

templ adminWarehouseCreateModal(data AdminWarehousesData, lang string) {
	@components.Modal(components.ModalProps{
		ID:    "admin-warehouse-create-modal",
		Title: i18n.T(lang, "admin.wh.create"),
		Size:  "lg",
	}) {
		<script nonce={ templ.GetNonce(ctx) }>
			// Registered for Alpine CSP compatibility
			dawaData('adminWarehouseCreateState', function (allOrgs, allBranches) {
				return {
					orgs: allOrgs || [],
					branches: allBranches || [],
					selectedOrgId: '',
					selectedOrgName: '',
					orgSearchQuery: '',
					isOrgDropdownOpen: false,
					selectedBranchId: '',
					availableBranchesCount: 0,

					get filteredOrgs() {
						if (!this.orgSearchQuery) return this.orgs.slice(0, 40);
						const q = this.orgSearchQuery.toLowerCase().trim();
						return this.orgs.filter(o => 
							(o.name && o.name.toLowerCase().includes(q)) ||
							(o.id && o.id.includes(q)) ||
							(o.typeLabel && o.typeLabel.toLowerCase().includes(q))
						).slice(0, 40);
					},

					selectOrg(org) {
						this.selectedOrgId = String(org.id);
						this.selectedOrgName = org.name;
						this.orgSearchQuery = org.name + ' (#' + org.id + ')';
						this.isOrgDropdownOpen = false;
						this.selectedBranchId = '';

						const select = this.$refs.branchSelect;
						if (select) {
							while (select.options.length > 1) {
								select.remove(1);
							}
							const orgBranches = this.branches.filter(b => String(b.orgId) === String(org.id));
							this.availableBranchesCount = orgBranches.length;
							orgBranches.forEach(b => {
								const opt = document.createElement('option');
								opt.value = b.id;
								opt.textContent = b.name + ' (#' + b.id + ')';
								select.appendChild(opt);
							});
						}
					},

					clearOrg() {
						this.selectedOrgId = '';
						this.selectedOrgName = '';
						this.orgSearchQuery = '';
						this.isOrgDropdownOpen = false;
						this.selectedBranchId = '';
						this.availableBranchesCount = 0;
						const select = this.$refs.branchSelect;
						if (select) {
							while (select.options.length > 1) {
								select.remove(1);
							}
						}
					},

					onBranchChange() {
						const found = this.branches.find(b => String(b.id) === String(this.selectedBranchId));
						if (found) {
							if (this.$refs.phone && !this.$refs.phone.value && found.phone) {
								this.$refs.phone.value = found.phone;
							}
							if (this.$refs.address && !this.$refs.address.value && found.address) {
								this.$refs.address.value = found.address;
							}
						}
					}
				};
			});
		</script>
		<div
			x-data={ components.AlpineCall("adminWarehouseCreateState", json.RawMessage(organizationsToJSON(data.Organizations, lang)), json.RawMessage(branchesToJSON(data.Branches, lang))) }
			class="stack-md"
		>
			<form method="POST" action={ templ.SafeURL("/admin/warehouses/new?" + data.QueryValues().Encode()) } class="stack-md">
				<div class="grid-2 gap-4">
					<!-- Searchable Organization Selector with Dropdown Results Window -->
					<div class="stack-xs relative" @click.outside="isOrgDropdownOpen = false">
						<label class="form-label text-xs font-bold text-primary">
							{ i18n.T(lang, "admin.wh.col_owner") } <span class="text-danger">*</span>
						</label>
						<!-- Hidden input submitted with the form -->
						<input type="hidden" name="organization_id" :value="selectedOrgId" required />
						<div class="relative">
							<input
								type="text"
								x-model="orgSearchQuery"
								@focus="isOrgDropdownOpen = true"
								@input="isOrgDropdownOpen = true"
								@keydown.escape="isOrgDropdownOpen = false"
								placeholder="ابحث باسم المنشأة أو رقمها (ID)..."
								class="form-input w-full text-xs font-semibold pe-7"
								autocomplete="off"
							/>
							<button
								type="button"
								x-show="orgSearchQuery"
								x-cloak
								@click="clearOrg"
								class="btn-reset absolute top-1/2 -translate-y-1/2 end-2 text-muted hover:text-primary text-xs cursor-pointer p-1"
								title="مسح"
							>
								✕
							</button>
						</div>

						<!-- Autocomplete Results Window -->
						<div
							x-show="isOrgDropdownOpen && filteredOrgs.length > 0"
							x-cloak
							class="absolute z-50 start-0 end-0 top-full mt-1 max-h-60 overflow-y-auto bg-surface border rounded-xl shadow-xl py-1 text-xs s-min-w-240"
						>
							<template x-for="org in filteredOrgs" :key="org.id">
								<button
									type="button"
									@click="selectOrg(org)"
									class="w-full text-start px-3 py-2 hover:bg-surface-sunken flex items-center justify-between gap-2 border-0 bg-transparent cursor-pointer transition-colors"
								>
									<div class="d-flex items-center gap-1.5 truncate">
										<span class="font-bold text-primary truncate" x-text="org.name"></span>
										<span class="badge badge-slate text-2xs flex-shrink-0" x-text="org.typeLabel"></span>
									</div>
									<span class="badge badge-sky text-2xs tabular-nums flex-shrink-0" x-text="'#' + org.id"></span>
								</button>
							</template>
						</div>
						<span class="text-2xs text-danger" x-show="!selectedOrgId && orgSearchQuery" x-cloak>
							يرجى اختيار المنشأة من قائمة النتائج لتثبيت التحديد.
						</span>
					</div>

					<!-- Branch Selector that reacts immediately to chosen Organization -->
					<div class="stack-xs">
						<label class="form-label text-xs font-bold text-primary">
							{ i18n.T(lang, "admin.wh.col_branch") }
						</label>
						<select
							name="branch_id"
							x-ref="branchSelect"
							x-model="selectedBranchId"
							@change="onBranchChange"
							:disabled="!selectedOrgId"
							class="form-select w-full text-xs font-medium"
						>
							<option value="">مخزن عام للمنشأة (بدون فرع محدد)</option>
						</select>
						<span class="text-2xs text-muted" x-show="!selectedOrgId">
							اختر المنشأة أولاً لعرض الفروع التابعة لها.
						</span>
						<span class="text-2xs text-muted" x-show="selectedOrgId && availableBranchesCount === 0" x-cloak>
							لا توجد فروع مسجلة لهذه المنشأة (سيتم إنشاء المخزن كمخزن عام للمنشأة).
						</span>
						<span class="text-2xs text-success font-medium" x-show="selectedOrgId && availableBranchesCount > 0" x-cloak>
							<span x-text="'تم العثور على ' + availableBranchesCount + ' فرع للمنشأة - اختر الفرع المطلوب أو اتركه كمخزن عام.'"></span>
						</span>
					</div>
				</div>

				<div class="grid-2 gap-4">
					<div class="stack-xs">
						<label class="form-label text-xs font-bold text-primary">
							{ i18n.T(lang, "admin.wh.col_name") } <span class="text-danger">*</span>
						</label>
						<input
							type="text"
							name="name"
							required
							placeholder="مثال: المستودع الرئيسي، مخزن فرع المعادي..."
							class="form-input w-full text-xs font-semibold"
						/>
					</div>

					<div class="stack-xs">
						<label class="form-label text-xs font-bold text-primary">
							{ i18n.T(lang, "admin.wh.field_code") }
						</label>
						<input
							type="text"
							name="code"
							placeholder="WH-01 (يترك فارغاً للتوليد التلقائي)"
							class="form-input w-full text-xs font-mono"
						/>
					</div>
				</div>

				<div class="grid-2 gap-4">
					<div class="stack-xs">
						<label class="form-label text-xs font-bold text-primary">
							{ i18n.T(lang, "admin.wh.field_phone") }
						</label>
						<input
							type="text"
							name="phone"
							x-ref="phone"
							placeholder="01012345678"
							class="form-input w-full text-xs tabular-nums"
						/>
					</div>

					<div class="stack-xs">
						<label class="form-label text-xs font-bold text-primary">
							{ i18n.T(lang, "admin.wh.field_address") }
						</label>
						<input
							type="text"
							name="address"
							x-ref="address"
							placeholder="مثال: المنطقة الصناعية - قطعة 14 - القاهرة"
							class="form-input w-full text-xs"
						/>
					</div>
				</div>

				<div class="grid-2 gap-4 pt-1">
					<div class="stack-xs">
						<label class="form-label text-2xs text-secondary font-medium">خط العرض (Latitude)</label>
						<input
							type="number"
							step="any"
							name="latitude"
							placeholder="30.0444"
							class="form-input w-full text-xs tabular-nums"
						/>
					</div>

					<div class="stack-xs">
						<label class="form-label text-2xs text-secondary font-medium">خط الطول (Longitude)</label>
						<input
							type="number"
							step="any"
							name="longitude"
							placeholder="31.2357"
							class="form-input w-full text-xs tabular-nums"
						/>
					</div>
				</div>

				<div class="pt-2 border-t">
					<label class="d-flex items-center gap-2 text-xs font-bold text-primary cursor-pointer">
						<input
							type="checkbox"
							name="is_active"
							value="1"
							checked
							class="form-checkbox"
						/>
						<span>{ i18n.T(lang, "admin.wh.active") }</span>
					</label>
				</div>

				<div class="modal-footer pt-3 border-t d-flex justify-end gap-2">
					<button
						type="button"
						class="btn btn-secondary btn-sm font-bold"
						data-modal-close="admin-warehouse-create-modal"
					>
						{ i18n.T(lang, "common.cancel") }
					</button>
					<button type="submit" class="btn btn-primary btn-sm font-bold">
						{ i18n.T(lang, "common.save") }
					</button>
				</div>
			</form>
		</div>
	}
}

type orgItem struct {
	ID        string `json:"id"`
	Name      string `json:"name"`
	Type      string `json:"type"`
	TypeLabel string `json:"typeLabel"`
}

func organizationsToJSON(orgs []*org.Organization, lang string) string {
	items := make([]orgItem, 0, len(orgs))
	for _, o := range orgs {
		if o == nil {
			continue
		}
		name := o.LegalName
		if tn := o.TradeName.Get(i18n.Lang(lang)); tn != "" && tn != o.LegalName {
			name = fmt.Sprintf("%s (%s)", o.LegalName, tn)
		}
		typeLabel := i18n.TKey(lang, "org.type."+string(o.Type))
		items = append(items, orgItem{
			ID:        strconv.FormatInt(o.ID, 10),
			Name:      name,
			Type:      string(o.Type),
			TypeLabel: typeLabel,
		})
	}
	bytes, _ := json.Marshal(items)
	return string(bytes)
}

func branchesToJSON(branches []*org.Branch, lang string) string {
	type brItem struct {
		ID      string `json:"id"`
		OrgID   string `json:"orgId"`
		Name    string `json:"name"`
		Phone   string `json:"phone"`
		Address string `json:"address"`
	}
	items := make([]brItem, 0, len(branches))
	for _, b := range branches {
		if b == nil {
			continue
		}
		name := b.Name.Get(i18n.Lang(lang))
		if name == "" {
			name = b.Code
		}
		items = append(items, brItem{
			ID:      strconv.FormatInt(b.ID, 10),
			OrgID:   strconv.FormatInt(b.OrganizationID, 10),
			Name:    name,
			Phone:   b.Phone,
			Address: b.Address,
		})
	}
	bytes, _ := json.Marshal(items)
	return string(bytes)
}
