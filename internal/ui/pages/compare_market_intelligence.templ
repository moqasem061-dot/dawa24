package pages

import (
	"fmt"
	"net/url"

	"github.com/moqasem061-dot/dawa24/internal/modules/compare"
	"github.com/moqasem061-dot/dawa24/internal/platform/authctx"
	"github.com/moqasem061-dot/dawa24/internal/ui/components"
	"github.com/moqasem061-dot/dawa24/internal/ui/layouts"
)

// تقرير التوفير الاستراتيجي والتوصيات.
//
// Every number and every sentence on this page comes from compare.StrategicSavingReport,
// which is computed from the market as loaded. Nothing here has a hardcoded
// fallback: a section whose data is absent does not render, because a page that
// prints the same three recommendations on an empty market as on a full one
// teaches its reader to ignore it.

type MarketIntelligencePageData struct {
	Report *compare.StrategicSavingReport
	// Failed distinguishes "the report could not be built" from "the market is
	// empty". They look identical on screen and are entirely different problems.
	Failed        bool
	IsCustomer    bool
	IsAdmin       bool
	TargetOrgID   int64
	TargetOrgName string
	// Query filters ⚡ المنتجات ذات فارق الوفر الأكبر بالسوق by name/SKU/supplier.
	Query string
	// SingleQuery filters أصناف لدى مورد واحد فقط by name/SKU/supplier.
	SingleQuery string
}

func (d MarketIntelligencePageData) FileCenterURL() string {
	if d.IsAdmin && d.TargetOrgID > 0 {
		return fmt.Sprintf("/admin/organizations/import/%d/compare", d.TargetOrgID)
	}
	return "/compare/tool"
}

func (d MarketIntelligencePageData) SubtabURL(base string) string {
	vals := url.Values{}
	if d.IsAdmin && d.TargetOrgID > 0 {
		vals.Set("org_id", fmt.Sprintf("%d", d.TargetOrgID))
	}
	encoded := vals.Encode()
	if encoded == "" {
		return base
	}
	return base + "?" + encoded
}

func (d MarketIntelligencePageData) ClearQueryURL() string {
	vals := url.Values{}
	if d.SingleQuery != "" {
		vals.Set("q_single", d.SingleQuery)
	}
	if d.IsAdmin && d.TargetOrgID > 0 {
		vals.Set("org_id", fmt.Sprintf("%d", d.TargetOrgID))
	}
	if len(vals) == 0 {
		return "/compare/market-intelligence"
	}
	return "/compare/market-intelligence?" + vals.Encode()
}

func (d MarketIntelligencePageData) ClearSingleQueryURL() string {
	vals := url.Values{}
	if d.Query != "" {
		vals.Set("q", d.Query)
	}
	if d.IsAdmin && d.TargetOrgID > 0 {
		vals.Set("org_id", fmt.Sprintf("%d", d.TargetOrgID))
	}
	if len(vals) == 0 {
		return "/compare/market-intelligence"
	}
	return "/compare/market-intelligence?" + vals.Encode()
}

func insightTone(t compare.InsightTone) string {
	switch t {
	case compare.ToneGood:
		return "badge-emerald"
	case compare.ToneWarn:
		return "badge-amber"
	}
	return "badge-slate"
}

templ CompareMarketIntelligenceContent(data MarketIntelligencePageData) {
	<div class="page-container">
		@marketIntelHeader(data)
		if data.Failed {
			<div class="alert alert-danger mb-6">
				<span class="fw-800">تعذّر بناء التقرير</span>
				<span class="text-sm">حدث خطأ أثناء قراءة عروض السوق. أعد المحاولة، وإذا تكرر الخطأ راجع سجلات النظام.</span>
			</div>
		} else if data.Report == nil {
			<div class="alert alert-warning mb-6">
				<span class="fw-800">التقرير غير متاح حالياً</span>
			</div>
		} else {
			@marketIntelKPIs(data.Report)
			@marketIntelInsights("التحليل الاستراتيجي التلقائي", data.Report.Analysis)
			if data.Report.HasData() {
				@marketIntelSavingsTable(data)
				@marketIntelBestSupplier(data.Report)
				@marketIntelInsights("نصيحة استراتيجية", data.Report.Advice)
				@marketIntelInsights("⚡ توجيهات الشراء المثالي", data.Report.Guidance)
				@marketIntelExclusives(data)
			}
			@marketIntelCoverage(data.Report.Coverage)
		}
		@CompareMarketIntelligenceScript()
	</div>
}

templ marketIntelHeader(data MarketIntelligencePageData) {
	if data.IsAdmin {
		<div class="alert alert-info d-flex items-center justify-between gap-4 mb-4 s-callout-sky">
			<div class="d-flex items-center gap-3">
				<span class="badge badge-brand">وضع الإدارة العامة</span>
				<span class="text-sm font-bold">
					أنت تعرض تقرير ذكاء السوق بالنيابة عن منظمة:
					<span class="text-brand mr-1 font-black">{ data.TargetOrgName }</span>
					<span class="text-xs text-muted font-mono mr-1">(ID: { fmt.Sprintf("%d", data.TargetOrgID) })</span>
				</span>
			</div>
			<a href={ templ.SafeURL(data.FileCenterURL()) } class="btn btn-sm btn-secondary font-bold gap-2">
				@components.IconArrowLeft("icon-xs")
				<span>العودة لمركز ملفات المنظمة</span>
			</a>
		</div>
	}
	<div class="glass-panel p-6 mb-6">
		<div class="flex-between flex-wrap gap-4">
			<div class="stack-sm">
				<div class="d-flex items-center gap-3 mb-1">
					<div class="user-avatar-badge text-xl">
						@components.IconSparkles("icon-sm")
					</div>
					<h1 class="text-2xl font-black text-primary m-0">
						تقرير التوفير الاستراتيجي والتوصيات
					</h1>
				</div>
				<p class="text-sm text-secondary m-0">
					ما الذي يوفّره شراء كل صنف من أرخص مورد له، وأين تكمن أكبر الفوارق، ومن هو المورد الأفضل إجمالاً — محسوباً من عروض السوق الفعلية.
				</p>
			</div>
			<a href={ templ.SafeURL(data.FileCenterURL()) } class="btn btn-secondary font-bold gap-2">
				@components.IconArrowLeft("icon-xs")
				<span>مركز الملفات</span>
			</a>
		</div>
		<div class="tabs-nav mt-4">
			<a href={ templ.SafeURL(data.SubtabURL("/compare/results")) } class="tab-btn">المقارنة المجمعة بين الموردين</a>
			<a href={ templ.SafeURL(data.SubtabURL("/compare/head-to-head")) } class="tab-btn">مقارنة مورد بمورد</a>
			<a href={ templ.SafeURL(data.SubtabURL("/compare/market-benchmark")) } class="tab-btn">مقارنة مع موردي السوق</a>
			<a href={ templ.SafeURL(data.SubtabURL("/compare/market-intelligence")) } class="tab-btn active">تقرير ذكاء السوق</a>
		</div>
	</div>
}

templ marketIntelKPIs(r *compare.StrategicSavingReport) {
	<div class="dashboard-stat-grid mb-6">
		<div class="stat-card-3d">
			<div class="stat-card-label text-success">التكلفة المثلى (شراء مجزأ)</div>
			<div class="stat-card-value text-success tabular-nums">{ r.OptimalCost.String() }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				وحدة واحدة من كل صنف، من أرخص مورد له
			</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label text-danger">تكلفتك القصوى بالسوق</div>
			<div class="stat-card-value text-danger tabular-nums">{ r.WorstCost.String() }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				نفس السلة عند شراء كل صنف من أغلى مورد له
			</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label text-brand">الوفر الممكن</div>
			<div class="stat-card-value text-brand tabular-nums">{ r.PotentialSavings.String() }</div>
			<span class="text-xs text-secondary mt-1 d-block">
				{ fmt.Sprintf("%.1f%% من التكلفة القصوى", r.SavingsPercent) }
			</span>
		</div>
		<div class="stat-card-3d">
			<div class="stat-card-label">الأصناف القابلة للمقارنة</div>
			<div class="stat-card-value text-primary tabular-nums">
				{ fmt.Sprintf("%d", r.Coverage.ComparableProduct) }
			</div>
			<span class="text-xs text-secondary mt-1 d-block">
				{ fmt.Sprintf("من %d صنف مرصود لدى %d مورد", r.Coverage.Products, r.Coverage.Suppliers) }
			</span>
		</div>
	</div>
}

templ marketIntelInsights(title string, items []compare.Insight) {
	if len(items) > 0 {
		<div class="glass-panel p-6 mb-6">
			<h3 class="text-base font-extrabold text-primary m-0 mb-3">{ title }</h3>
			<div class="d-flex flex-col gap-3">
				for _, it := range items {
					<div class="d-flex items-start gap-3">
						<span class={ "badge", insightTone(it.Tone), "text-xs" }>
							if it.Tone == compare.ToneGood {
								فرصة
							} else if it.Tone == compare.ToneWarn {
								انتباه
							} else {
								معلومة
							}
						</span>
						<span class="text-sm text-secondary leading-relaxed">{ it.Text }</span>
					</div>
				}
			</div>
		</div>
	}
}

templ marketIntelSavingsTable(data MarketIntelligencePageData) {
	<div class="glass-panel p-0 mb-6 overflow-hidden" x-data="marketTableManager('table-savings')">
		<div class="p-4 px-6 border-b flex-between flex-wrap gap-3">
			<div class="stack-2xs">
				<h3 class="text-base font-extrabold text-primary m-0">
					⚡ المنتجات ذات فارق الوفر الأكبر بالسوق
				</h3>
				<p class="text-xs text-muted m-0 mt-1">
					مرتبة بقيمة الفارق للوحدة الواحدة، لا بالنسبة المئوية: فارق 9% على عبوة غالية يفوق فارق 60% على عبوة رخيصة.
				</p>
			</div>
			if len(data.Report.TopSavings) > 0 {
				<div class="d-flex items-center gap-2 flex-wrap">
					<span class="text-xs text-secondary tabular-nums font-bold" x-text="'عرض ' + visibleCount + ' من ' + totalCount + ' صنف'"></span>
					<button
						type="button"
						x-show="hasActiveFilters()"
						x-cloak
						@click="clearFilters()"
						class="btn btn-secondary btn-xs font-bold gap-1"
					>
						@components.IconX("icon-2xs")
						<span>مسح الفلاتر</span>
					</button>
				</div>
			}
		</div>
		if len(data.Report.TopSavings) == 0 {
			<div class="p-6 text-sm text-muted">
				if data.Query != "" {
					لا توجد نتائج مطابقة لبحثك في فارق الوفر. جرب كلمات أخرى أو امسح البحث.
				} else {
					لا يوجد صنف يتجاوز فيه فارق السعر بين الموردين 1%. السوق متقارب على الأصناف المقارَنة.
				}
			</div>
		} else {
			<div class="table-container">
				<table id="table-savings" class="data-table intel-spread-table">
					<thead>
						<tr>
							<th class="cursor-pointer select-none" @click="sortBy('name', 'str')" title="اضغط للفرز حسب اسم الصنف">
								<div class="d-flex items-center justify-between gap-2">
									<span>المنتج</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'name' }">
										<span x-show="sortCol !== 'name'">↕</span>
										<span x-show="sortCol === 'name' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'name' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-center cursor-pointer select-none" @click="sortBy('best-price', 'num')" title="اضغط للفرز حسب أفضل سعر">
								<div class="d-flex items-center justify-center gap-2">
									<span>العرض الأفضل (سعر وخصم)</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'best-price' }">
										<span x-show="sortCol !== 'best-price'">↕</span>
										<span x-show="sortCol === 'best-price' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'best-price' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-center cursor-pointer select-none" @click="sortBy('worst-price', 'num')" title="اضغط للفرز حسب أعلى سعر">
								<div class="d-flex items-center justify-center gap-2">
									<span>العرض الأعلى (سعر وخصم)</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'worst-price' }">
										<span x-show="sortCol !== 'worst-price'">↕</span>
										<span x-show="sortCol === 'worst-price' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'worst-price' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
						</tr>
						<!-- Column Filters Row -->
						<tr class="bg-surface-sunken">
							<th class="p-2">
								<div class="d-flex items-center gap-2 flex-wrap">
									<input
										type="text"
										placeholder="بحث بالاسم أو SKU..."
										class="form-input text-xs py-1 px-2.5 flex-1 table-col-filter"
										@input="setFilter('search', $event.target.value)"
									/>
									<select
										class="form-input text-xs py-1 px-2 table-col-filter w-auto"
										@change="setFilter('catalog', $event.target.value)"
									>
										<option value="all">كل الحالات</option>
										<option value="in_catalog">مرتبط بالكتالوج</option>
										<option value="name_matched">مطابقة بالاسم</option>
									</select>
									<button
										type="button"
										class="btn btn-secondary btn-xs font-bold py-1 px-2 whitespace-nowrap"
										@click="sortBy('diff', 'num')"
										title="فرز حسب قيمة الوفر"
									>
										<span>الوفر </span>
										<span x-show="sortCol === 'diff' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'diff' && sortDir === 'desc'">▼</span>
										<span x-show="sortCol !== 'diff'">↕</span>
									</button>
								</div>
							</th>
							<th class="p-2 text-center">
								<div class="d-flex items-center justify-center gap-2">
									<input
										type="text"
										placeholder="فلترة المورد الأفضل..."
										class="form-input text-xs py-1 px-2.5 w-full text-center table-col-filter"
										@input="setFilter('best-supplier', $event.target.value)"
									/>
									<button
										type="button"
										class="btn btn-secondary btn-xs font-bold py-1 px-2 whitespace-nowrap"
										@click="sortBy('best-discount', 'num')"
										title="فرز حسب نسبة الخصم الأفضل"
									>
										<span>خصم </span>
										<span x-show="sortCol === 'best-discount' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'best-discount' && sortDir === 'desc'">▼</span>
										<span x-show="sortCol !== 'best-discount'">↕</span>
									</button>
								</div>
							</th>
							<th class="p-2 text-center">
								<div class="d-flex items-center justify-center gap-2">
									<input
										type="text"
										placeholder="فلترة المورد الأعلى..."
										class="form-input text-xs py-1 px-2.5 w-full text-center table-col-filter"
										@input="setFilter('worst-supplier', $event.target.value)"
									/>
									<button
										type="button"
										class="btn btn-secondary btn-xs font-bold py-1 px-2 whitespace-nowrap"
										@click="sortBy('worst-discount', 'num')"
										title="فرز حسب نسبة الخصم الأعلى"
									>
										<span>خصم </span>
										<span x-show="sortCol === 'worst-discount' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'worst-discount' && sortDir === 'desc'">▼</span>
										<span x-show="sortCol !== 'worst-discount'">↕</span>
									</button>
								</div>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, it := range data.Report.TopSavings {
							<tr
								data-row="true"
								data-name={ it.ProductName }
								data-sku={ it.SKU }
								data-search={ fmt.Sprintf("%s %s", it.ProductName, it.SKU) }
								data-catalog={ ifElseStr(it.InCatalog, "in_catalog", "name_matched") }
								data-diff={ fmt.Sprintf("%d", it.PriceDifference.Minor()) }
								data-percent={ fmt.Sprintf("%.2f", it.PricePercent) }
								data-best-supplier={ it.BestSupplier }
								data-best-price={ fmt.Sprintf("%d", it.BestNet.Minor()) }
								data-best-discount={ fmt.Sprintf("%.2f", it.BestDiscount) }
								data-worst-supplier={ it.WorstSupplier }
								data-worst-price={ fmt.Sprintf("%d", it.WorstNet.Minor()) }
								data-worst-discount={ fmt.Sprintf("%.2f", it.WorstDiscount) }
							>
								<td>
									<div class="fw-800 text-sm">{ it.ProductName }</div>
									<div class="text-xs text-muted tabular-nums mt-1">
										if it.SKU != "" {
											<span>SKU: { it.SKU }</span>
										} else {
											<span>SKU: —</span>
										}
									</div>
									<div class="d-flex items-center gap-2 mt-1 flex-wrap">
										if it.InCatalog {
											<span class="badge badge-emerald text-xs">مرتبط بالكتالوج</span>
										} else {
											<span class="badge badge-slate text-xs">مطابقة بالاسم</span>
										}
										<span class="text-xs text-muted tabular-nums">الوفر: { it.PriceDifference.String() } ({ fmt.Sprintf("%.1f%%", it.PricePercent) }) · { fmt.Sprintf("%d مورد", it.SupplierCount) }</span>
									</div>
								</td>
								<td class="text-center tabular-nums">
									<span class="intel-best-price">{ it.BestNet.String() }</span>
									<span class="intel-best-disc">({ fmt.Sprintf("%.1f%%", it.BestDiscount) })</span>
									<div class="text-xs text-muted mt-1">{ it.BestSupplier }</div>
								</td>
								<td class="text-center tabular-nums">
									<span class="intel-worst-price">{ it.WorstNet.String() }</span>
									<span class="intel-worst-disc">({ fmt.Sprintf("%.1f%%", it.WorstDiscount) })</span>
									<div class="text-xs text-muted mt-1">{ it.WorstSupplier }</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
				<div class="table-filter-empty p-6 text-center text-sm text-muted hidden">
					لا توجد أصناف تطابق الفلاتر المحددة.
				</div>
			</div>
		}
	</div>
}

templ marketIntelBestSupplier(r *compare.StrategicSavingReport) {
	if r.BestSupplier != nil {
		<div class="glass-panel p-6 mb-6" x-data="marketTableManager('table-standings')">
			<div class="flex-between flex-wrap gap-3 mb-1">
				<h3 class="text-base font-extrabold text-primary m-0">المورد الأفضل إجمالاً</h3>
				<div class="d-flex items-center gap-2 flex-wrap">
					<span class="text-xs text-secondary tabular-nums font-bold" x-text="'عرض ' + visibleCount + ' من ' + totalCount + ' مورد'"></span>
					<button
						type="button"
						x-show="hasActiveFilters()"
						x-cloak
						@click="clearFilters()"
						class="btn btn-secondary btn-xs font-bold gap-1"
					>
						@components.IconX("icon-2xs")
						<span>مسح الفلاتر</span>
					</button>
				</div>
			</div>
			<p class="text-xs text-muted m-0 mb-4">
				ليس صاحب أكبر خصم ولا صاحب أكثر الأصناف، بل من تكلف سلة ما يعرضه أقل ما يمكن مقارنةً بأفضل أسعار السوق لنفس السلة.
			</p>
			<div class="d-flex items-center gap-3 mb-4">
				<div class="user-avatar-badge text-xl">@components.IconStar("icon-sm")</div>
				<div class="stack-sm">
					<div class="text-xl font-black text-brand">{ r.BestSupplier.SupplierName }</div>
					<div class="text-xs text-secondary">
						{ fmt.Sprintf("%d صنف مقارَن · الأرخص في %d منها (%.0f%%) · متوسط خصم %.1f%%",
							r.BestSupplier.Offers, r.BestSupplier.Wins, r.BestSupplier.WinRate, r.BestSupplier.AvgDiscount) }
					</div>
				</div>
			</div>
			<div class="table-container">
				<table id="table-standings" class="data-table">
					<thead>
						<tr>
							<th class="cursor-pointer select-none" @click="sortBy('supplier', 'str')" title="اضغط للفرز">
								<div class="d-flex items-center justify-between gap-1">
									<span>المورد</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'supplier' }">
										<span x-show="sortCol !== 'supplier'">↕</span>
										<span x-show="sortCol === 'supplier' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'supplier' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-end cursor-pointer select-none" @click="sortBy('offers', 'num')" title="اضغط للفرز">
								<div class="d-flex items-center justify-end gap-1">
									<span>أصناف مقارَنة</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'offers' }">
										<span x-show="sortCol !== 'offers'">↕</span>
										<span x-show="sortCol === 'offers' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'offers' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-end cursor-pointer select-none" @click="sortBy('wins', 'num')" title="اضغط للفرز">
								<div class="d-flex items-center justify-end gap-1">
									<span>الأرخص في</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'wins' }">
										<span x-show="sortCol !== 'wins'">↕</span>
										<span x-show="sortCol === 'wins' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'wins' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-end cursor-pointer select-none" @click="sortBy('premium', 'num')" title="اضغط للفرز">
								<div class="d-flex items-center justify-end gap-1">
									<span>متوسط الفارق</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'premium' }">
										<span x-show="sortCol !== 'premium'">↕</span>
										<span x-show="sortCol === 'premium' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'premium' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-end cursor-pointer select-none" @click="sortBy('discount', 'num')" title="اضغط للفرز">
								<div class="d-flex items-center justify-end gap-1">
									<span>متوسط الخصم</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'discount' }">
										<span x-show="sortCol !== 'discount'">↕</span>
										<span x-show="sortCol === 'discount' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'discount' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-end cursor-pointer select-none" @click="sortBy('basket-cost', 'num')" title="اضغط للفرز">
								<div class="d-flex items-center justify-end gap-1">
									<span>تكلفة سلته</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'basket-cost' }">
										<span x-show="sortCol !== 'basket-cost'">↕</span>
										<span x-show="sortCol === 'basket-cost' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'basket-cost' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
							<th class="text-end cursor-pointer select-none" @click="sortBy('excess', 'num')" title="اضغط للفرز">
								<div class="d-flex items-center justify-end gap-1">
									<span>الفائض عن الأمثل</span>
									<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'excess' }">
										<span x-show="sortCol !== 'excess'">↕</span>
										<span x-show="sortCol === 'excess' && sortDir === 'asc'">▲</span>
										<span x-show="sortCol === 'excess' && sortDir === 'desc'">▼</span>
									</span>
								</div>
							</th>
						</tr>
						<!-- Filter Row -->
						<tr class="bg-surface-sunken">
							<th class="p-2" colspan="2">
								<input
									type="text"
									placeholder="فلترة باسم المورد..."
									class="form-input text-xs py-1 px-2.5 w-full table-col-filter"
									@input="setFilter('supplier', $event.target.value)"
								/>
							</th>
							<th class="p-2 text-end" colspan="5">
								<span class="text-xs text-muted">انقر فوق أي رأس عامود للفرز التصاعدي أو التنازلي</span>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, st := range r.Standings {
							<tr
								data-row="true"
								data-supplier={ st.SupplierName }
								data-offers={ fmt.Sprintf("%d", st.Offers) }
								data-wins={ fmt.Sprintf("%d", st.Wins) }
								data-win-rate={ fmt.Sprintf("%.2f", st.WinRate) }
								data-premium={ fmt.Sprintf("%.4f", st.AvgPremium) }
								data-discount={ fmt.Sprintf("%.2f", st.AvgDiscount) }
								data-basket-cost={ fmt.Sprintf("%d", st.BasketCost.Minor()) }
								data-excess={ fmt.Sprintf("%d", st.Excess().Minor()) }
							>
								<td class="fw-800">{ st.SupplierName }</td>
								<td class="text-end tabular-nums">{ fmt.Sprintf("%d", st.Offers) }</td>
								<td class="text-end tabular-nums">{ fmt.Sprintf("%d (%.0f%%)", st.Wins, st.WinRate) }</td>
								<td class="text-end tabular-nums">
									if st.AvgPremium <= 0.05 {
										<span class="badge badge-emerald text-xs">الأفضل</span>
									} else {
										{ fmt.Sprintf("+%.1f%%", st.AvgPremium) }
									}
								</td>
								<td class="text-end tabular-nums">{ fmt.Sprintf("%.1f%%", st.AvgDiscount) }</td>
								<td class="text-end tabular-nums">{ st.BasketCost.String() }</td>
								<td class="text-end tabular-nums text-danger">{ st.Excess().String() }</td>
							</tr>
						}
					</tbody>
				</table>
				<div class="table-filter-empty p-6 text-center text-sm text-muted hidden">
					لا يوجد موردون يطابقون الفلتر.
				</div>
			</div>
		</div>
	}
}

templ marketIntelExclusives(data MarketIntelligencePageData) {
	if len(data.Report.Exclusives) > 0 || data.SingleQuery != "" {
		<div class="glass-panel p-0 mb-6 overflow-hidden" x-data="marketTableManager('table-exclusives')">
			<div class="p-4 px-6 border-b flex-between flex-wrap gap-3">
				<div class="stack-2xs">
					<h3 class="text-base font-extrabold text-primary m-0">أصناف لدى مورد واحد فقط</h3>
					<p class="text-xs text-muted m-0 mt-1">
						لا تقبل المقارنة السعرية. أعلاها قيمة أولاً، فهي أكبر تعرّض تفاوضي.
					</p>
				</div>
				if len(data.Report.Exclusives) > 0 {
					<div class="d-flex items-center gap-2 flex-wrap">
						<span class="text-xs text-secondary tabular-nums font-bold" x-text="'عرض ' + visibleCount + ' من ' + totalCount + ' صنف'"></span>
						<button
							type="button"
							x-show="hasActiveFilters()"
							x-cloak
							@click="clearFilters()"
							class="btn btn-secondary btn-xs font-bold gap-1"
						>
							@components.IconX("icon-2xs")
							<span>مسح الفلاتر</span>
						</button>
					</div>
				}
			</div>
			if len(data.Report.Exclusives) == 0 {
				<div class="p-6 text-sm text-muted">
					لا توجد نتائج مطابقة لبحثك في أصناف المورد الواحد. جرب كلمات أخرى أو امسح البحث.
				</div>
			} else {
				<div class="table-container">
					<table id="table-exclusives" class="data-table">
						<thead>
							<tr>
								<th class="cursor-pointer select-none" @click="sortBy('name', 'str')" title="اضغط للفرز حسب اسم الصنف">
									<div class="d-flex items-center justify-between gap-1">
										<span>اسم الصنف</span>
										<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'name' }">
											<span x-show="sortCol !== 'name'">↕</span>
											<span x-show="sortCol === 'name' && sortDir === 'asc'">▲</span>
											<span x-show="sortCol === 'name' && sortDir === 'desc'">▼</span>
										</span>
									</div>
								</th>
								<th class="cursor-pointer select-none" @click="sortBy('sku', 'str')" title="اضغط للفرز حسب الكود">
									<div class="d-flex items-center justify-between gap-1">
										<span>الكود</span>
										<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'sku' }">
											<span x-show="sortCol !== 'sku'">↕</span>
											<span x-show="sortCol === 'sku' && sortDir === 'asc'">▲</span>
											<span x-show="sortCol === 'sku' && sortDir === 'desc'">▼</span>
										</span>
									</div>
								</th>
								<th class="cursor-pointer select-none" @click="sortBy('supplier', 'str')" title="اضغط للفرز حسب المورد">
									<div class="d-flex items-center justify-between gap-1">
										<span>المورد الوحيد</span>
										<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'supplier' }">
											<span x-show="sortCol !== 'supplier'">↕</span>
											<span x-show="sortCol === 'supplier' && sortDir === 'asc'">▲</span>
											<span x-show="sortCol === 'supplier' && sortDir === 'desc'">▼</span>
										</span>
									</div>
								</th>
								<th class="text-end cursor-pointer select-none" @click="sortBy('price', 'num')" title="اضغط للفرز حسب السعر">
									<div class="d-flex items-center justify-end gap-1">
										<span>السعر النهائي</span>
										<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'price' }">
											<span x-show="sortCol !== 'price'">↕</span>
											<span x-show="sortCol === 'price' && sortDir === 'asc'">▲</span>
											<span x-show="sortCol === 'price' && sortDir === 'desc'">▼</span>
										</span>
									</div>
								</th>
								<th class="text-end cursor-pointer select-none" @click="sortBy('discount', 'num')" title="اضغط للفرز حسب الخصم">
									<div class="d-flex items-center justify-end gap-1">
										<span>الخصم</span>
										<span class="text-2xs font-mono" :class="{ 'text-brand font-black': sortCol === 'discount' }">
											<span x-show="sortCol !== 'discount'">↕</span>
											<span x-show="sortCol === 'discount' && sortDir === 'asc'">▲</span>
											<span x-show="sortCol === 'discount' && sortDir === 'desc'">▼</span>
										</span>
									</div>
								</th>
							</tr>
							<!-- Filter Row -->
							<tr class="bg-surface-sunken">
								<th class="p-2">
									<input
										type="text"
										placeholder="فلترة بالاسم..."
										class="form-input text-xs py-1 px-2.5 w-full table-col-filter"
										@input="setFilter('name', $event.target.value)"
									/>
								</th>
								<th class="p-2">
									<input
										type="text"
										placeholder="فلترة بالكود..."
										class="form-input text-xs py-1 px-2.5 w-full table-col-filter"
										@input="setFilter('sku', $event.target.value)"
									/>
								</th>
								<th class="p-2">
									<input
										type="text"
										placeholder="فلترة بالمورد..."
										class="form-input text-xs py-1 px-2.5 w-full table-col-filter"
										@input="setFilter('supplier', $event.target.value)"
									/>
								</th>
								<th class="p-2" colspan="2"></th>
							</tr>
						</thead>
						<tbody>
							for _, it := range data.Report.Exclusives {
								<tr
									data-row="true"
									data-name={ it.ProductName }
									data-sku={ it.SKU }
									data-supplier={ it.BestSupplier }
									data-price={ fmt.Sprintf("%d", it.BestNet.Minor()) }
									data-discount={ fmt.Sprintf("%.2f", it.BestDiscount) }
								>
									<td class="fw-800">{ it.ProductName }</td>
									<td class="text-xs text-muted tabular-nums">
										if it.SKU != "" {
											{ it.SKU }
										} else {
											—
										}
									</td>
									<td class="text-sm">{ it.BestSupplier }</td>
									<td class="text-end tabular-nums fw-800">{ it.BestNet.String() }</td>
									<td class="text-end tabular-nums">{ fmt.Sprintf("%.1f%%", it.BestDiscount) }</td>
								</tr>
							}
						</tbody>
					</table>
					<div class="table-filter-empty p-6 text-center text-sm text-muted hidden">
						لا توجد أصناف حصرية تطابق الفلتر.
					</div>
				</div>
			}
		</div>
	}
}

templ CompareMarketIntelligenceScript() {
	<script nonce={ layouts.Nonce(ctx) }>
		function marketTableManager(tableId) {
			return {
				sortCol: '',
				sortDir: 'asc',
				filters: {},
				visibleCount: 0,
				totalCount: 0,

				init() {
					this.updateCounts();
				},

				updateCounts() {
					const table = document.getElementById(tableId);
					if (!table) return;
					const rows = table.querySelectorAll('tbody tr[data-row]');
					this.totalCount = rows.length;
					let vis = 0;
					rows.forEach(r => {
						if (r.style.display !== 'none') vis++;
					});
					this.visibleCount = vis;
				},

				setFilter(key, val) {
					this.filters[key] = (val || '').toLowerCase().trim();
					this.applyFilters();
				},

				clearFilters() {
					this.filters = {};
					const table = document.getElementById(tableId);
					if (!table) return;
					table.querySelectorAll('.table-col-filter').forEach(el => el.value = '');
					this.applyFilters();
				},

				hasActiveFilters() {
					return Object.values(this.filters).some(v => v !== '');
				},

				applyFilters() {
					const table = document.getElementById(tableId);
					if (!table) return;
					const rows = table.querySelectorAll('tbody tr[data-row]');
					let visible = 0;

					rows.forEach(row => {
						let matches = true;
						for (const [key, val] of Object.entries(this.filters)) {
							if (!val) continue;
							const rowVal = (row.getAttribute('data-' + key) || '').toLowerCase();
							if (key === 'catalog') {
								if (val !== 'all' && rowVal !== val) {
									matches = false;
									break;
								}
							} else {
								if (!rowVal.includes(val)) {
									matches = false;
									break;
								}
							}
						}
						row.style.display = matches ? '' : 'none';
						if (matches) visible++;
					});

					this.visibleCount = visible;
					const emptyMsg = table.parentElement ? table.parentElement.querySelector('.table-filter-empty') : null;
					if (emptyMsg) {
						emptyMsg.classList.toggle('hidden', visible !== 0);
					}
				},

				sortBy(col, type) {
					const table = document.getElementById(tableId);
					if (!table) return;
					const tbody = table.querySelector('tbody');
					if (!tbody) return;

					if (this.sortCol === col) {
						this.sortDir = this.sortDir === 'asc' ? 'desc' : 'asc';
					} else {
						this.sortCol = col;
						this.sortDir = (type === 'num' || col.includes('diff') || col.includes('cost') || col.includes('price')) ? 'desc' : 'asc';
					}

					const rows = Array.from(tbody.querySelectorAll('tr[data-row]'));
					rows.sort((a, b) => {
						let valA = a.getAttribute('data-' + col) || '';
						let valB = b.getAttribute('data-' + col) || '';

						if (type === 'num') {
							const numA = parseFloat(valA) || 0;
							const numB = parseFloat(valB) || 0;
							return this.sortDir === 'asc' ? numA - numB : numB - numA;
						}
						return this.sortDir === 'asc' ? valA.localeCompare(valB, 'ar') : valB.localeCompare(valA, 'ar');
					});

					rows.forEach(row => tbody.appendChild(row));
				}
			};
		}
		dawaData('marketTableManager', marketTableManager);
	</script>
}

templ marketIntelCoverage(c compare.MarketCoverage) {
	<div class="glass-panel p-4 mb-6">
		<p class="text-xs text-muted m-0">
			{ fmt.Sprintf("محسوب على %d عرضاً من %d ملف لدى %d مورد. %d عرضاً (%.0f%%) مرتبط بالكتالوج المركزي.",
				c.Offers, c.Files, c.Suppliers, c.MatchedOffers, c.MatchedPercent()) }
			if !c.AIEnabled {
				<span class="text-warning"> · مطابقة الذكاء الاصطناعي غير مفعّلة.</span>
			}
		</p>
	</div>
}

templ CompareMarketIntelligencePage(lang, dir string, data MarketIntelligencePageData) {
	if data.IsAdmin {
		@layouts.AdminShell("تقرير ذكاء السوق | Dawa24", "org_imports", lang, dir) {
			@CompareMarketIntelligenceContent(data)
		}
	} else if data.IsCustomer {
		@layouts.ShellFor("تقرير ذكاء السوق | Dawa24", "compare", lang, dir, authctx.FromContext(ctx)) {
			@CompareMarketIntelligenceContent(data)
		}
	} else {
		@layouts.VendorShell("تقرير ذكاء السوق | Dawa24", "compare", lang, dir) {
			@CompareMarketIntelligenceContent(data)
		}
	}
}
