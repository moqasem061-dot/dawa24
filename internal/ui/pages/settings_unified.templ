package pages

import (
	"context"
	"fmt"

	"github.com/muhiya/dawa24-store/internal/modules/billing"
	"github.com/muhiya/dawa24-store/internal/modules/identity"
	"github.com/muhiya/dawa24-store/internal/modules/org"
	"github.com/muhiya/dawa24-store/internal/platform/authctx"
	"github.com/muhiya/dawa24-store/internal/shared/i18n"
	"github.com/muhiya/dawa24-store/internal/ui/components"
	"github.com/muhiya/dawa24-store/internal/ui/layouts"
)

type UnifiedSettingsData struct {
	User                   *identity.User
	Wallet                 *billing.Wallet
	Transactions           []*billing.WalletTransaction
	DepositRequests        []*billing.WalletDeposit
	PaymentMethods         []*billing.UserPaymentMethod
	PlatformPaymentMethods []*billing.PlatformPaymentMethod
	Sessions               []*identity.Session
	SessionPlans           []*identity.SessionPlan
	ActiveTab              string
	CanRequestDeletion     bool
	IsOwner                bool
	OrgID                  int64
	OrgName                string
	OrgLegalName           string
	OrgSettingsURL         string
	PendingAccountDeletion *identity.AccountDeletionRequest
	PendingOrgDeletion     *org.OrganizationDeletionRequest
	Preferences            *identity.UserPreferences
	TelegramEnabled        bool
	WhatsAppEnabled        bool
}

templ UnifiedSettingsPage(data UnifiedSettingsData, lang, dir string) {
	@layouts.ShellFor(i18n.T(lang, "settings.unified_title"), "settings", lang, dir, authctx.FromContext(ctx)) {

		<script nonce={ templ.GetNonce(ctx) }>
			// Moved out of x-data: the CSP build of Alpine cannot parse methods.
			dawaData('settingsUnifiedState', function () {
				return {
					activeTab: (new URLSearchParams(window.location.search).get('tab') || window.location.hash.replace('#', '') || 'profile')
				};
			});
		</script>
		<div
			class="w-full mb-16"
			x-data="settingsUnifiedState"
		>
			<!-- Page Header -->
			<div class="flex-between items-center flex-wrap gap-4 mb-8">
    <div class="stack-sm">
					<div class="row-center-sm mb-2">
						<div class="b2b-icon-box-sm">
							@components.IconSettings("icon-sm")
						</div>
						<h2 class="text-2xl font-black text-primary m-0">
							{ i18n.T(lang, "settings.unified_title") }
						</h2>
					</div>
					<p class="text-sm text-muted m-0">
						{ i18n.T(lang, "settings.unified_desc") }
					</p>
				</div>

				if walletHref := settingsWalletHref(ctx); walletHref != "" {
					<div class="row-center">
						<a href={ templ.SafeURL(walletHref) } class="btn btn-outline-brand font-bold gap-2">
							@components.IconWallet("icon-xs")
							<span>{ i18n.T(lang, "billing.wallet_balance") }</span>
						</a>
					</div>
				}
			</div>

			<!-- Unified Tabs Navigation Bar -->
			<div class="tabs-nav">
				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'profile' }"
					@click="[activeTab = 'profile', $setHash('profile')]"
					data-tab-target="profile"
				>
					@components.IconUser("icon-xs")
					<span>{ i18n.T(lang, "settings.tab_profile") }</span>
				</button>

				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'security' }"
					@click="[activeTab = 'security', $setHash('security')]"
					data-tab-target="security"
				>
					@components.IconLock("icon-xs")
					<span>{ i18n.T(lang, "settings.tab_security") }</span>
				</button>

				<button
					type="button"
					class="tab-btn"
					:class="{ 'active': activeTab === 'preferences' }"
					@click="[activeTab = 'preferences', $setHash('preferences')]"
					data-tab-target="preferences"
				>
					@components.IconBell("icon-xs")
					<span>{ i18n.T(lang, "settings.tab_preferences") }</span>
				</button>

				if data.TelegramEnabled {
					<button
						type="button"
						class="tab-btn"
						:class="{ 'active': activeTab === 'telegram' }"
						@click="[activeTab = 'telegram', $setHash('telegram')]"
						data-tab-target="telegram"
					>
						@components.IconSend("icon-xs")
						<span>{ i18n.T(lang, "settings.tab_telegram") }</span>
					</button>
				}

				if data.WhatsAppEnabled {
					<button
						type="button"
						class="tab-btn"
						:class="{ 'active': activeTab === 'whatsapp' }"
						@click="[activeTab = 'whatsapp', $setHash('whatsapp')]"
						data-tab-target="whatsapp"
					>
						@components.IconWhatsApp("icon-xs")
						<span>{ i18n.T(lang, "settings.tab_whatsapp") }</span>
					</button>
				}
			</div>

			<!-- Tab 1: Profile -->
			<div
				id="tab-profile"
				class="tab-pane glass-panel p-8"
				:class="{ 'active': activeTab === 'profile' }"
				x-show="activeTab === 'profile'"
			>
				<h3 class="text-lg font-extrabold text-primary mb-6">
					{ i18n.T(lang, "settings.profile_section_title") }
				</h3>

				<form 
					action="/settings/profile" 
					method="POST" 
					enctype="multipart/form-data" 
					class="max-w-2xl d-flex flex-col gap-6 text-start" 
					x-data="{ avatarPreview: '', removeAvatar: false }"
				>
					<!-- Avatar Upload Section -->
					<div class="d-flex items-center gap-6 p-5 bg-surface-sunken border rounded-xl flex-wrap">
						<!-- Circular Avatar Preview -->
						<div class="avatar-box w-20 h-20 rounded-full bg-accent-subtle text-accent d-flex items-center justify-center flex-shrink-0 border-2 border-accent overflow-hidden shadow-sm">
							<template x-if="avatarPreview">
								<img :src="avatarPreview" alt="Avatar Preview" class="w-full h-full object-cover" />
							</template>
							<template x-if="!avatarPreview && !removeAvatar">
								if data.User != nil && data.User.AvatarURL != "" {
									<img src={ data.User.AvatarURL } alt="Avatar" class="w-full h-full object-cover" />
								} else {
									@components.IconUser("icon-lg")
								}
							</template>
							<template x-if="!avatarPreview && removeAvatar">
								@components.IconUser("icon-lg")
							</template>
						</div>

						<!-- Upload Controls -->
						<div class="flex-1">
							<label class="form-label font-extrabold text-sm mb-1.5">{ i18n.T(lang, "settings.avatar_label") }</label>
							<div class="d-flex items-center gap-2 flex-wrap">
								<label class="btn btn-secondary btn-sm font-bold cursor-pointer m-0 gap-1.5">
									@components.IconUpload("icon-xs")
									<span>{ i18n.T(lang, "settings.avatar_change") }</span>
									<input 
										type="file" 
										id="user-avatar-file" 
										name="avatar_file" 
										accept="image/png,image/jpeg,image/jpg,image/webp" 
										class="hidden" 
										@change="$event.target.files[0] && [removeAvatar = false, avatarPreview = $objectURL($event.target.files[0])]"
									/>
								</label>
								
								if data.User != nil && data.User.AvatarURL != "" {
									<button 
										type="button" 
										class="btn btn-ghost btn-sm font-bold text-danger m-0 gap-1" 
										x-show="!removeAvatar"
										@click="[removeAvatar = true, avatarPreview = '', $clearInput('user-avatar-file')]"
									>
										@components.IconTrash("icon-xs")
										<span>{ i18n.T(lang, "settings.avatar_delete") }</span>
									</button>
								}
							</div>
							<input type="hidden" name="remove_avatar" :value="removeAvatar ? '1' : '0'" />
							<span class="text-xs text-muted d-block mt-1.5">
								{ i18n.T(lang, "settings.avatar_hint") }
							</span>
						</div>
					</div>

					<div class="form-group mb-0">
						<label class="form-label" for="user-name">{ i18n.T(lang, "settings.full_name") }</label>
						<input type="text" id="user-name" name="name" class="form-input" value={ userNameVal(data.User, lang) } required />
					</div>

					<div class="form-group mb-0">
						<div class="d-flex items-center justify-between mb-1.5 flex-wrap gap-2">
							<label class="form-label mb-0" for="user-email">{ i18n.T(lang, "settings.email") }</label>
							<div class="d-flex items-center gap-2">
								if data.User != nil && data.User.EmailVerifiedAt != nil {
									<span id="profile-email-badge-verified" class="badge badge-emerald d-inline-flex items-center gap-1 py-0.5 px-2 text-2xs font-semibold">
										@components.IconCheck("icon-2xs")
										<span>{ ternaryStr(lang == "ar", "البريد مؤكد", "Email Verified") }</span>
									</span>
								} else {
									<span id="profile-email-badge-unverified" class="badge badge-amber d-inline-flex items-center gap-1 py-0.5 px-2 text-2xs font-semibold">
										@components.IconAlert("icon-2xs")
										<span>{ ternaryStr(lang == "ar", "البريد غير مؤكد", "Unverified Email") }</span>
									</span>
									<button type="button" id="profile-verify-email-open-btn" class="btn btn-secondary btn-xs font-bold d-inline-flex items-center gap-1">
										@components.IconMail("icon-2xs text-brand")
										<span>{ ternaryStr(lang == "ar", "تأكيد البريد الآن", "Verify Email Now") }</span>
									</button>
								}
							</div>
						</div>
						<input type="email" id="user-email" name="email" class="form-input tabular-nums" value={ userEmailVal(data.User) } required />

						<!-- Email OTP Drawer for Profile -->
						<div id="profile-email-otp-box" class="tg-otp-card mt-2.5 p-3 rounded-xl border bg-surface-sunken s-hidden-init">
							<div class="d-flex items-center justify-between mb-2 text-xs text-secondary">
								<span id="profile-email-otp-hint" class="font-semibold">{ i18n.T(lang, "auth.email.enter_code") }</span>
								<span id="profile-email-cooldown-timer" class="font-mono text-muted tabular-nums"></span>
							</div>
							<div class="d-flex items-center gap-2">
								<input type="text" id="profile-email-otp-code" maxlength="6" inputmode="numeric" autocomplete="one-time-code" class="form-input text-center font-mono font-bold tracking-widest text-base tabular-nums py-1.5 s-otp-input max-w-xs" placeholder="••••••" />
								<button type="button" id="profile-email-verify-btn" class="btn btn-primary btn-sm font-semibold px-4">
									{ i18n.T(lang, "auth.email.verify_code") }
								</button>
								<button type="button" id="profile-email-resend-btn" class="btn btn-ghost btn-sm text-xs text-muted s-hidden-init">
									{ i18n.T(lang, "auth.email.resend_otp") }
								</button>
								<button type="button" id="profile-email-cancel-btn" class="btn btn-ghost btn-sm text-xs text-muted">
									{ ternaryStr(lang == "ar", "إلغاء", "Cancel") }
								</button>
							</div>
							<div id="profile-email-otp-feedback" class="text-xs font-medium mt-2 s-hidden-init"></div>
						</div>
					</div>

					<div class="form-group mb-0">
						<div class="d-flex items-center justify-between mb-1.5 flex-wrap gap-2">
							<label class="form-label mb-0" for="user-phone">{ i18n.T(lang, "settings.phone") }</label>
							<div class="d-flex items-center gap-2">
								if data.User != nil && data.User.PhoneVerifiedAt != nil {
									<span id="profile-phone-badge-verified" class="badge badge-emerald d-inline-flex items-center gap-1 py-0.5 px-2 text-2xs font-semibold">
										@components.IconCheck("icon-2xs")
										<span>{ ternaryStr(lang == "ar", "الهاتف مؤكد", "Phone Verified") }</span>
									</span>
								} else {
									<span id="profile-phone-badge-unverified" class="badge badge-amber d-inline-flex items-center gap-1 py-0.5 px-2 text-2xs font-semibold">
										@components.IconAlert("icon-2xs")
										<span>{ ternaryStr(lang == "ar", "الهاتف غير مؤكد", "Unverified Phone") }</span>
									</span>
									<button type="button" id="profile-verify-phone-open-btn" class="btn btn-secondary btn-xs font-bold d-inline-flex items-center gap-1">
										<svg class="icon-2xs text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="m22 2-7 20-4-9-9-4Z"></path>
											<path d="M22 2 11 13"></path>
										</svg>
										<span>{ ternaryStr(lang == "ar", "تأكيد الهاتف عبر Telegram", "Verify via Telegram") }</span>
									</button>
								}
							</div>
						</div>
						<input type="tel" id="user-phone" name="phone" class="form-input tabular-nums" value={ userPhoneVal(data.User) } />

						<!-- Phone OTP Drawer for Profile -->
						<div id="profile-phone-otp-box" class="tg-otp-card mt-2.5 p-3 rounded-xl border bg-surface-sunken s-hidden-init">
							<div class="d-flex items-center justify-between mb-2 text-xs text-secondary">
								<span id="profile-phone-otp-hint" class="font-semibold">{ i18n.T(lang, "auth.telegram.enter_code") }</span>
								<span id="profile-phone-cooldown-timer" class="font-mono text-muted tabular-nums"></span>
							</div>
							<div class="d-flex items-center gap-2">
								<input type="text" id="profile-phone-otp-code" maxlength="6" inputmode="numeric" autocomplete="one-time-code" class="form-input text-center font-mono font-bold tracking-widest text-base tabular-nums py-1.5 s-otp-input max-w-xs" placeholder="••••••" />
								<button type="button" id="profile-phone-verify-btn" class="btn btn-primary btn-sm font-semibold px-4">
									{ i18n.T(lang, "auth.telegram.verify_code") }
								</button>
								<button type="button" id="profile-phone-resend-btn" class="btn btn-ghost btn-sm text-xs text-muted s-hidden-init">
									{ i18n.T(lang, "auth.telegram.resend_otp") }
								</button>
								<button type="button" id="profile-phone-cancel-btn" class="btn btn-ghost btn-sm text-xs text-muted">
									{ ternaryStr(lang == "ar", "إلغاء", "Cancel") }
								</button>
							</div>
							<div id="profile-phone-otp-feedback" class="text-xs font-medium mt-2 s-hidden-init"></div>
						</div>
					</div>

					<div class="form-group mb-0">
						<label class="form-label" for="user-role">{ i18n.T(lang, "settings.account_role") }</label>
						<input type="text" id="user-role" class="form-input bg-surface-sunken text-muted" value={ userRoleVal(data.User) } disabled />
					</div>

					<div class="mt-3">
						<button type="submit" class="btn btn-primary font-black px-8 py-3">
							@components.IconCheck("icon-xs")
							<span>{ i18n.T(lang, "settings.save_profile") }</span>
						</button>
					</div>
				</form>

				<!-- Danger Zone -->
				if data.CanRequestDeletion {
					<div class="border-t border-danger/30 mt-10 pt-7 stack-md">
						if data.IsOwner && data.OrgID > 0 {
							if data.PendingOrgDeletion != nil {
								<div class="p-5 rounded-xl border border-amber/30 bg-amber/10 flex-between items-center flex-wrap gap-4 mb-4">
									<div class="stack-xs max-w-xl text-start">
										<div class="d-flex items-center gap-2 text-amber font-black text-sm">
											@components.IconClock("icon-xs")
											<span>طلب حذف المنشأة ({ data.OrgName }) قيد المراجعة</span>
										</div>
										<p class="text-xs text-secondary m-0 leading-relaxed">
											تم تقديم طلب الحذف بتاريخ <strong class="tabular-nums">{ data.PendingOrgDeletion.CreatedAt.Format("2006-01-02 15:04") }</strong> وهو قيد مراجعة إدارة المنصة.
										</p>
										if data.PendingOrgDeletion.Reason != "" {
											<div class="text-2xs text-muted bg-surface-sunken p-2 rounded border mt-1">
												<strong>السبب المسجل:</strong> { data.PendingOrgDeletion.Reason }
											</div>
										}
									</div>
									<form method="POST" action="/settings/organization/delete-request/cancel" class="m-0">
										<input type="hidden" name="request_id" value={ fmt.Sprintf("%d", data.PendingOrgDeletion.ID) } />
										<button type="submit" class="btn btn-secondary font-bold text-xs gap-1">
											@components.IconX("icon-xs")
											<span>إلغاء وسحب طلب الحذف</span>
										</button>
									</form>
								</div>
							} else {
								<div class="bg-danger/5 border border-danger/20 rounded-xl p-6 flex-between items-center flex-wrap gap-5 mb-4">
									<div class="stack-sm text-start">
										<div class="d-flex items-center gap-2 text-danger font-extrabold text-base">
											@components.IconBuilding("icon-xs")
											<span>حذف المنشأة نهائياً ({ data.OrgName })</span>
										</div>
										<p class="text-xs text-secondary mt-1.5 leading-relaxed max-w-xl">
											أنت مسجل كمالك لهذه المنشأة. سيتم إرسال الطلب إلى إدارة المنصة للتدقيق والموافقة. عند اعتماد الحذف، سيتم تعطيل حساب المنشأة وإيقاف كافة فروعها وحسابات الموظفين المنتسبين إليها فوراً.
										</p>
									</div>
									<button
										type="button"
										class="btn btn-danger font-bold px-6 py-2.5 gap-1"
										data-modal-open="org-delete-modal"
									>
										@components.IconTrash("icon-xs")
										<span>طلب حذف المنشأة</span>
									</button>
								</div>
							}
						}

						if data.PendingAccountDeletion != nil {
							<div class="p-5 rounded-xl border border-amber/30 bg-amber/10 flex-between items-center flex-wrap gap-4">
								<div class="stack-xs max-w-xl text-start">
									<div class="d-flex items-center gap-2 text-amber font-black text-sm">
										@components.IconClock("icon-xs")
										<span>طلب حذف الحساب الشخصي قيد المراجعة</span>
									</div>
									<p class="text-xs text-secondary m-0 leading-relaxed">
										تم تقديم طلب الحذف بتاريخ <strong class="tabular-nums">{ data.PendingAccountDeletion.CreatedAt.Format("2006-01-02 15:04") }</strong> وهو قيد مراجعة إدارة المنصة.
									</p>
									if data.PendingAccountDeletion.Reason != "" {
										<div class="text-2xs text-muted bg-surface-sunken p-2 rounded border mt-1">
											<strong>السبب المسجل:</strong> { data.PendingAccountDeletion.Reason }
										</div>
									}
								</div>
								<form method="POST" action="/settings/delete-request/cancel" class="m-0">
									<input type="hidden" name="request_id" value={ fmt.Sprintf("%d", data.PendingAccountDeletion.ID) } />
									<button type="submit" class="btn btn-secondary font-bold text-xs gap-1">
										@components.IconX("icon-xs")
										<span>إلغاء وسحب طلب الحذف</span>
									</button>
								</form>
							</div>
						} else {
							<div class="bg-danger/5 border border-danger/20 rounded-xl p-6 flex-between items-center flex-wrap gap-5">
								<div class="stack-sm text-start">
									<div class="d-flex items-center gap-2 text-danger font-extrabold text-base">
										@components.IconTrash("icon-xs")
										<span>{ i18n.T(lang, "settings.delete_account_title") }</span>
									</div>
									<p class="text-xs text-secondary mt-1.5 leading-relaxed max-w-xl">
										{ i18n.T(lang, "settings.delete_account_desc") }
									</p>
								</div>
								<button
									type="button"
									class="btn btn-secondary text-danger border-danger/30 font-bold px-6 py-2.5"
									data-modal-open="delete-account-modal"
								>
									@components.IconTrash("icon-xs")
									<span>{ i18n.T(lang, "settings.delete_account_btn") }</span>
								</button>
							</div>
						}
					</div>
				}
			</div>

			<!-- Tab: Security & Password -->
			<div
				id="tab-security"
				class="tab-pane glass-panel p-8"
				:class="{ 'active': activeTab === 'security' }"
				x-show="activeTab === 'security'"
			>
				<h3 class="text-lg font-extrabold text-primary mb-2">
					{ i18n.T(lang, "settings.security_title") }
				</h3>
				<p class="text-xs text-muted mb-6">
					{ i18n.T(lang, "settings.security_desc") }
				</p>

				<form
					action="/settings/password"
					method="POST"
					class="max-w-xl d-flex flex-col gap-5 text-start"
					x-data="{
						otpSent: false,
						otpLoading: false,
						otpFeedback: '',
						otpError: false,
						cooldown: 0,
						sendOTP() {
							this.otpLoading = true;
							this.otpFeedback = '';
							fetch('/settings/password/send-otp', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' }
							})
							.then(r => r.json())
							.then(data => {
								this.otpLoading = false;
								if (data.ok) {
									this.otpSent = true;
									this.otpError = false;
									this.otpFeedback = data.message || 'تم إرسال رمز التحقق إلى بريدك الإلكتروني بنجاح';
									this.cooldown = data.cooldown || 60;
									let timer = setInterval(() => {
										this.cooldown--;
										if (this.cooldown <= 0) clearInterval(timer);
									}, 1000);
								} else {
									this.otpError = true;
									this.otpFeedback = data.message || 'تعذر إرسال رمز التحقق، يرجى المحاولة لاحقاً';
								}
							})
							.catch(() => {
								this.otpLoading = false;
								this.otpError = true;
								this.otpFeedback = 'حدث خطأ في الاتصال، يرجى المحاولة لاحقاً';
							});
						}
					}"
				>
					<div class="form-group mb-0">
						<label class="form-label font-bold text-xs mb-1" for="settings-new-password">
							{ i18n.T(lang, "settings.new_password") }
						</label>
						<input
							type="password"
							id="settings-new-password"
							name="new_password"
							minlength="8"
							required
							placeholder="••••••••"
							class="form-input text-xs"
						/>
					</div>

					<div class="form-group mb-0">
						<label class="form-label font-bold text-xs mb-1" for="settings-confirm-password">
							{ i18n.T(lang, "settings.confirm_new_password") }
						</label>
						<input
							type="password"
							id="settings-confirm-password"
							name="new_password_confirmation"
							minlength="8"
							required
							placeholder="••••••••"
							class="form-input text-xs"
						/>
					</div>

					<div class="p-4 bg-surface-sunken border rounded-xl stack-sm">
						<div class="flex-between items-center flex-wrap gap-2">
							<label class="form-label font-bold text-xs m-0" for="settings-email-otp">
								{ i18n.T(lang, "settings.email_otp_code") }
							</label>
							<button
								type="button"
								class="btn btn-secondary btn-sm font-bold text-xs gap-1.5"
								@click="sendOTP()"
								:disabled="otpLoading || cooldown > 0"
							>
								@components.IconMail("icon-xs")
								<span x-show="!otpLoading && cooldown <= 0">{ i18n.T(lang, "settings.send_email_code") }</span>
								<span x-show="otpLoading">جاري الإرسال...</span>
								<span x-show="cooldown > 0" x-text="'إعادة الإرسال بعد ' + cooldown + ' ثانية'"></span>
							</button>
						</div>

						<input
							type="text"
							id="settings-email-otp"
							name="email_otp_code"
							maxlength="6"
							required
							placeholder="123456"
							class="form-input text-center font-mono text-lg tracking-widest font-bold"
						/>

						<template x-if="otpFeedback">
							<div
								:class="otpError ? 'alert alert-error text-xs font-semibold p-2.5 rounded-lg' : 'alert alert-success text-xs font-semibold p-2.5 rounded-lg'"
								x-text="otpFeedback"
							></div>
						</template>
					</div>

					<div class="pt-2">
						<button type="submit" class="btn btn-primary font-bold gap-2">
							@components.IconLock("icon-xs")
							<span>{ i18n.T(lang, "settings.change_password_btn") }</span>
						</button>
					</div>
				</form>
			</div>

			<!-- Tab 2: Preferences -->
			<div
				id="tab-preferences"
				class="tab-pane glass-panel p-8"
				:class="{ 'active': activeTab === 'preferences' }"
				x-show="activeTab === 'preferences'"
			>
				<h3 class="text-lg font-extrabold text-primary mb-6">
					{ i18n.T(lang, "settings.pref_title") }
				</h3>

				<form action="/settings/preferences" method="POST" class="max-w-2xl d-flex flex-col gap-5 text-start">
					<div class="flex-between items-center p-4 border rounded-lg bg-surface-sunken">
						<div class="stack-sm">
							<div class="font-extrabold text-primary">{ i18n.T(lang, "settings.pref_email") }</div>
							<div class="text-sm text-muted">{ i18n.T(lang, "settings.pref_email_desc") }</div>
						</div>
						<input
							type="checkbox"
							name="notif_email"
							if data.Preferences == nil || data.Preferences.NotificationChannels["email"] {
								checked="checked"
							}
							class="form-checkbox"
						/>
					</div>

					<div class="flex-between items-center p-4 border rounded-lg bg-surface-sunken">
						<div class="stack-sm">
							<div class="font-extrabold text-primary">{ i18n.T(lang, "settings.pref_promos") }</div>
							<div class="text-sm text-muted">{ i18n.T(lang, "settings.pref_promos_desc") }</div>
						</div>
						<input
							type="checkbox"
							name="notif_promos"
							if data.Preferences == nil || data.Preferences.NotificationTopics["offers"] {
								checked="checked"
							}
							class="form-checkbox"
						/>
					</div>

					<div class="mt-3">
						<button type="submit" class="btn btn-primary font-black px-8 py-3">
							@components.IconCheck("icon-xs")
							<span>{ i18n.T(lang, "settings.save_preferences") }</span>
						</button>
					</div>
				</form>
			</div>

			if data.TelegramEnabled {
				<!-- Tab 3: Telegram. Loaded on first view; the card manages itself. -->
				<div
					id="tab-telegram"
					class="tab-pane glass-panel p-8"
					:class="{ 'active': activeTab === 'telegram' }"
					x-show="activeTab === 'telegram'"
				>
					<div hx-get="/settings/telegram" hx-trigger="load" hx-swap="outerHTML"></div>
				</div>
			}

			if data.WhatsAppEnabled {
				<!-- Tab 4: WhatsApp. Loaded on first view; the card manages itself. -->
				<div
					id="tab-whatsapp"
					class="tab-pane glass-panel p-8"
					:class="{ 'active': activeTab === 'whatsapp' }"
					x-show="activeTab === 'whatsapp'"
				>
					<div hx-get="/settings/whatsapp" hx-trigger="load" hx-swap="outerHTML"></div>
				</div>
			}

			<!-- Dynamic Modal: Request Account Deletion Modal (Typed Confirmation) -->
			if data.CanRequestDeletion && data.PendingAccountDeletion == nil {
				@components.ConfirmModal(components.ConfirmModalProps{
					ID:           "delete-account-modal",
					Title:        i18n.T(lang, "settings.delete_account_title"),
					Message:      i18n.T(lang, "settings.delete_account_msg"),
					ConfirmURL:   "/settings/delete-request",
					ConfirmVerb:  "post",
					ConfirmText:  i18n.T(lang, "settings.delete_account_confirm"),
					CancelText:   i18n.T(lang, "common.cancel"),
					RequireMatch: i18n.T(lang, "settings.delete_type_match"),
					Danger:       true,
				})
			}

			if data.IsOwner && data.OrgID > 0 && data.PendingOrgDeletion == nil {
				<!-- Confirm Org Delete Modal -->
				@components.Modal(components.ModalProps{
					ID:       "org-delete-modal",
					Title:    "طلب حذف المنشأة",
					Subtitle: data.OrgLegalName,
					Icon:     "trash",
					Size:     "md",
				}) {
					<div x-data="{ typedConfirm: '', expectedName: '' }" x-init={ fmt.Sprintf("expectedName = '%s'", data.OrgLegalName) }>
						<div class="alert alert-danger mb-4 text-xs leading-relaxed">
							<strong>تنبيه وضمانة قانونية:</strong> تقديم هذا الطلب يخضع لمراجعة وتدقيق إدارة المنصة. عند اعتماد الطلب، سيتم إيقاف وتعطيل (Block) نشاط المنشأة وفروعها وحساباتها بالكامل على المنصة، مع الحفاظ التام والأرشفة الكاملة لكافة السجلات والبيانات القانونية والمالية وفقاً للمتطلبات التنظيمية دون أي مساس بها.
						</div>

						<form method="POST" action="/settings/delete-request" class="m-0 stack-sm">
							<input type="hidden" name="delete_target" value="organization" />
							<div class="form-group mb-3">
								<label class="form-label text-xs font-bold" for="org-del-reason">
									سبب طلب الحذف <span class="text-danger">*</span>
								</label>
								<textarea
									id="org-del-reason"
									name="reason"
									rows="3"
									class="form-input text-xs"
									placeholder="يرجى كتابة سبب طلب الحذف للمراجعة الإدارية..."
									required
								></textarea>
							</div>

							<div class="form-group mb-4">
								<label class="form-label text-xs font-bold" for="org-del-confirm">
									لتأكيد الطلب، يرجى كتابة اسم المنشأة: <span class="text-primary font-black select-all">"{ data.OrgLegalName }"</span>
								</label>
								<input
									type="text"
									id="org-del-confirm"
									class="form-input text-xs"
									x-model="typedConfirm"
									placeholder="اكتب اسم المنشأة كما هو موضح أعلاه..."
									autocomplete="off"
								/>
							</div>

							<div class="d-flex items-center justify-end gap-2 pt-3 border-t">
								<button type="button" class="btn btn-secondary font-bold" data-modal-close="org-delete-modal">
									إلغاء
								</button>
								<button
									type="submit"
									class="btn btn-danger font-black gap-1"
									:disabled={ "typedConfirm.trim() !== expectedName.trim() && typedConfirm.trim() !== 'حذف'" }
								>
									@components.IconTrash("icon-xs")
									<span>تأكيد تقديم طلب الحذف</span>
								</button>
							</div>
						</form>
					</div>
				}
			}

		</div>
		<script src={ layouts.Asset("/js/profile_verification.js") } defer></script>
	}
}

func userNameVal(u *identity.User, lang string) string {
	if u == nil {
		return ""
	}
	return u.Name.Get(i18n.Lang(lang))
}

func userEmailVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Email
}

func userPhoneVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Phone
}

func userRoleVal(u *identity.User) string {
	if u == nil {
		return ""
	}
	return u.Role
}

func ternaryStr(cond bool, a, b string) string {
	if cond {
		return a
	}
	return b
}

// settingsWalletHref is the wallet this caller can actually open, or nothing.
//
// The header used to link to /customer/wallet unconditionally. That is a 404
// for a supplier (the route is mounted inside the customer audience group), a
// 404 for an administrator (same reason), and a 404 for a pharmacy member
// without pharmacy.wallet.view. Three of the four kinds of visitor this page
// has were offered a door that does not open.
func settingsWalletHref(ctx context.Context) string {
	actor, ok := authctx.From(ctx)
	if !ok || actor.IsStaff {
		return ""
	}
	if actor.IsVendor() {
		if actor.Can("vendor.wallet.view") {
			return "/vendor/wallet"
		}
		return ""
	}
	if actor.Can("pharmacy.wallet.view") {
		return "/customer/wallet"
	}
	return ""
}
