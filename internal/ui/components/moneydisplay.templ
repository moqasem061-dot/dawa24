package components

import (
	"github.com/moqasem061-dot/dawa24/internal/shared/format"
	"github.com/moqasem061-dot/dawa24/internal/shared/money"
)

// MoneyDisplayProps renders a monetary amount with thousand-grouping and localized currency.
type MoneyDisplayProps struct {
	Amount   money.Amount
	Currency string
	Lang     string
	State    string
	// Large renders the figure at cart/checkout total size.
	Large bool
}

templ MoneyDisplay(props MoneyDisplayProps) {
	{{
		lang := props.Lang
		if lang == "" {
			lang = "ar"
		}
	}}
	<span class="s-money">
		switch props.State {
			case "loading":
				<span class="skeleton s-money-skeleton"></span>
			case "error":
				<span class="money money-negative" aria-label="—">—</span>
			default:
				<span
					class={ "s-tabular", "money", templ.KV("money-lg", props.Large),
						templ.KV("money-negative", props.Amount.Minor() < 0) }
				>
					{ format.Money(props.Amount, lang) }
				</span>
		}
	</span>
}
