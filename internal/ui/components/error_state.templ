package components

type ErrorStateProps struct {
	Title      string
	Message    string
	RetryURL   string
	RetryLabel string
}

templ ErrorState(props ErrorStateProps) {
	<div class="stack-sm s-error-state">
		<div class="stack-sm s-error-state-icon">
			<svg class="icon-lg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
			</svg>
		</div>
		<h3 class="s-error-state-title">
			if props.Title != "" {
				{ props.Title }
			} else {
				حدث خطأ أثناء تحميل البيانات
			}
		</h3>
		<p class="s-error-state-message">
			if props.Message != "" {
				{ props.Message }
			} else {
				تعذر إتمام العملية المطلوبة. يرجى المحاولة مرة أخرى أو مراجعة الاتصال بالخادم.
			}
		</p>
		<div class="s-error-actions">
			<button type="button" data-on-click="backOrHome()" class="btn btn-secondary s-error-state-btn">
				<span>الرجوع للخلف</span>
			</button>
			if props.RetryURL != "" {
				<a href={ templ.SafeURL(props.RetryURL) } class="btn btn-danger s-error-state-btn">
					@IconRefresh("icon-xs")
					if props.RetryLabel != "" {
						<span>{ props.RetryLabel }</span>
					} else {
						<span>إعادة المحاولة</span>
					}
				</a>
			}
		</div>
	</div>
}
