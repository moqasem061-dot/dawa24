package matchreview

import (
	"fmt"
)

type BulkPreviewProps struct {
	Total       int
	Affected    int
	TargetName  string
	TargetID    int64
	Action      string
	ConfirmURL  string
	CSRFToken   string
	RowID       int64
	ExpectedRev int
}

templ BulkPreviewModal(props BulkPreviewProps) {
	<div
		class="p-6 bg-white rounded-xl max-w-lg w-full space-y-5 text-start shadow-xl border border-neutral-200"
		dir="rtl"
		role="dialog"
		aria-labelledby="bulk-preview-title"
		aria-modal="true"
	>
		<div class="flex items-start justify-between">
			<div>
				<h3 id="bulk-preview-title" class="text-base font-bold text-neutral-900">
					معاينة الإجراء الجماعي
					<span class="text-xs font-normal text-neutral-500 block">(Bulk Action Scope Preview)</span>
				</h3>
				<p class="text-xs text-neutral-600 mt-1">
					تطبيق الاختيار على جميع الصفوف المتطابقة تمامًا في الهوية.
				</p>
			</div>
			<span class="p-2 rounded-lg bg-primary-50 text-primary-700">
				<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
				</svg>
			</span>
		</div>

		<!-- Scope Breakdown Stats -->
		<div class="grid grid-cols-2 gap-3 p-3 bg-neutral-50 rounded-lg border border-neutral-200/80 text-xs">
			<div>
				<span class="text-neutral-500 block">إجمالي الصفوف في الملف:</span>
				<span class="text-base font-bold text-neutral-900" aria-live="polite">
					<bdi>{ fmt.Sprintf("%d", props.Total) }</bdi>
				</span>
			</div>
			<div>
				<span class="text-emerald-700 font-medium block">الصفوف المتأثرة بالمطابقة:</span>
				<span class="text-base font-bold text-emerald-700" aria-live="polite">
					<bdi>{ fmt.Sprintf("%d", props.Affected) }</bdi>
				</span>
			</div>
		</div>

		<!-- Target Item Info -->
		if props.TargetName != "" {
			<div class="p-3 bg-primary-50/50 rounded-lg border border-primary-200 text-xs space-y-1">
				<span class="text-primary-800 font-semibold block">الصنف المختار للتطبيق الجماعي:</span>
				<div class="font-medium text-neutral-900"><bdi>{ props.TargetName }</bdi></div>
				if props.TargetID > 0 {
					<div class="text-[11px] text-neutral-500">معرف الكتالوج: <bdi>#{ fmt.Sprintf("%d", props.TargetID) }</bdi></div>
				}
			</div>
		}

		<!-- Policy & Safety Guarantee Notice -->
		<div class="p-3 bg-amber-50 rounded-lg border border-amber-200 text-xs text-amber-800 space-y-1">
			<div class="font-semibold flex items-center gap-1.5">
				<svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
				<span>ضمان العزل والأمان (FR-046):</span>
			</div>
			<p class="text-[11px] leading-relaxed">
				لن يمتد هذا الإجراء للصفوف ذات التراكيز أو العبوات المختلفة أو المساحات المنفصلة، وسيتم استبعاد أي صفوف تم رفضها يدوياً بشكل صريح.
			</p>
		</div>

		<!-- Action Buttons -->
		<div class="flex items-center justify-end gap-2 pt-2">
			<button
				type="button"
				onclick="this.closest('dialog').close()"
				class="px-4 py-2 text-xs font-medium text-neutral-700 bg-neutral-100 hover:bg-neutral-200 rounded-lg transition-colors"
			>
				إلغاء (Cancel)
			</button>
			<button
				type="button"
				hx-post={ props.ConfirmURL }
				hx-vals={ fmt.Sprintf(`{"action":"bulk_confirm","target_id":%d,"row_id":%d,"expected_rev":%d}`, props.TargetID, props.RowID, props.ExpectedRev) }
				hx-target="#match-review-container"
				hx-swap="outerHTML"
				class="px-4 py-2 text-xs font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-lg shadow-sm transition-colors"
			>
				تأكيد التطبيق على <bdi>{ fmt.Sprintf("%d", props.Affected) }</bdi> صفوف
			</button>
		</div>
	</div>
}
