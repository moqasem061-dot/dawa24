package matchreview

import (
	"github.com/moqasem061-dot/dawa24/internal/platform/httpx"
	"github.com/moqasem061-dot/dawa24/internal/shared/i18n"
	"github.com/moqasem061-dot/dawa24/internal/shared/matchflow"
)

type ReasonsProps struct {
	Reasons []matchflow.Reason
	Flags   []string
	Lang    string
}

templ Reasons(props ReasonsProps) {
	{{
		lang := httpx.LangFrom(ctx)
		if props.Lang != "" {
			lang = i18n.ParseLang(props.Lang)
		}
	}}
	if len(props.Reasons) > 0 || len(props.Flags) > 0 {
		<ul class="match-reasons" aria-label={ i18n.T(lang, "match.reasons.label") } dir={ lang.Dir() }>
			for _, reason := range props.Reasons {
				<li class={ "match-reason", reasonClass(reason.Code) } title={ reasonText(lang, reason.Code) }>
					<span>{ reasonLabel(lang, reason.Code) }</span>
					if len(reason.Params) > 0 {
						<dl class="match-reason-params">
							for _, key := range reasonParamKeys(reason.Params) {
								<div>
									<dt>{ reasonParamLabel(lang, key) }</dt>
									<dd><bdi>{ reasonParamValue(lang, reason.Params[key]) }</bdi></dd>
								</div>
							}
						</dl>
					}
				</li>
			}
			for _, flag := range uniqueReasonFlags(props) {
				<li class="match-reason match-reason-warning" title={ reasonText(lang, flag) }>{ reasonLabel(lang, flag) }</li>
			}
		</ul>
	}
}
