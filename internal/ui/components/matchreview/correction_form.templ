package matchreview

import (
	"fmt"
	"github.com/moqasem061-dot/dawa24/internal/shared/productmatch"
)

type CorrectionFormProps struct {
	RowID       int64
	TargetID    int64
	Row         productmatch.Row
	PostURL     string
	CSRFToken   string
	ExpectedRev int
}

templ CorrectionForm(props CorrectionFormProps) {
	<form
		hx-post={ props.PostURL }
		hx-target="closest tr.review-row"
		hx-swap="outerHTML"
		class="p-4 bg-white border border-neutral-200 rounded-lg space-y-4 text-xs"
		dir="rtl"
	>
		<input type="hidden" name="action" value="correct"/>
		<input type="hidden" name="row_id" value={ fmt.Sprintf("%d", props.RowID) }/>
		<input type="hidden" name="expected_rev" value={ fmt.Sprintf("%d", props.ExpectedRev) }/>
		if props.TargetID > 0 {
			<input type="hidden" name="target_id" value={ fmt.Sprintf("%d", props.TargetID) }/>
		}

		<div class="border-b border-neutral-100 pb-2">
			<h4 class="font-semibold text-neutral-900 text-sm">
				تصحيح خصائص الصنف اليدوي
				<span class="text-xs font-normal text-neutral-500 ms-1">(Manual Attribute Correction)</span>
			</h4>
			<p class="text-[11px] text-neutral-500 mt-0.5">
				تعديل الخصائص المستخرجة لرفع التعارض وتمكين المطابقة الصحيحة.
			</p>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
			<!-- Strength -->
			<div>
				<label for={ fmt.Sprintf("corr-strength-%d", props.RowID) } class="block font-medium text-neutral-700 mb-1">
					التركيز (Strength / Concentration)
				</label>
				<input
					type="text"
					id={ fmt.Sprintf("corr-strength-%d", props.RowID) }
					name="corr_strength"
					value={ props.Row.Concentration }
					placeholder="مثال: 500 mg أو 5/10 mg"
					class="w-full text-xs rounded border-neutral-300 focus:border-primary-500 focus:ring-primary-500 py-1.5 ps-2.5 pe-2.5"
				/>
			</div>

			<!-- Dosage Form -->
			<div>
				<label for={ fmt.Sprintf("corr-form-%d", props.RowID) } class="block font-medium text-neutral-700 mb-1">
					الشكل الدوائي (Dosage Form)
				</label>
				<input
					type="text"
					id={ fmt.Sprintf("corr-form-%d", props.RowID) }
					name="corr_form"
					value={ props.Row.DosageForm }
					placeholder="مثال: أقراص، شراب، كبسولات..."
					class="w-full text-xs rounded border-neutral-300 focus:border-primary-500 focus:ring-primary-500 py-1.5 ps-2.5 pe-2.5"
				/>
			</div>

			<!-- Pack Count -->
			<div>
				<label for={ fmt.Sprintf("corr-pack-%d", props.RowID) } class="block font-medium text-neutral-700 mb-1">
					عدد الوحدات في العبوة (Pack Size)
				</label>
				<input
					type="number"
					id={ fmt.Sprintf("corr-pack-%d", props.RowID) }
					name="corr_pack"
					if props.Row.PackSize > 0 {
						value={ fmt.Sprintf("%d", props.Row.PackSize) }
					}
					placeholder="مثال: 20 أو 30"
					class="w-full text-xs rounded border-neutral-300 focus:border-primary-500 focus:ring-primary-500 py-1.5 ps-2.5 pe-2.5"
				/>
			</div>

			<!-- Brand -->
			<div>
				<label for={ fmt.Sprintf("corr-brand-%d", props.RowID) } class="block font-medium text-neutral-700 mb-1">
					الشركة أو العلامة (Brand / Manufacturer)
				</label>
				<input
					type="text"
					id={ fmt.Sprintf("corr-brand-%d", props.RowID) }
					name="corr_brand"
					value={ props.Row.Manufacturer }
					placeholder="مثال: GSK، فاركو، ميرك..."
					class="w-full text-xs rounded border-neutral-300 focus:border-primary-500 focus:ring-primary-500 py-1.5 ps-2.5 pe-2.5"
				/>
			</div>
		</div>

		<!-- Reason -->
		<div>
			<label for={ fmt.Sprintf("corr-reason-%d", props.RowID) } class="block font-medium text-neutral-700 mb-1">
				سبب التصحيح (Reason for audit log)
			</label>
			<input
				type="text"
				id={ fmt.Sprintf("corr-reason-%d", props.RowID) }
				name="reason"
				placeholder="مثال: خطأ إملائي في ملف المورد الأصلي"
				class="w-full text-xs rounded border-neutral-300 focus:border-primary-500 focus:ring-primary-500 py-1.5 ps-2.5 pe-2.5"
			/>
		</div>

		<div class="flex items-center justify-end gap-2 pt-2 border-t border-neutral-100">
			<button
				type="button"
				onclick="this.closest('.correction-container').classList.add('hidden')"
				class="px-3 py-1.5 text-xs font-medium text-neutral-600 hover:text-neutral-800 bg-neutral-100 rounded transition-colors"
			>
				إلغاء (Cancel)
			</button>
			<button
				type="submit"
				class="px-3.5 py-1.5 text-xs font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded shadow-sm transition-colors"
			>
				حفظ التصحيح والمطابقة (Save & Match)
			</button>
		</div>
	</form>
}
