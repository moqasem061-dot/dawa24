package components

import (
	"fmt"

	"github.com/moqasem061-dot/dawa24/internal/platform/httpx"
)

type InvoiceExportDropdownProps struct {
	PrintURL string
	ExcelURL string
	WordURL  string
	Size     string // "xs", "sm", "md"
	Align    string // "start", "end"
	Label    string
}

templ InvoiceExportDropdown(props InvoiceExportDropdownProps) {
	<div
		class="relative inline-block text-start"
		x-data="{ open: false }"
		@click.outside="open = false"
	>
		<button
			type="button"
			@click="open = !open"
			class={ "btn btn-secondary font-bold d-inline-flex items-center gap-1.5",
				templ.KV("btn-xs py-1 px-2.5 text-2xs", props.Size == "xs"),
				templ.KV("btn-sm py-1.5 px-3 text-xs", props.Size == "" || props.Size == "sm"),
				templ.KV("btn-md py-2 px-4 text-sm", props.Size == "md") }
			title="خيارات طباعة وتصدير الفاتورة"
		>
			@IconPrinter("icon-xs")
			if props.Label != "" {
				<span>{ props.Label }</span>
			} else {
				<span>طباعة / تصدير</span>
			}
			<span class="text-[10px] opacity-70">▼</span>
		</button>

		<div
			x-show="open"
			class={ "absolute z-50 mt-1.5 w-56 rounded-2xl border border-default bg-surface-raised shadow-xl p-1.5 text-xs text-start",
				templ.KV("start-0", props.Align == "start"),
				templ.KV("end-0", props.Align == "" || props.Align == "end") } x-cloak>
			<!-- 1. Print / PDF (Via Hidden Iframe without leaving page) -->
			<button
				type="button"
				class="w-full d-flex items-center gap-2 px-3 py-2 rounded-xl text-surface-fg hover:bg-surface font-bold transition-colors text-start"
				@click={ fmt.Sprintf("[open = false, $printInvoice(%q)]", props.PrintURL) }
			>
				<span class="text-accent">@IconPrinter("icon-sm")</span>
				<div class="d-flex flex-col text-start">
					<span>طباعة / تصدير PDF</span>
					<span class="text-2xs text-secondary font-normal">طباعة فورية دون مغادرة الصفحة</span>
				</div>
			</button>

			<!-- 2. Export Excel -->
			<a
				href={ templ.SafeURL(props.ExcelURL) }
				download
				class="w-full d-flex items-center gap-2 px-3 py-2 rounded-xl text-surface-fg hover:bg-surface font-bold transition-colors text-start"
				@click="open = false"
			>
				<span class="text-emerald-600">@IconFileSpreadsheet("icon-sm")</span>
				<div class="d-flex flex-col text-start">
					<span>تصدير Excel (XLSX)</span>
					<span class="text-2xs text-secondary font-normal">جدول بيانات تفصيلي جاهز</span>
				</div>
			</a>

			<!-- 3. Export Word -->
			<a
				href={ templ.SafeURL(props.WordURL) }
				download
				class="w-full d-flex items-center gap-2 px-3 py-2 rounded-xl text-surface-fg hover:bg-surface font-bold transition-colors text-start"
				@click="open = false"
			>
				<span class="text-blue-600">@IconFileText("icon-sm")</span>
				<div class="d-flex flex-col text-start">
					<span>تصدير Word (DOCX)</span>
					<span class="text-2xs text-secondary font-normal">مستند قابل للتعديل والطباعة</span>
				</div>
			</a>
		</div>
	</div>
	<script nonce={ httpx.Nonce(ctx) }>
		if (!window.printInvoiceDirectly) {
			// Prints the invoice document through a hidden iframe.
			//
			// It prints only after checking the iframe really holds the invoice:
			// a route that refused and redirected used to have its destination
			// printed instead (the admin dashboard). The document is loaded
			// without autoprint, because the page printing itself on load AND
			// this printing it on onload opened the dialog twice.
			window.printInvoiceDirectly = function(url) {
				var target = new URL(url, window.location.href);
				var openInTab = function() { window.open(target.href, '_blank', 'noopener'); };
				var previous = document.getElementById('print-invoice-hidden-iframe');
				if (previous) previous.remove();
				var iframe = document.createElement('iframe');
				iframe.id = 'print-invoice-hidden-iframe';
				iframe.setAttribute('aria-hidden', 'true');
				iframe.tabIndex = -1;
				iframe.style.position = 'fixed';
				iframe.style.insetInlineEnd = '0';
				iframe.style.bottom = '0';
				iframe.style.width = '0';
				iframe.style.height = '0';
				iframe.style.border = '0';
				iframe.style.opacity = '0';
				iframe.style.pointerEvents = 'none';
				iframe.onload = function() {
					var win = iframe.contentWindow;
					var isInvoice = false;
					try {
						isInvoice = win.location.pathname === target.pathname &&
							!!win.document.getElementById('a4-invoice-container');
					} catch (e) { isInvoice = false; }
					if (!isInvoice) {
						iframe.remove();
						openInTab();
						return;
					}
					var print = function() {
						try {
							win.focus();
							if (typeof win.printA4 === 'function') { win.printA4(); } else { win.print(); }
						} catch (e) { openInTab(); }
					};
					if (win.document.fonts && win.document.fonts.ready) {
						win.document.fonts.ready.then(print, print);
					} else {
						print();
					}
				};
				iframe.src = target.href;
				document.body.appendChild(iframe);
			};
		}
	</script>
}
