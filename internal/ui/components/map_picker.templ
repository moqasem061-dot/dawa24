package components

import (
	"fmt"
	platformadmin "github.com/moqasem061-dot/dawa24/internal/modules/platform_admin"
)

// MapPickerProps defines configuration for the geographic coordinate and radius picker.
type MapPickerProps struct {
	Lat          *float64
	Lon          *float64
	RadiusMeters int
	NamePrefix   string
	Label        string
	ReadOnly     bool
	ShowRadius   bool
	Height       string
	Cities       []*platformadmin.City
}

templ MapPicker(props MapPickerProps) {
	{{
		latVal := 30.0444
		if props.Lat != nil && *props.Lat != 0 {
			latVal = *props.Lat
		}
		lonVal := 31.2357
		if props.Lon != nil && *props.Lon != 0 {
			lonVal = *props.Lon
		}
		radiusVal := props.RadiusMeters
		if radiusVal <= 0 {
			radiusVal = 10000
		}
		namePrefix := props.NamePrefix
		if namePrefix == "" {
			namePrefix = "geo"
		}
		mapHeight := props.Height
		if mapHeight == "" {
			mapHeight = "280px"
		}
		mapID := fmt.Sprintf("leaflet-map-%s-%d", namePrefix, int(latVal*1000)%100000)
		gmapsLinkURL := fmt.Sprintf("https://www.google.com/maps?q=%.8f,%.8f", latVal, lonVal)
	}}
	<div class="map-picker-container s-map-picker" data-map-picker>
		<input type="hidden" name={ fmt.Sprintf("%s_city_id", namePrefix) } data-map-city-id />
		<!-- Header Toolbar -->
		<div class="stack-sm s-map-picker-head">
   <div class="stack-sm">
				<div class="stack-sm s-map-picker-row">
					<span class="s-map-picker-title">
						if props.Label != "" {
							{ props.Label }
						} else {
							تحديد الموقع الجغرافي والإحداثيات (GPS)
						}
					</span>
					<span class="badge badge-sky s-map-picker-coords" data-map-badge>
						{ fmt.Sprintf("%.4f, %.4f", latVal, lonVal) }
					</span>
				</div>
				<div class="stack-sm s-map-picker-address">
					انقر على الخريطة أو اسحب المؤشر لتحديد موقع المنشأة بدقة
				</div>
			</div>

			<!-- Toolbar Buttons -->
			<div class="stack-sm s-map-picker-actions">
				<!-- Current Location GPS Button -->
				<button type="button" class="btn btn-secondary btn-sm s-map-picker-btn" data-locate-me-btn title="تحديد موقعي الحالي بدقة">
					<span>موقعي الحالي</span>
				</button>


				<!-- Google Maps Link Button -->
				<a
					href={ templ.SafeURL(gmapsLinkURL) }
					target="_blank"
					rel="noopener"
					class="btn btn-secondary btn-sm s-map-picker-link"
					data-google-maps-link
					title="فتح الموقع على خرائط Google"
				>
					<span>خرائط Google</span>
				</a>
			</div>
		</div>

		<!-- Interactive Map Canvas (Pure Leaflet Container - No Blocked Iframes) -->
		<div
			id={ mapID }
			class="map-canvas s-map-canvas"
			data-lat={ fmt.Sprintf("%.8f", latVal) }
			data-lon={ fmt.Sprintf("%.8f", lonVal) }
			data-radius={ fmt.Sprintf("%d", radiusVal) }
			data-height={ mapHeight }
		>
		</div>

		<!-- Coordinate Inputs Matrix -->
		<div class="stack-sm s-map-picker-fields">
   <div class="stack-sm">
				<label class="form-label text-xs s-map-picker-label">خط العرض (Latitude) *</label>
				<input
					type="number"
					step="0.00000001"
					name={ fmt.Sprintf("%s_lat", namePrefix) }
					value={ fmt.Sprintf("%.8f", latVal) }
					class="form-control tabular-nums s-map-picker-input"
					data-map-lat
					if props.ReadOnly {
						readonly
					}
				/>
			</div>
   <div class="stack-sm">
				<label class="form-label text-xs s-map-picker-label">خط الطول (Longitude) *</label>
				<input
					type="number"
					step="0.00000001"
					name={ fmt.Sprintf("%s_lon", namePrefix) }
					value={ fmt.Sprintf("%.8f", lonVal) }
					class="form-control tabular-nums s-map-picker-input"
					data-map-lon
					if props.ReadOnly {
						readonly
					}
				/>
			</div>
			if props.ShowRadius {
    <div class="stack-sm">
					<label class="form-label text-xs s-map-picker-label">نصف قطر التغطية (بالمتر)</label>
					<input
						type="number"
						step="500"
						min="500"
						max="500000"
						name={ fmt.Sprintf("%s_radius", namePrefix) }
						value={ fmt.Sprintf("%d", radiusVal) }
						class="form-control tabular-nums s-map-picker-input"
						data-map-radius
						if props.ReadOnly {
							readonly
						}
					/>
				</div>
			}
			<div class="stack-sm s-span-all">
				<label class="form-label text-xs s-map-picker-label">رابط الموقع على خرائط Google Maps</label>
				<input
					type="url"
					name={ fmt.Sprintf("%s_google_maps_url", namePrefix) }
					value={ gmapsLinkURL }
					class="form-control tabular-nums text-xs w-full"
					placeholder="https://maps.google.com/?q=..."
					data-map-google-url
				/>
			</div>
		</div>
	</div>
}

