# =============================================================================
# Dawa24 - Hostinger KVM VPS Production Environment Template
# =============================================================================
# Copy this file to /opt/dawa24/.env on your Hostinger VPS:
#   cp deploy/hostinger/.env.production.example .env
# Replace every GENERATE_RANDOM_* and yourdomain.com with your actual values.
# =============================================================================

# --- General ---
APP_ENV=prod
APP_NAME=Dawa24
APP_DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# VPS Memory Profile (4gb for Netcup / Hostinger KVM 2, 8gb for Hostinger KVM 4)
VPS_PROFILE=4gb

# --- PostgreSQL Configuration ---
POSTGRES_DB=dawa24_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_RANDOM_POSTGRES_PASSWORD
DB_APP_PASSWORD=GENERATE_RANDOM_APP_PASSWORD

# --- Redis Configuration ---
REDIS_PASSWORD=GENERATE_RANDOM_REDIS_PASSWORD
REDIS_MAX_MEMORY=512mb

# --- Application Security & Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=GENERATE_RANDOM_32_BYTE_HEX_SECRET
SESSION_COOKIE_NAME=dawa24_session
SESSION_TTL=720h
SESSION_SECURE=true

# --- First super_admin ---
# Used only when this account does not exist yet; an existing admin's password
# is never touched by a deploy. Reset one explicitly with:
#   docker compose exec server /app/cli create-admin <email> <password>
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=GENERATE_RANDOM_ADMIN_PASSWORD

# --- AI Gateway (api.muhiya.com) ---
GATEWAY_ENABLED=false
GATEWAY_BASE_URL=https://api.muhiya.com
GATEWAY_VIRTUAL_KEY=
GATEWAY_CLIENT_APP=dawa24-store
GATEWAY_TIMEOUT=60s

# --- ERP integration API (specs/002) ---
# Off by default. Generate the pepper with: openssl rand -hex 32
# Set it first, then ERP_API_ENABLED=true, then restart server AND worker.
# Never change the pepper once suppliers have keys (all keys would stop working).
ERP_API_ENABLED=false
ERP_KEY_PEPPER=
ERP_DEFAULT_RATE_PER_MINUTE=600
ERP_MAX_BATCH_ITEMS=50000

# --- Google Maps API (Optional) ---
GOOGLE_MAPS_API_KEY=

# --- Observability ---
LOG_LEVEL=info
LOG_FORMAT=json
TRACE_SAMPLING=0.05
