# Dawa24 Store — configuration reference.
# Copy to .env for local development. Never commit a filled-in copy.
# In staging and production these are set as Elest.io environment variables.

APP_ENV=dev                      # dev | staging | prod
APP_NAME=Dawa24
APP_BASE_URL=http://localhost:8080
PORT=8080

# --- PostgreSQL ---
# Local development default:
DATABASE_URL=postgres://dawa24:dawa24@localhost:5432/dawa24_store?sslmode=disable
# Production / Staging: Use non-superuser application role 'dawa24_app' created by migration 222
# to enforce engine-level Row-Level Security (RLS) without bypass privileges:
# DATABASE_URL=postgres://dawa24_app:<STRONG_PASSWORD>@db.internal:5432/dawa24_store?sslmode=require
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=30s
# The background worker needs its own ceiling: a bulk import statement runs for
# minutes, and the web value would cancel it however long the job timeout is.
DB_WORKER_STATEMENT_TIMEOUT=10m

# --- Redis: cache, sessions, rate limiting ---
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# --- Object storage (MinIO locally, MinIO/S3 on Elest.io) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=dawa24
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/dawa24

# --- Sessions ---
# Must be at least 32 bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=dawa24_session
SESSION_TTL=720h
SESSION_SECURE=false

# --- AI Gateway (MuhiyaLLM) ---
# The Store holds NO provider credentials and NO model names. It authenticates
# to the Gateway with a virtual key and asks for capabilities; the Gateway owns
# provider selection, routing, pricing and metering.
#
# Leave GATEWAY_ENABLED=false until a virtual key is issued. Every AI capability
# has a deterministic fallback, so the application is fully functional without it.
GATEWAY_ENABLED=false
GATEWAY_BASE_URL=https://api.dawa24.com
GATEWAY_VIRTUAL_KEY=REPLACE_ME_WITH_VIRTUAL_KEY_FROM_GATEWAY_ADMIN
GATEWAY_CLIENT_APP=dawa24-store
GATEWAY_TIMEOUT=60s

# --- SMTP Email Configuration (Password Reset, Email Verification, Notifications) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=tls                 # tls (port 465) | starttls (port 587) | none
SMTP_USERNAME=no-reply@dawa24.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@dawa24.com
SMTP_FROM_NAME="Dawa24 | دوا 24"
SMTP_ENABLED=true
SMTP_TIMEOUT=10s

# --- Telegram bridge & Telegram Gateway ---
# Both TELEGRAM_BOT_USERNAME and TELEGRAM_BRIDGE_TOKEN empty leaves the bot bridge off.
# The bridge token is the Bearer secret n8n sends; generate with: openssl rand -hex 32
TELEGRAM_BOT_USERNAME=
TELEGRAM_BRIDGE_TOKEN=
TELEGRAM_BOT_TOKEN=

# Telegram Gateway API (https://gateway.telegram.org) for sending real phone OTP codes.
# When empty, phone verification runs in sandbox/mock mode (accepts code 123456).
TELEGRAM_GATEWAY_TOKEN=

# --- WhatsApp bridge (Capsule + notifications via n8n) ---
# Number (international, no +) and token both or neither. See docs/modules/whatsapp.md.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_BRIDGE_TOKEN=
# Approved utility template with one body parameter, for notifications outside
# WhatsApp's 24-hour window. Empty drops those notifications.
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Social-media digest read by n8n; see docs/modules/marketing.md.
MARKETING_BRIDGE_TOKEN=

# --- Google Maps ---
# Embed API key for the location picker. Optional: without it the picker shows a
# coordinate-entry fallback (Google blocks framing maps.google.com any other
# way). Enable "Maps Embed API" in Google Cloud Console, then restrict the key
# by HTTP referrer — it is visible inside iframe URLs by design.
GOOGLE_MAPS_API_KEY=

# --- Observability ---
LOG_LEVEL=info
LOG_FORMAT=json                  # json | text
TRACE_SAMPLING=0.05
METRICS_PORT=9090

# --- Background workers (queue name -> worker count) ---
WORKER_IMPORTS=2
WORKER_AI=4
WORKER_NOTIFICATIONS=4
WORKER_PROJECTIONS=2
WORKER_MAINTENANCE=1
# River polls only the queues it is configured with. smartorder must be listed
# or SmartOrderRunArgs jobs are never claimed by the worker that handles them.
WORKER_SMARTORDER=2

# --- Anti-scraping (internal/platform/antiscrape) ---
# Guards GET /catalog and GET /suppliers — the two pages that publish supplier
# identity, net supply price, stock and coverage as a browsable list. Search
# engines and user-triggered AI assistants are let through; HTTP clients,
# scraping frameworks, SEO harvesters and model-training collectors are refused.
ANTISCRAPE_ENABLED=true
# How long a caller stays refused after filling the catalogue's hidden honeypot
# field. Only something reading the HTML can fill it.
ANTISCRAPE_PENALTY_TTL=1h
# Ceiling on how much of the catalogue one signed-out caller can page through.
# Signed-in users keep the full 200 x 96 range. Raising these widens what an
# anonymous scraper can collect even if it never trips a rate limit.
ANTISCRAPE_GUEST_MAX_PAGE=25
ANTISCRAPE_GUEST_MAX_PAGE_SIZE=48

# --- Reverse proxy ---
# How many proxies sit in front of this process. LOAD-BEARING: X-Forwarded-For
# is written by the caller and appended to by each proxy, so the real client is
# the entry this many places from the right. Set it too low (or to 0 with a
# proxy in front) and a scraper mints a fresh identity per request by sending
# the header; set it too high and every visitor shares one rate-limit bucket.
# 1 is correct behind Elest.io. Use 0 only if the container is exposed directly.
TRUSTED_PROXY_HOPS=1

# --- Cloudflare Turnstile (Bot protection for Login & Register) ---
# When TURNSTILE_SECRET_KEY is empty or TURNSTILE_ENABLED=false, Turnstile verification
# falls back to mock mode (always passes in dev/test).
# Cloudflare testing keys:
# Site Key (Always Passes): 1x00000000000000000000AA
# Secret Key (Always Passes): 1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Authentication & Registration Verification ---
# Set to true to require email/phone OTP verification at registration.
# If false (default), email and phone verification are optional at registration,
# and users can verify anytime from profile settings.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REQUIRE_PHONE_VERIFICATION=false

# ---------------------------------------------------------------------------
# Request deadlines
#
# HTTP_REQUEST_TIMEOUT must stay below HTTP_WRITE_TIMEOUT. It is the deadline on
# each request's context: the application cancels the query, releases the pool
# connection and renders an error. If the socket's WriteTimeout fires first the
# connection just closes and the reverse proxy reports 502 with no cause.
# ---------------------------------------------------------------------------
HTTP_REQUEST_TIMEOUT=25s
HTTP_WRITE_TIMEOUT=30s
DB_STATEMENT_TIMEOUT=20s

# --- Master Catalog Import Limits ---
# Maximum number of products allowed in a single catalog import.
# Set to 0 or leave empty for unlimited imports (no cap). Set to any positive number (e.g. 50000) to enforce a limit.
CATALOG_MAX_IMPORT_ROWS=0
# Maximum file upload size in megabytes for catalogue spreadsheets (default: 200MB).
MAX_IMPORT_UPLOAD_MB=200

