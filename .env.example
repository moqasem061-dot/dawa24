# =============================================================================
# Dawa24 — environment variables (template)
# =============================================================================
# Copy to .env for local development. NEVER commit a filled-in copy: .env is
# git-ignored and docker-ignored; keep it that way.
#
# In production set these in the hosting panel / secret store, not in files in
# the repository. Every secret below is EMPTY on purpose. Generate each one
# fresh with the command shown; never reuse a value across environments.
#
#   [REQ-PROD]  required in production (the process or compose refuses to start)
#   [SECRET]    credential — rotate on exposure (docs/security/SECURITY_DATABASE_AND_SECRETS.md)
#
# Full reference: docs/security/SECURITY_DATABASE_AND_SECRETS.md
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=dev                              # dev | staging | prod   [REQ-PROD: prod]
APP_NAME=Dawa24
APP_BASE_URL=http://localhost:8080       # [REQ-PROD] https:// public origin
PORT=8080

# --- Database: three separate credentials ------------------------------------
# DATABASE_URL is the connection THIS process uses:
#   server / worker -> the runtime role dawa24_app (never the owner/superuser)
#   cli migrate     -> the schema owner
# In production the server and worker refuse a superuser, BYPASSRLS or
# table-owning connection (DB_REQUIRE_RLS defaults to true in prod).
DATABASE_URL=postgres://dawa24_app:CHANGE_ME@localhost:5432/dawa24_store?sslmode=disable

# docker-compose.yml maps these two into DATABASE_URL per service:
APP_DATABASE_URL=                        # [REQ-PROD][SECRET] postgres://dawa24_app:<DB_APP_PASSWORD>@host:5432/db?sslmode=require
MIGRATE_DATABASE_URL=                    # [REQ-PROD][SECRET] postgres://<owner>:<owner password>@host:5432/db?sslmode=require

# Password migrate sets on dawa24_app (>= 24 chars). Must match APP_DATABASE_URL.
DB_APP_PASSWORD=                         # [REQ-PROD][SECRET] openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
DB_REQUIRE_RLS=true                      # prod default true; false is an emergency-only, logged opt-out

DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE=30m
DB_STATEMENT_TIMEOUT=30s
DB_WORKER_STATEMENT_TIMEOUT=10m

# Only for the self-hosted Postgres container (deploy/hostinger, docker-compose.dev.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                       # [SECRET] owner/superuser password — only migrate and the DB container see it
POSTGRES_DB=dawa24_store

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0       # [REQ-PROD][SECRET when it carries a password] redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_PASSWORD=                          # [REQ-PROD][SECRET] openssl rand -hex 32
REDIS_POOL_SIZE=10

# --- Sessions and signing ----------------------------------------------------
# SESSION_SECRET signs password-reset and verification tokens and is the root of
# the MFA pending-cookie key and the image-proxy URL key. Rotating it logs every
# user out and invalidates outstanding reset links.
SESSION_SECRET=                          # [REQ-PROD][SECRET] openssl rand -hex 32   (64 hex chars; >= 32 required)
SESSION_COOKIE_NAME=dawa24_session
SESSION_TTL=720h
SESSION_IDLE_TIMEOUT=30m
SESSION_SECURE=false                     # must be true in prod (enforced)

# --- First platform owner (cli migrate / cli create-admin) -------------------
# Used only to create the account when it does not exist; never reset on deploy.
# No default password exists anywhere. Remove ADMIN_PASSWORD after first use.
ADMIN_EMAIL=admin@dawa24.net
ADMIN_PASSWORD=                          # [SECRET] >= 14 chars, mixed classes

# Development/staging seeding only (refused when APP_ENV=prod)
SEED_PASSWORD=                           # [SECRET] >= 12 chars, for `cli seed-users`
LOADSEED_PASSWORD=                       # [SECRET] >= 12 chars, for cmd/loadseed

# --- HTTP, proxy and TLS -----------------------------------------------------
TRUSTED_PROXY_HOPS=1
# Comma-separated CIDRs/IPs of your reverse proxy (Traefik/Caddy Docker network).
# When set, X-Forwarded-For is ignored from any other peer, so per-IP rate
# limits cannot be spoofed by reaching the app port directly.
TRUSTED_PROXIES=                         # e.g. 172.16.0.0/12
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=25s
HTTP_SHUTDOWN_TIMEOUT=20s
TLS_ENABLED=false                        # true only if the app terminates TLS itself
TLS_CERT_FILE=
TLS_KEY_FILE=
CSP_REPORT_URL=
MODULE_API_ENABLED=false                 # legacy JSON module APIs; keep false in prod

# --- Object storage (S3 / MinIO) ---------------------------------------------
STORAGE_ENDPOINT=                        # empty = local disk under DATA_DIR/UPLOAD_DIR
STORAGE_REGION=us-east-1
STORAGE_BUCKET=dawa24
STORAGE_ACCESS_KEY_ID=                   # [SECRET] per-app key, bucket-scoped policy
STORAGE_SECRET_ACCESS_KEY=               # [SECRET]
STORAGE_USE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
DATA_DIR=./data
UPLOAD_DIR=                              # overrides DATA_DIR/uploads

# --- ERP integration API (specs/002) ----------------------------------------
# Off by default. Set the pepper first, restart, then set ERP_API_ENABLED=true and
# restart the server AND worker (settings are read only at startup).
ERP_API_ENABLED=false
ERP_KEY_PEPPER=                          # [SECRET] 32+ random bytes: openssl rand -hex 32. Never change once keys exist.
ERP_DEFAULT_RATE_PER_MINUTE=600
ERP_MAX_BATCH_ITEMS=50000
WORKER_ERPSYNC=3

# --- AI Gateway ---------------------------------------------------------------
GATEWAY_ENABLED=false
GATEWAY_BASE_URL=https://api.dawa24.com
GATEWAY_VIRTUAL_KEY=                     # [SECRET] issued by the Gateway (per environment)
GATEWAY_ADMIN_KEY=                       # [SECRET] Gateway admin credential (provisions per-tenant keys)
GATEWAY_CLIENT_APP=dawa24-store
GATEWAY_TIMEOUT=60s
GATEWAY_MODEL_MATCHING=                  # optional model override
GATEWAY_MODEL_ASSISTANT_TRANSCRIBE=      # optional model override

# --- Email (SMTP) ------------------------------------------------------------
SMTP_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=tls                      # tls (465) | starttls (587)
SMTP_USERNAME=no-reply@dawa24.com
SMTP_PASSWORD=                           # [SECRET] mailbox password — set in the mail provider panel
SMTP_FROM_EMAIL=no-reply@dawa24.com
SMTP_FROM_NAME="Dawa24 | دوا 24"
SMTP_TIMEOUT=10s

# --- Bot protection / analytics ----------------------------------------------
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=                      # public site key (Cloudflare dashboard)
TURNSTILE_SECRET_KEY=                    # [SECRET] Cloudflare Turnstile secret
CLARITY_PROJECT_ID=                      # public id

# --- Maps ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=                     # [SECRET] restrict by HTTP referrer + API in Google Cloud

# --- Telegram / WhatsApp / Marketing (n8n bridges) ---------------------------
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=                      # [SECRET] from @BotFather
TELEGRAM_BRIDGE_TOKEN=                   # [SECRET] n8n -> app shared secret: openssl rand -hex 32 (NOT the bot token)
TELEGRAM_GATEWAY_TOKEN=                  # [SECRET] Telegram Gateway (verification codes) API token
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_BRIDGE_TOKEN=                   # [SECRET] n8n -> app shared secret: openssl rand -hex 32
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar
MARKETING_BRIDGE_TOKEN=                  # [SECRET] n8n -> app shared secret: openssl rand -hex 32 (NOT a Meta token)

# --- Auth policy --------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REQUIRE_PHONE_VERIFICATION=false
DEV_SHOW_MOCK_OTP=false                  # never true outside local development

# --- Anti-scrape --------------------------------------------------------------
ANTISCRAPE_ENABLED=true
ANTISCRAPE_PENALTY_TTL=1h
ANTISCRAPE_GUEST_MAX_PAGE=25
ANTISCRAPE_GUEST_MAX_PAGE_SIZE=48

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
TRACE_SAMPLING=0.05
OTLP_ENDPOINT=
METRICS_PORT=9090

# --- Worker -------------------------------------------------------------------
WORKER_IMPORTS=2
WORKER_AI=2
WORKER_NOTIFICATIONS=4
WORKER_PROJECTIONS=2
WORKER_MAINTENANCE=1
WORKER_SMARTORDER=1
WORKER_SHUTDOWN_TIMEOUT=60s

# --- Import limits ------------------------------------------------------------
CATALOG_MAX_IMPORT_ROWS=0                # 0 = unlimited
MAX_IMPORT_UPLOAD_MB=200
SMARTORDER_MATCH_STATUSES=               # optional override
